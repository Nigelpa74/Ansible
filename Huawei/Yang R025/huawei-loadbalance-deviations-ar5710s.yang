module huawei-loadbalance-deviations-ar5710s {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-loadbalance-deviations-ar5710s";
  prefix loadbalance-devs-ar5710s;

  import huawei-loadbalance {
    prefix loadbalance;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-devm {
    prefix devm;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-loadbalance module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/loadbalance:loadbalance/loadbalance:global-attribute" {
    deviate not-supported;
  }
  deviation "/loadbalance:loadbalance/loadbalance:load-balance-ecmp-profile" {
    deviate not-supported;
  }
  deviation "/loadbalance:loadbalance/loadbalance:dynamic-load-balance-profile" {
