module huawei-ifit-common-deviations-ar5710s {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-ifit-common-deviations-ar5710s";
  prefix ifit-common-devs-ar5710s;

  import huawei-ifit-common {
    prefix ifit-common;
  }
  import huawei-extension {
    prefix ext;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-ifit {
    prefix ifit;
  }
  import huawei-network-instance {
    prefix ni;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-ifit-common module.";

  revision 2024-10-27 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef flow-type-deviations {
    type enumeration {
      enum unidirection {
        value 2;
        description
          "An unidirection IFIT flow.";
      }
    }
    description
      "Flow type.";
  }

  typedef flow-direction-deviations {
    type enumeration {
      enum ingress {
        value 1;
        description
          "Ingress of an IFIT flow.";
      }
      enum transit-input {
        value 2;
        description
          "Transit input of an IFIT flow.";
      }
      enum transit-output {
        value 3;
        description
          "Transit output of an IFIT flow.";
      }
      enum egress {
        value 4;
        description
          "Egress of an IFIT flow.";
      }
      enum conversion-input {
        value 9;
        description
          "Conversion input of an IFIT flow.";
      }
      enum conversion-output {
        value 10;
        description
          "Conversion output of an IFIT flow.";
      }
    }
    description
      "Flow direction.";
  }

  typedef flow-scenario-deviations {
    type enumeration {
      enum flow-ip {
        value 0;
        description
          "Scenario of IFIT IP flow.";
      }
    }
    description
      "Scenario of an IFIT flow.";
  }

