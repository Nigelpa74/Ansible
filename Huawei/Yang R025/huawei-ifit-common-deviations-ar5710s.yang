  deviation "/ifit-common:set-dynamic-flow/ifit-common:input/ifit-common:protocol" {
    deviate replace {
      type uint8 {
        range "0..254";
        ext:value-meaning {
          ext:item "6" {
            ext:meaning "tcp";
          }
          ext:item "17" {
            ext:meaning "udp";
          }
        }
      }
    }
  }
  deviation "/ifit-common:reset-dynamic-flow/ifit-common:input/ifit-common:protocol" {
    deviate replace {
      type uint8 {
        range "0..254";
        ext:value-meaning {
          ext:item "6" {
            ext:meaning "tcp";
          }
          ext:item "17" {
            ext:meaning "udp";
          }
        }
      }
    }
  }
  deviation "/ifit:ifit/ifit-common:ifit-common/ifit-common:static-instances/ifit-common:static-instance" {
    deviate delete {
      must "../../global/clock-mode='common' or (disorder-measure-enable='false' and gtpu-sn-measure-enable='false')";
    }
    deviate delete {
      must "delay-per-packet-enable = 'false' or (loss-measure-enable = 'true' and disorder-measure-enable = 'false' and gtpu-sn-measure-enable = 'false')";
    }
    deviate delete {
      must "gtpu-sn-measure-enable='false' or disorder-measure-enable = 'false'";
    }
  }
  deviation "/ifit:ifit/ifit-common:ifit-common/ifit-common:static-instances/ifit-common:static-instance/ifit-common:flow-scenario" {
    deviate replace {
      type ifit-common-devs-ar5710s:flow-scenario-deviations;
    }
  }
  deviation "/ifit:ifit/ifit-common:ifit-common/ifit-common:static-instances/ifit-common:static-instance/ifit-common:flow" {
    deviate delete {
      must "(../gtpu-sn-measure-enable='true' and ((source-ipv6 and destination-ipv6) or (source-ip or destination-ip))) or ../gtpu-sn-measure-enable='false'";
    }
    deviate delete {
      must "(destination-ip or destination-ipv6 or source-ip or source-ipv6) or ((address-type or peer-evpl-id) and flow-type='unidirection')";
    }
    deviate delete {
      must "../../../global/clock-mode!='precision-full' or ../interval=10";
    }
    deviate delete {
      must "../../../global/clock-mode='common' or (not(address-type) and not(peer-evpl-id) and not(peer-ip) and not(peer-locator-prefix))";
    }
    deviate delete {
      must "not (gtp-enable='true') or (not (protocol) or (protocol='17' and ((source-port=2152 and destination-port>=2152) or (destination-port=2152 and source-port>=2152))))";
    }
    deviate add {
      must '(source-ip or source-ipv6) and (destination-ip or destination-ipv6)';
    }
  }
  deviation "/ifit:ifit/ifit-common:ifit-common/ifit-common:static-instances/ifit-common:static-instance/ifit-common:flow/ifit-common:flow-type" {
    deviate delete {
      must "(../../single-device-measure-enable='true' and ../flow-type='unidirection') or (../../single-device-measure-enable='false')";
    }
    deviate delete {
      must "../../../../global/clock-mode='common' or ../flow-type='unidirection'";
    }
    deviate replace {
      type ifit-common-devs-ar5710s:flow-type-deviations;
    }
  }
  deviation "/ifit:ifit/ifit-common:ifit-common/ifit-common:static-instances/ifit-common:static-instance/ifit-common:flow/ifit-common:flow-filter/ifit-common:filter-condition1/ifit-common:flow-address-type/ifit-common:ipv4-condition/ifit-common:destination-ip" {
    deviate add {
      must '../destination-ip != ../source-ip';
    }
  }
  deviation "/ifit:ifit/ifit-common:ifit-common/ifit-common:static-instances/ifit-common:static-instance/ifit-common:flow/ifit-common:flow-filter/ifit-common:filter-condition1/ifit-common:flow-address-type/ifit-common:ipv6-condition/ifit-common:destination-ipv6" {
