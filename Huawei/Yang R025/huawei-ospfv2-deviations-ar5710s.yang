    deviate delete {
      must "../match-any='false' or ../route-policy-name or ../route-filter-name";
    }
    deviate add {
      must "../match-any='false' or ../route-policy-name";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/ospfv2:ospfv2/ospfv2:sites/ospfv2:site/ospfv2:frr/ospfv2:tiebreaker" {
    deviate delete {
      must 'ldp-sync!=lowest-cost';
    }
    deviate delete {
      must 'ldp-sync!=srlg-disjoint';
    }
    deviate delete {
      must 'lowest-cost!=srlg-disjoint';
    }
    deviate delete {
      must 'node-protect!=ldp-sync';
    }
    deviate delete {
      must 'node-protect!=srlg-disjoint';
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/ospfv2:ospfv2/ospfv2:sites/ospfv2:site/ospfv2:areas/ospfv2:area/ospfv2:interfaces/ospfv2:interface/ospfv2:bfd/ospfv2:min-tx" {
