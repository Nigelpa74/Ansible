    deviate replace {
      type uint32 {
        range "10..2000";
      }
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/ospfv2:ospfv2/ospfv2:sites/ospfv2:site/ospfv2:bfd/ospfv2:min-tx" {
