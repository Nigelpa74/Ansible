module huawei-bfd-deviations-ar5710s {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-bfd-deviations-ar5710s";
  prefix bfd-devs-ar5710s;

  import huawei-bfd {
    prefix bfd;
  }
  import huawei-ifm {
    prefix ifm;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-bfd module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef link-type-deviations {
    type enumeration {
      enum ip {
        value 0;
        description
          "IP.";
      }
      enum sid-list {
        value 13;
        description
          "SID_LIST.";
      }
    }
    description
      "BFD smp linktype.";
  }

  typedef display-type-deviations {
    type enumeration {
      enum all {
        value 0;
        description
          "All BFD sessions.";
      }
      enum discriminator {
        value 4;
        description
          "Discriminator-specified BFD session.";
      }
    }
    description
      "BFD session type.";
  }

  typedef session-type-deviations {
    type enumeration {
      enum single-hop-ip {
        value 0;
        description
          "Single-hop session.";
      }
      enum multi-hop-ip {
        value 1;
        description
          "Multi-hop session.";
      }
      enum sid-list {
        value 14;
        description
          "SID_LIST session.";
      }
    }
    description
      "BFD session type.";
  }

  typedef authentication-link-type-deviations {
    type enumeration {
      enum ip-single-hop {
        value 0;
        description
          "BFD authentication information for single hop IP session.";
      }
      enum ip-multi-hop {
        value 1;
        description
          "BFD authentication information for multi-hop IP sessions.";
      }
    }
    description
      "BFD authlink type.";
  }

