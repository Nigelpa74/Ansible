module huawei-wlan-management {
  yang-version 1.1;
  namespace "urn:huawei:yang:huawei-wlan-management";
  prefix hw-wmng;
  import huawei-extension {
    prefix ext;
  }
  import huawei-pub-type {
    prefix pub-type;
  }
  import ietf-inet-types {
    prefix inet;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "WLAN management package."; 
  revision 2025-09-09 {
    description
      "Add ftp-server-infov4 sftp-server-infov4 ft-server-infov6 sftp-server-v6.";
    reference
      "Huawei private.";
  }
  revision 2025-09-06 {
    description
      "Modify ap-update-sftp-server ap-update-ftp-server ap-update-ftp-server-v6 ap-update-sftp-server-v6.";
    reference
      "Huawei private.";
  }
  revision 2025-08-21 {
    description
