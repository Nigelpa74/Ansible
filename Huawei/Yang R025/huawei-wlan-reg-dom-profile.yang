            "Configure country-code.";
        }
        leaf dca-channel-5g-bandwidth {
          type enumeration {
            enum "20mhz" {
              value 0;
              description
                "20Mhz.";
            }
            enum "40mhz" {
              value 1;
              description
                "40Mhz.";
            }
            enum "80mhz" {
              value 2;
              description
                "80Mhz.";
            }
            enum "auto" {
              value 3;
              description
                "Auto.";
            }
            enum "160mhz" {
              value 4;
              description
                "160Mhz.";
            }
          }
          default "auto";
          description
            "Set dca-channel-5g.";
        }
        leaf dca-channel-6g-bandwidth {
          type enumeration {
            enum "20mhz" {
              value 0;
              description
                "20Mhz.";
            }
            enum "40mhz" {
              value 1;
              description
                "40Mhz.";
            }
            enum "80mhz" {
              value 2;
              description
                "80Mhz.";
            }
            enum "160mhz" {
              value 3;
              description
                "160Mhz.";
            }
            enum "auto" {
              value 4;
              description
                "Auto.";
            }
            enum "320mhz" {
              value 5;
              description
                "320mhz.";
            }
          }
          default "auto";
          description
            "Set dca-channel-6g.";
        }
        leaf dbs-initial-bandwidth {
          type enumeration {
            enum "20mhz" {
              value 0;
              description
                "Configure the initial bandwidth of DBS to 20 MHz.";
            }
            enum "40mhz" {
              value 1;
              description
                "Configure the initial bandwidth of DBS to 40 MHz.";
            }
            enum "80mhz" {
              value 2;
              description
                "Configure the initial bandwidth of DBS to 80 MHz.";
            }
            enum "160mhz" {
              value 3;
              description
                "Configure the initial bandwidth of DBS to 160 MHz.";
            }
            enum "auto" {
              value 4;
              description
                "Set the initial bandwidth of DBS to automatic.";
            }
          }
          default "auto";
          description
            "Set the initial bandwidth of DBS.";
        }
        leaf dbs-sensitivity {
          type enumeration {
            enum "balance" {
              value 0;
              description
                "Set the DBS sensitivity to balanced.";
            }
            enum "high-bandwidth" {
              value 1;
              description
                "Configure DBS sensitivity to high bandwidth.";
            }
            enum "low-latency" {
              value 2;
              description
                "Configure DBS sensitivity for low latency.";
            }
          }
          default "balance";
          description
            "Set the DBS sensitivity.";
        }
        leaf dca-channel-2g-set {
          type string {
            length "1..256";
            pattern '(\d+,)*\d+';
          }
          ext:dynamic-default;
          description
            "Config dca 2g channel-set. Customers can select multiple channels and each channel is separated by ',' such as 1,2,3. The default set is 1,6,11.";
        }
        leaf dca-channel-5g-set {
          type string {
            length "1..256";
            pattern '(\d+,)*\d+';
          }
          ext:dynamic-default;
          description
            "Config dca 5g channel-set. Customers can select multiple channels and each channel is separated by ',' such as 1,2,3. The default set include all channels.";
        }
        leaf dca-channel-6g-set {
          type string {
            length "1..256";
            pattern '(\d+,)*\d+';
          }
          ext:dynamic-default;
          description
            "Config dca 6g channel-set. Customers can select multiple channels and each channel is separated by ',' such as 1,2,3. The default set include all channels.";
        }
        leaf channel-load-mode {
          type enumeration {
            enum "outdoor" {
              value 0;
              description
                "Set the AP channel mode to outdoor mode.";
            }
            enum "indoor" {
              value 1;
              description
                "Restores the AP channel mode to indoor mode.";
            }
          }
          default "outdoor";
          description
            "Set the AP channel mode to indoor mode or outdoor mode.
             In scenarios where indoor and outdoor boundaries are unclear, such as subway and train platforms, it is recommended that outdoor APs be deployed.
             When a large volume of data is transmitted, outdoor APs in outdoor channel mode have no sufficient channels to meet data transmission requirements.
            In this case, you can run the channel-load-mode indoor command to set the channel mode of the APs to indoor mode, so that data can be transmitted on more channels.";
        }
      }
    }
  }
  augment /wlan-ap:wlan-ap/wlan-ap:ap-instances/wlan-ap:ap-instance {
    uses wlan-rdp:ap-binding-regular-domain-instance;
    description
      "Configure regular-domain profile to ap.";
  }
  augment "/wlan-apg:wlan-ap-group-profile/wlan-apg:ap-group-profiles/wlan-apg:ap-group-profile" {
    uses wlan-rdp:grp-binding-regular-domain-instance;
    description
      "Configure regular-domain profile to ap-group.";
  }
  ext:task-name "wm";
}
