module huawei-wlan-reg-dom-profile {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-wlan-reg-dom-profile";
  prefix wlan-rdp;
  import huawei-extension {
    prefix ext;
  }
  import huawei-wlan-ap {
    prefix wlan-ap;
  }
  import huawei-wlan-ap-group-profile {
    prefix wlan-apg;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "Wlan regulatory service package.";
  revision 2025-09-05 {
    description
      "Add PY country code.";
    reference
      "Huawei private.";
  }
  revision 2025-08-15 {
    description
      "Add dbs config.";
    reference
      "Huawei private.";
  }
  revision 2025-07-15 {
    description
      "Add dca-5g-bandwidth 160mHz.";
    reference
      "Huawei private.";
  }
  revision 2024-11-28 {
    description
      "Add BD and MV country code.";
    reference
      "Huawei private.";
  }
  revision 2024-10-30 {
    description
      "Add CI country code.";
    reference
      "Huawei private.";
  }
  revision 2024-09-04 {
    description
      "Add DCA channel dynamic default.";
    reference
      "Huawei private.";
  }
  revision 2024-05-17 {
    description
      "The default profile cannot be deleted.";
    reference
      "Huawei private.";
  }
  revision 2024-03-19 {
    description
      "Add profile name pattern.";
    reference
      "Huawei private.";
  }
  revision 2024-03-11 {
    description
      "Add dca-channel set pattern.";
    reference
      "Huawei private.";
  }
  revision 2024-03-08 {
    description
      "Add profile name pattern.";
    reference
      "Huawei private.";
  }
  revision 2023-11-20 {
    description
      "Fix domain word spelling mistake.";
    reference
      "Huawei private.";
  }
  revision 2023-01-10 {
    description
      "Add KE country code.";
    reference
      "Huawei private.";
  }
  revision 2022-12-29 {
    description
      "Add dca 320mhz.";
    reference
      "Huawei private.";
  }
  revision 2022-11-21 {
    description
      "Modify channel-load-mode description.";
    reference
      "Huawei private.";
  }
  revision 2022-08-06 {
    description
      "Initial revision.";
    reference
      "Huawei private.";
  }
  grouping ap-binding-regular-domain-instance {
    description
      "Configure regular domain profile to ap.";
    container ap-binding-regular-domain-profile {
      leaf binding-regular-domain-profile {
        type leafref {
          path "/wlan-rdp:wlan-reg-dom-profile/wlan-rdp:regulatory-domain-profiles/wlan-rdp:regulatory-domain-profile/wlan-rdp:profile-name";
        }
        description
          "Binding a regular domain profile to a AP.";
      }
      description
        "Configure regular domain profile to ap.";
    }
  }
  grouping grp-binding-regular-domain-instance {
    description
      "Configure regular domain profile to ap-group.";
    container grp-binding-regular-domain-profile {
      leaf binding-regular-domain-profile {
        type leafref {
          path "/wlan-rdp:wlan-reg-dom-profile/wlan-rdp:regulatory-domain-profiles/wlan-rdp:regulatory-domain-profile/wlan-rdp:profile-name";
        }
        default "default";
        description
          "Binding a regular domain profile.";
      }
      description
        "Configure a regular domain profile.";
    }
  }
  container wlan-reg-dom-profile {
    description
      "Configure wlan-regulatory-domain-profile.";
    container regulatory-domain-profiles {
      description
        "List of wlan-regulatory-domain-profile.";
      list regulatory-domain-profile {
        ext:generated-by "system" {
          description
            "The default profile is generated by system.";
          ext:filter "profile-name='default'";
        }
        ext:operation-exclude "delete" {
          ext:filter "profile-name='default'";
          description
            "The default profile cannot be deleted.";
        }
        key "profile-name";
        description
          "Configure a regulatory domain profile contains various settings such as the country code, which take effect on APs using the regulatory domain profile.";
        leaf profile-name {
          type string {
            length "1..35";
            pattern '[^\s?]+';
            pattern '[!-~]+';
          }
          description
            "Regulate domain profile name.";
        }
        leaf country-code {
          type enumeration {
            enum "AE" {
              value 0;
              description
                "UNITED ARAB EMIRATES.";
            }
            enum "AM" {
              value 1;
              description
                "ARMENIA.";
            }
            enum "AR" {
              value 2;
              description
                "ARGENTINA.";
            }
            enum "AT" {
              value 3;
              description
                "AUSTRIA.";
            }
            enum "AU" {
              value 4;
              description
                "AUSTRALIA.";
            }
            enum "AZ" {
              value 5;
              description
                "AZERBAIJAN.";
            }
            enum "BE" {
              value 6;
              description
                "BELGIUM.";
            }
            enum "BG" {
              value 7;
              description
                "BULGARIA.";
            }
            enum "BH" {
              value 8;
              description
                "BAHRAIN.";
            }
            enum "BN" {
              value 9;
              description
                "BRUNEI DARUSSALAM.";
            }
            enum "BO" {
              value 10;
              description
                "BOLIVIA.";
            }
            enum "BR" {
              value 11;
              description
                "BRAZIL.";
            }
            enum "BY" {
              value 12;
              description
                "BELARUS.";
