                "INDIA.";
            }
            enum "IQ" {
              value 43;
              description
                "IRAQ.";
            }
            enum "IR" {
              value 44;
              description
                "IRAN.";
            }
            enum "IS" {
              value 45;
              description
                "ICELAND.";
            }
            enum "IT" {
              value 46;
