            enum "BZ" {
              value 13;
              description
                "BELIZE.";
            }
            enum "CA" {
              value 14;
              description
                "CANADA.";
            }
            enum "CH" {
              value 15;
              description
                "SWITZERLAND.";
            }
            enum "CL" {
              value 16;
              description
                "CHILE.";
            }
            enum "CN" {
              value 17;
              description
                "CHINA.";
            }
            enum "CO" {
              value 18;
              description
                "COLOMBIA.";
            }
            enum "CR" {
              value 19;
              description
                "COSTA RICA.";
            }
            enum "CY" {
              value 20;
              description
                "CYPRUS.";
            }
            enum "CZ" {
              value 21;
              description
                "CZECH REPUBLIC.";
            }
            enum "DE" {
              value 22;
