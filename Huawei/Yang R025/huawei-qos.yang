            type uint32;
            description
              "Buffer usage when the microburst buffer usage reaches the peak value.";
          }
          leaf burst-peak-buffer-percent {
            type uint8;
            units "%";
            description
              "The percentage of buffer usage when the microburst buffer usage reaches the peak value.";
          }
          leaf slot-id {
            type uint32;
            description
              "Slot-id.";
          }
          leaf burst-number {
            type uint32;
            description
              "The number of microbursts.";
          }
        }
