              "TM ID.";
          }
          leaf sq-id {
            type uint32;
            description
              "SQ ID.";
          }
          leaf gq-id {
            type uint32;
            description
              "GQ ID.";
          }
          leaf vi-id {
            type uint32;
            description
              "VI ID.";
          }
          leaf dp-id {
            type uint32;
            description
              "DP ID.";
          }
        }
      }
      container tm-chip-buffer-usage-statisticss {
        description
          "List of tm chip buffer usage.";
        list tm-chip-buffer-usage-statistics {
          key "slot-id";
          description
            "Operational state of slot buffer usage.";
          leaf slot-id {
            type slot-id;
            description
              "Slot ID.";
          }
          leaf total-buffer {
            type uint64;
            units "kB";
            description
              "Total buffer size.";
          }
          leaf used-buffer {
            type uint64;
            units "kB";
            description
              "Current used buffer size.";
          }
          leaf used-percentage {
            type uint32 {
              range "0..100";
            }
            units "%";
            description
              "Current used buffer percentage.";
          }
        }
      }
      container intf-ing-buf-usage-statisticss {
        config false;
        description
          "List of interface buffer ingress-usage statistics.";
        list intf-ing-buf-usage-statistics {
          key "interface-name queue-id";
          description
              "Statistics of interface ingress buffer-usage.";
          leaf interface-name {
              type leafref {
                path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
              }
              description
                  "Interface name.";
          }
          leaf queue-id {
              type uint32;
              description
                  "Queue index.";
          }
          leaf pfc-dynamic {
              type boolean;
              description
                  "Is pfc dynamic.";
          }
          leaf current-guaranteed {
              type uint32;
              units "Byte";
              description
                  "Current guaranteed buffer.";
          }
          leaf total-guaranteed {
              type uint32;
              units "Byte";
              description
                  "Total guaranteed buffer.";
          }
          leaf current-buffer {
              type uint32;
              units "Byte";
              description
                  "Current buffer.";
          }
          leaf total-buffer {
              type uint32;
              units "Byte";
              description
                  "Total buffer.";
          }
          leaf current-headroom {
              type uint32;
              units "Byte";
              description
                  "Current headroom buffer.";
          }
          leaf total-headroom {
              type uint32;
              units "Byte";
              description
                  "Total headroom buffer.";
          }
        }
      }
    }
  }
