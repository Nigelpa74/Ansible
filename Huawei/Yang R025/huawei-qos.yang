            type yang:date-and-time;
            description
              "Time when microbursts start.";
          }
          leaf burst-start-buffer {
            type uint32;
            description
              "Buffer usage when microbursts start.";
          }
          leaf burst-start-buffer-percent {
            type uint8;
            units "%";
            description
