module huawei-wlan-system-profile {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-wlan-system-profile";
  prefix wlan-sys-prof;
  import huawei-extension {
    prefix ext;
  }
  import huawei-wlan-ap {
