            enum "54mbps" {
              value 54;
              description
                "54Mbps.";
            }
          }
          description
            "Dot11bg support rate list.";
        }
        description
          "Configure list of dot11bg support rate.";
      }
    }
    leaf single-txchain-switch {
      type boolean;
      default "false";
      description
        "Enable/disable the function of single txchain.";
    }
    leaf inter-ac-roam-switch {
      type boolean;
      default "true";
      description
        "Enable/disable the function of inter ac roam.";
    }
    leaf radio-type {
      type enumeration {
        enum "dot11a" {
          value 0;
          description
            "The 802.11a radio type.";
        }
        enum "dot11b" {
          value 1;
          description
            "The 802.11b radio type.";
        }
        enum "dot11g" {
          value 2;
          description
            "The 802.11g radio type.";
        }
        enum "dot11n" {
          value 3;
          description
            "The 802.11n radio type.";
        }
        enum "dot11ac" {
          value 4;
          description
            "The 802.11ac radio type.";
        }
        enum "dot11ax" {
          value 5;
          description
            "The 802.11ax radio type.";
        }
        enum "dot11be" {
          value 6;
          description
            "The 802.11be radio type.";
        }
      }
      default "dot11be";
      description
        "The radio type configured in an SSID profile takes precedence over that configured in a radio profile. 
         But if the radio type configured in an SSID profile exceeds the range supported by the current radio profile, the radio type configured in the radio profile takes effect.";
    }
    leaf dot11k-switch {
      type boolean;
      default "true";
      description
        "Enable/disable the function of 802.11k.";
    }
    leaf dot11v-bss-transition-switch {
      type boolean;
      default "true";
      description
        "Enable/disable the bss transition function of 802.11v.";
    }
    leaf ftm-switch {
      type boolean;
      default "false";
      description
        "Enable/disable the FTM function.";
    }
    leaf ftm-lci-switch {
      type boolean;
      default "false";
      description
        "Enable/disable the FTM LCI function.";
    }
    leaf legacy-station-switch {
      type enumeration {
        enum "enable" {
          value 0;
          description "Legacy stations are allowed to access.";
        }
        enum "disable" {
          value 1;
          description "Legacy stations are not allowed to access.";
        }
        enum "only-dot11b-disable" {
          value 2;
          description "Only 802.11b legacy stations are not allowed to access.";
        }
      }
      default "enable";
      description "Configuring whether to forbid access from 802.11a, 802.11b, and 802.11g legacy stations.";
    }
    leaf-list ht-mcs-map {
        type uint8 {
            range "0..31";
        }
        max-elements 32;
        description
          "Configure ht-mcs-map.";
    }
    leaf er-su-switch {
      type boolean;
      default "true";
      description
        "Enable/disable the extended range single user function.";
    }
  }
  grouping binding-ssid-profile {
    description
      "Binding ssid profile.";
    container binding-ssid-profile {
      description
        "Configure binding ssid profile.";
      leaf binding-ssid-profile {
        type leafref {
          path "/ssid-prof:wlan-ssid-profile/ssid-prof:ssid-profiles/ssid-prof:ssid-profile/ssid-prof:profile-name";
        }
        default "default";
        description
          "Binding a ssid profile.";
      }
    }
  }
  container wlan-ssid-profile {
    description
      "Configure ssid profile.";
    container ssid-profiles {
      description
        "List of ssid profiles.";
      list ssid-profile {
        ext:generated-by system {
          ext:filter "profile-name='default'";
          description
            "The default profile is generated by system.";
        }
        ext:operation-exclude "delete" {
          ext:filter "profile-name='default'";
          description
            "The default profile cannot be deleted.";
        }
        must "not(./beamforming-switch = 'false' and ./mimo-switch = 'true')";
        must "not(./beamforming-switch = 'false' and ./phy-protection != 'disable')";
        must "not(./ftm-switch = 'false' and ./ftm-lci-switch = 'true')";
        key "profile-name";
        description
          "Configure a ssid profile.";
        leaf profile-name {
          type string {
            length "1..35";
            pattern '[^\s?]+';
            pattern '[!-~]+';
          }
          description
            "SSID profile name.";
        }
        uses ssid-prof:ssid-containers;
      }
    }
  }
  augment "/vap-prof:wlan-vap-profile/vap-prof:vap-profiles/vap-prof:vap-profile" {
    description
      "Configure binding ssid profile to vap profile.";
    uses ssid-prof:binding-ssid-profile;
  }
  ext:task-name "lcm";
}
