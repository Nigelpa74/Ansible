  deviation "/radius:radius/radius:global-service/radius:dead-count" {
    deviate replace {
      default "2";
    }
  }
  deviation "/radius:radius/radius:global-service/radius:dead-interval" {
    deviate replace {
      type uint32 {
        range "1..300";
      }
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group" {
    deviate delete {
      must '(acct-retransmission-count and acct-retransmission-interval) or (not(acct-retransmission-count) and not(acct-retransmission-interval))';
    }
    deviate delete {
      must '(auth-retransmission-count and auth-retransmission-interval) or (not(auth-retransmission-count) and not(auth-retransmission-interval))';
    }
    deviate replace {
      max-elements 16;
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:shared-key" {
    deviate replace {
      type pub-type:password-extend {
        length "1..268";
      }
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:domain-mode" {
    deviate replace {
      default "original";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:ap-info-format" {
    deviate add {
      default "exclude-ap-ip";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:dhcp-option-format" {
    deviate add {
      default "old";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:cut-key-words" {
    deviate replace {
      type string {
        length "3..64";
        pattern '&[^ ]+=';
      }
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:cut-end-mark" {
    deviate replace {
      type string {
        length "1";
        pattern '&';
      }
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:radius-server-ipv4s" {
    deviate delete {
      must 'count(../radius-server-ipv6s/radius-server-ipv6)+count(../radius-server-ipv4s/radius-server-ipv4)<=32';
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:radius-server-ipv4s/radius:radius-server-ipv4" {
    deviate replace {
      max-elements 4;
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:radius-server-ipv4s/radius:radius-server-ipv4/radius:source-ip/radius:ip/radius:source-ip-address" {
    deviate replace {
      type inet:ipv4-address-no-zone;
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:radius-server-ipv4s/radius:radius-server-ipv4/radius:weight" {
    deviate replace {
      default "80";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:packet-control/radius:stop-accout-resend-count" {
    deviate add {
      default "3";
    }
    deviate replace {
      type uint16 {
        range "0..300";
      }
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-called-station-id" {
    deviate delete {
      must "(include-type!='ap-mac' and not(user-defined)) or (include-type='ap-mac' and user-defined)";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-called-station-id/radius:include-type" {
    deviate add {
      default "ap-mac";
    }
    deviate replace {
      type enumeration {
        enum ap-mac {
          value 1;
          description
            "Indicates that the encapsulation content of the Called-station-id (30) attribute is the AP's MAC address.";
        }
        enum ac-mac {
          value 2;
          description
            "Indicates that the encapsulation content of the Called-station-id (30) attribute is the AC's MAC address.";
        }
        enum ac-ip {
          value 3;
          description
            "Indicates that the encapsulation content of the Called-station-id (30) attribute is the AC's IP address.";
        }
        enum ap-name {
          value 4;
          description
            "Indicates that the encapsulation content of the Called-station-id (30) attribute is the AP name.";
        }
        enum ap-group-name {
          value 5;
          description
            "Indicates that the encapsulation content of the Called-station-id (30) attribute is the name of the AP group to which the AP belongs.";
        }
        enum vlan-id {
          value 6;
          description
            "Indicates that the encapsulation content of the Called-station-id (30) attribute is the outer VLAN through which the user goes online.";
        }
      }
    }
    deviate replace {
      mandatory false;
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-called-station-id/radius:common-type/radius:include-ssid" {
    deviate add {
      default "true";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-called-station-id/radius:common-type/radius:delimiter" {
    deviate add {
      default ":";
    }
    deviate replace {
      type string {
        length "1";
        pattern "[\\\\/|@%':<>*+&#!^~-]";
      }
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-called-station-id/radius:mac-format/radius:mac-address-format" {
    deviate add {
      default "hyphen-split";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-called-station-id/radius:mac-format/radius:mode" {
    deviate add {
      default "mode2";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-called-station-id/radius:mac-format/radius:case-format" {
    deviate add {
      default "upper";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-calling-station-id/radius:mac-format/radius:mac-address-format" {
    deviate add {
      default "hyphen-split";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-calling-station-id/radius:mac-format/radius:mode" {
    deviate add {
      default "mode1";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:attribute-format-calling-station-id/radius:mac-format/radius:case-format" {
    deviate add {
      default "lowercase";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:standard-attributes" {
    deviate delete {
      must "not((count(../extend-attributes/extend-attribute[operation-type='disable'])>0) and (count(standard-attribute[operation-type='disable'])>0))";
    }
    deviate delete {
      must "not((count(../extend-attributes/extend-attribute[operation-type='translate'])>0) and (count(standard-attribute[operation-type='translate'])>0))";
    }
    deviate delete {
      must "not((count(../vendor-specifics/vendor-specific[operation-type='disable'])>0) and (count(standard-attribute[operation-type='disable'])>0))";
    }
  }
