  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:translate-extends/radius:translate-extend/radius:source-attribute-name" {
    deviate replace {
      type enumeration {
        enum user-name {
          value 1;
          description
            "User name. The attribute type is STRING.";
        }
