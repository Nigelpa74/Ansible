  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:check-attribute/radius:attribute-name" {
    deviate replace {
      type radius:radius-attribute-table;
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:format-attribute" {
    deviate add {
      must "(nas-port-id-format!='vendor' and not(vendor-id)) or (nas-port-id-format='vendor' and vendor-id)";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:format-attribute/radius:nas-port-format" {
    deviate add {
      default "new";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:format-attribute/radius:nas-identifier-format" {
    deviate add {
      default "hostname";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:format-attribute/radius:nas-port-id-format" {
    deviate add {
      default "new";
    }
    deviate replace {
      type enumeration {
        enum new {
          value 0;
          description
            "Uses the new format of the NAS port ID.";
        }
        enum old {
          value 1;
          description
            "Uses the old format of the NAS port ID.";
        }
        enum option82 {
          value 2;
          description
            "Uses the new client-option82 format of the NAS port ID.";
        }
        enum vendor {
          value 3;
          description
            "Uses the vendor format of the NAS port ID.";
        }
      }
    }
  }
