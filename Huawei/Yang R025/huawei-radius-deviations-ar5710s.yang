  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:translate-extend-vendors/radius:translate-extend-vendor/radius:packet-type" {
    deviate add {
      min-elements 1;
    }
  }
  deviation "/radius:radius/radius:radius-local-ips/radius:radius-local-ip" {
    deviate replace {
      max-elements 10;
    }
  }
  deviation "/radius:radius/radius:dynamic-authorization-servers/radius:dynamic-authorization-server" {
    deviate add {
      must '(shared-key and not(dtls-policy-name)) or (not(shared-key) and dtls-policy-name)';
    }
  }
  deviation "/radius:radius/radius:dynamic-authorization-servers/radius:dynamic-authorization-server/radius:ip-address" {
    deviate replace {
      type inet:ipv4-address;
    }
  }
  deviation "/radius:radius/radius:dynamic-authorization-servers/radius:dynamic-authorization-server/radius:shared-key" {
    deviate replace {
      type pub-type:password-extend {
        length "1..268";
      }
    }
  }
  deviation "/radius:radius/radius:dynamic-authorization-server-vpns/radius:dynamic-authorization-server-vpn" {
    deviate add {
      must '(shared-key and not(dtls-policy-name)) or (not(shared-key) and dtls-policy-name)';
    }
  }
  deviation "/radius:radius/radius:dynamic-authorization-server-vpns/radius:dynamic-authorization-server-vpn/radius:ip-address" {
    deviate replace {
      type inet:ipv4-address;
    }
  }
  deviation "/radius:radius/radius:dynamic-authorization-server-vpns/radius:dynamic-authorization-server-vpn/radius:shared-key" {
    deviate replace {
      type pub-type:password-extend {
        length "1..268";
      }
    }
  }
  deviation "/radius:radius/radius:session-manage-function/radius:client" {
    deviate delete {
      default "any";
    }
  }
  deviation "/radius:radius/radius:session-manage-function/radius:client/radius:ip/radius:client-items/radius:client-item/radius:ip-address" {
    deviate replace {
      type inet:ipv4-address;
    }
