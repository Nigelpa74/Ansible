  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:standard-attributes/radius:standard-attribute/radius:operation-type" {
    deviate delete {
      must "(../operation-type='translate' and ../translate-attribute and not(../disable-attribute)) or (../operation-type='disable' and (../disable-attribute/disable-packet or ../disable-attribute/disable-direction or ../disable-attribute/disable-value) and not(../translate-attribute))";
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:standard-attributes/radius:standard-attribute/radius:disable-attribute/radius:disable-direction/radius:type" {
    deviate delete {
      must 'not(../../disable-packet/type) and not(../../disable-value/attribute-value)';
    }
    deviate add {
      min-elements 1;
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:radius-server-algorithm/radius:radius-arithmetic" {
    deviate replace {
      type enumeration {
        enum master-backup {
          value 1;
          description
            "Indicates the active/standby algorithm. Only the RADIUS authentication server or accounting server configured first is the active server.";
        }
        enum loading-share {
          value 2;
          description
            "Indicates the load-sharing algorithm. The weight of the RADIUS authentication server or accounting server takes effect only after loading-share is used.";
        }
      }
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:server-detect-function" {
    deviate add {
      must '(./user-name and ./user-password) or not(./user-name or ./user-password)';
    }
  }
  deviation "/radius:radius/radius:radius-server-groups/radius:radius-server-group/radius:modify-attributes/radius:modify-attribute" {
    deviate add {
      must "( attribute-name != 'service-type' and service-type-option = 'normal' ) or attribute-name = 'service-type'";
    }
  }
