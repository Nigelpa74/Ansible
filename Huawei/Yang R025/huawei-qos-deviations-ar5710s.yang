    deviate add {
      must '((./cbs-unit and ./cbs-value) or (not(./cbs-unit) and not(./cbs-value)) and ((./pbs-unit and ./pbs-value) or (not(./pbs-unit) and not(./pbs-value))) and ((./pir-unit and ./pir-value) or (not(./pir-unit) and not(./pir-value))))';
    }
  }
  deviation "/qos:qos/qos:car-template/qos:templates/qos:template/qos:cir-parameters/qos:cir/qos:pir-value" {
    deviate add {
      must '(../cir-unit != ../pir-unit) or (. >= ../cir-value)';
    }
  }
