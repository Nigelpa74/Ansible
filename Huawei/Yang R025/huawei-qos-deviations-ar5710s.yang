  deviation "/qos:qos/qos:car-template/qos:templates/qos:template/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '[^"\s?]*';
      }
    }
    deviate add {
      must "../name != 'i' and ../name != 'if' and ../name != 'ifg'";
    }
  }
  deviation "/qos:qos/qos:queue-scheduler-template/qos:profiles/qos:profile/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '[!#->@-~]*';
      }
    }
  }
  deviation "/qos:qos/qos:queue-scheduler-template/qos:profiles/qos:profile/qos:traffic-behavior-user-queues/qos:traffic-behavior-user-queue/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '[0-9a-zA-Z].*';
      }
    }
  }
  deviation "/qos:qos/qos:queue-scheduler-template/qos:flow-queues/qos:flow-queue/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '[!#->@-~]*';
      }
    }
  }
  deviation "/qos:qos/qos:queue-scheduler-template/qos:flow-queues/qos:flow-queue/qos:traffic-behavior-queues/qos:traffic-behavior-queue/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '[0-9a-zA-Z].*';
      }
    }
  }
  deviation "/qos:qos/qos:wred-template/qos:wreds/qos:wred/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '[!#->@-~]*';
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:diffserv-domains/qos:diffserv-domain/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '[^"\s?]*';
      }
    }
    deviate add {
      must "../name != 'n' and ../name != 'no' and ../name != 'non' and ../name != 'none'";
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:diffserv-domains/qos:diffserv-domain/qos:per-hop-behaviors/qos:per-hop-behavior/qos:type" {
    deviate replace {
      type qos-devs-ar5710s:qos-phb-type-all-deviations;
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:diffserv-domains/qos:diffserv-domain/qos:behavior-aggregations/qos:behavior-aggregation/qos:color" {
    deviate replace {
      type qos-devs-ar5710s:qos-color-deviations;
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:diffserv-domains/qos:diffserv-domain/qos:per-hop-behaviors/qos:per-hop-behavior/qos:color" {
    deviate replace {
      type qos-devs-ar5710s:qos-color-deviations;
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-classifiers/qos:traffic-classifier/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '^[a-zA-Z0-9][!-~]{0,30}$';
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-classifiers/qos:traffic-classifier/qos:rule-prioritys/qos:rule-priority/qos:type" {
    deviate replace {
      type qos-devs-ar5710s:priority-type-deviations;
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-classifiers/qos:traffic-classifier/qos:rule-prioritys/qos:rule-priority/qos:value" {
    deviate delete {
      must "(((../type='dscp' or ../type='ipv6-dscp') and ../value<=63) or ../value<=7)";
    }
    deviate add {
      must " (((../type='ecn' or ../type='ipv6-ecn') and ../value<=3) or ((../type='dscp' or ../type='ipv6-dscp') and ../value<=63) or ../value<=7)";
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-classifiers/qos:traffic-classifier/qos:rule-eth-types/qos:rule-eth-type" {
    deviate replace {
      max-elements 1;
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-classifiers/qos:traffic-classifier/qos:rule-eth-types/qos:rule-eth-type/qos:value" {
    deviate replace {
      type string {
        length "3..6";
        pattern '0[xX]([0-9a-fA-F]*)';
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-classifiers/qos:traffic-classifier/qos:local-ids/qos:local-id" {
    deviate replace {
      max-elements 1;
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:qos-groups/qos:qos-group/qos:group-policy-applys/qos:group-policy-apply/qos:direction" {
    deviate replace {
      type qos-devs-ar5710s:qos-direction-type-deviations;
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:name" {
    deviate replace {
      type string {
        length "1..31";
        pattern '^[a-zA-Z0-9][!-~]{0,30}$';
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:filter-action/qos:filter" {
    deviate delete {
      default "permit";
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action" {
    deviate add {
      must "(./yellow-action='pass') or (./yellow-action='discard' and ./red-action='discard')";
    }
    deviate add {
      must "./green-action='pass'";
    }
    deviate add {
      must '(./green-service-class and ./green-color) or (not(./green-service-class) and not(./green-color))';
    }
    deviate add {
      must '(./yellow-service-class and ./yellow-color) or (not(./yellow-service-class) and not(./yellow-color))';
    }
    deviate add {
      must '(./red-service-class and ./red-color) or (not(./red-service-class) and not(./red-color))';
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:cbs-unit" {
    deviate add {
      must "(../cbs-unit='bytes' and ../cbs>=10000) or (not(../cbs-unit) and ../cbs>=10000) or (../cbs-unit='kbytes' and ../cbs>=10 and ../cbs<=31744) or (../cbs-unit='mbytes' and ../cbs>=1 and ../cbs<=31)";
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:pbs-unit" {
    deviate add {
      must "(../cir ) and (../pbs-unit='bytes' and ../pbs>=10000) or (not(../pbs-unit) and ../pbs>=10000) or (../pbs-unit='kbytes' and ../pbs>=10 and ../pbs<=31744) or (../pbs-unit='mbytes' and ../pbs>=1 and ../pbs<=31)";
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:pir-unit" {
    deviate add {
      must "(../pir-unit='kbps' and ../pir>=24) or (not(../pir-unit) and ../pir>=24) or (../pir-unit='mbps' and ../pir>=1 and ../pir<=400000) or (../pir-unit='gbps' and ../pir>=1 and ../pir<=400)";
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:cir-unit" {
    deviate add {
      must "(../cir-unit='kbps' and ../cir>=24) or (not(../cir-unit) and ../cir>=24) or (../cir-unit='mbps' and ../cir>=1 and ../cir<=400000) or (../cir-unit='gbps' and ../cir>=1 and ../cir<=400)";
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:cir-parameters/qos:cir-mode/qos:cir" {
    deviate replace {
      type uint32 {
        range "1..400000000";
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:cir-parameters/qos:cir-mode/qos:pir" {
    deviate replace {
      type uint32 {
        range "1..400000000";
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:cir-parameters/qos:cir-percent-mode/qos:cir-percentage" {
    deviate replace {
      type uint8 {
        range "1..100";
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:cir-parameters/qos:cir-percent-mode/qos:pir-percentage" {
    deviate replace {
      type uint8 {
        range "1..100";
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:cbs" {
    deviate replace {
      type uint32 {
        range "1..32505856";
      }
    }
    deviate add {
      must '../pbs';
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:pbs" {
    deviate replace {
      type uint32 {
        range "1..32505856";
      }
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:green-action-parameters/qos:green-service-class/qos:green-service-class" {
    deviate add {
      must '../green-action';
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:green-action-parameters/qos:green-service-class/qos:green-color" {
    deviate add {
      must '../green-action';
    }
    deviate replace {
      mandatory false;
    }
    deviate replace {
      type qos-devs-ar5710s:qos-color-deviations;
    }
  }
  deviation "/qos:qos/qos:classifier-template/qos:traffic-behaviors/qos:traffic-behavior/qos:car-actions/qos:car-action/qos:yellow-action" {
    deviate add {
      must "../green-action='pass'";
