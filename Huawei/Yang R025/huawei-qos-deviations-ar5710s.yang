module huawei-qos-deviations-ar5710s {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-qos-deviations-ar5710s";
  prefix qos-devs-ar5710s;

  import huawei-qos {
    prefix qos;
  }
  import huawei-extension {
    prefix ext;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-vlan {
    prefix vlan;
  }
  import huawei-network-instance {
    prefix ni;
  }
  import huawei-license {
    prefix lcs;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-qos module.";

  revision 2019-11-06 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef trust-direction-type-deviations {
    type enumeration {
      enum inbound {
        value 1;
        description
          "Inbound.";
      }
      enum outbound {
        value 2;
        description
          "Outbound.";
      }
    }
    description
      "Trust direction type.";
  }

  typedef qos-ba-type-deviations {
    type enumeration {
      enum 8021p {
        value 0;
        description
          "802.1p priority.";
      }
      enum ip-dscp {
        value 1;
        description
          "DSCP priority.";
      }
      enum mpls-exp {
        value 2;
        description
          "MPLS-EXP priority.";
      }
    }
    description
      "Behavior aggregations type.";
  }

  typedef port-phb-trust-deviations {
    type enumeration {
      enum false {
        value 0;
        description
          "False.";
      }
      enum true {
        value 1;
        description
          "True.";
      }
    }
    description
      "Port phb trust.";
  }

  typedef priority-type-deviations {
    type enumeration {
      enum 8021p {
        value 0;
        description
          "802.1p priority.";
      }
      enum ip-precedence {
        value 1;
        description
          "IP precedence.";
      }
      enum dscp {
        value 2;
        description
          "DSCP priority.";
      }
      enum mpls-exp {
        value 4;
        description
          "MPLS-EXP priority.";
      }
      enum ipv6-dscp {
        value 5;
        description
          "dscp ipv6 priority.";
      }
    }
    description
      "MQC Priority type.";
  }

  typedef qos-direction-type-deviations {
    type enumeration {
      enum inbound {
        value 1;
        description
          "Inbound.";
      }
      enum outbound {
        value 2;
        description
          "Outbound.";
      }
    }
    description
      "MQC Direction type.";
  }

  typedef qos-phb-type-deviations {
    type enumeration {
      enum 8021p {
        value 0;
        description
          "Port phb trust 8021p.";
      }
      enum ip-dscp {
        value 1;
        description
          "Port phb trust dscp.";
      }
      enum mpls-exp {
        value 2;
        description
          "Port phb trust mpls-exp.";
      }
    }
    description
      "Port phb trust type.";
  }

  typedef qos-phb-type-all-deviations {
    type enumeration {
      enum 8021p {
        value 0;
        description
          "Port phb trust 8021p.";
      }
      enum ip-dscp {
        value 1;
        description
          "Port phb trust dscp.";
      }
      enum mpls-exp {
        value 2;
        description
          "MPLS-EXP priority.";
      }
    }
    description
      "Port phb trust type.";
  }

  typedef type-8021p-deviations {
    type enumeration {
      enum mpls-exp {
        value 4;
        description
          "Trust mpls.";
      }
      enum ip-dscp {
        value 3;
        description
          "Trust 8021p.";
      }
      enum inner-8021p {
        value 1;
        description
          "Trust inner 8021p.";
      }
      enum outer-8021p {
        value 2;
        description
          "Trust outer 8021p.";
      }
      enum none {
        value 0;
        description
          "Trust default value.";
      }
    }
    description
      "Trust 8021p type.";
  }

  typedef remark-action-type-deviations {
    type enumeration {
      enum 8021p {
        value 1;
        description
          "802.1p priority.";
      }
      enum dscp {
        value 5;
        description
          "DSCP priority.";
      }
      enum qos-local-precedence {
        value 6;
        description
          "Local precedence priority.";
      }
      enum mpls-exp {
        value 7;
        description
          "MPLS-EXP priority.";
      }
    }
    description
      "Behavior aggregations type.";
  }

  typedef qos-color-blind-deviations {
    type enumeration {
      enum blind {
        value 5;
        description
          "Blind.";
      }
    }
    description
      "Color type.";
  }

  typedef qos-color-deviations {
    type enumeration {
      enum green {
        value 0;
        description
          "Green.";
      }
      enum yellow {
        value 1;
        description
          "Yellow.";
      }
      enum red {
        value 2;
        description
          "Red.";
      }
    }
    description
      "Color type.";
  }

  typedef schedule-type-deviations {
    type enumeration {
      enum pq {
        value 0;
        description
          "Priority queue.";
      }
      enum drr {
        value 1;
        description
          "Dificit round robin.";
      }
    }
    description
      "Scheduling mode of the interface queue.";
  }

