  typedef dh-group-type-deviations {
    type enumeration {
      enum group1 {
        value 1;
        description
          "The 768-bit MODP group.";
      }
      enum group2 {
        value 2;
        description
          "The 1024-bit MODP group.";
      }
      enum group5 {
        value 5;
        description
          "The 1536-bit MODP group.";
      }
      enum group14 {
        value 14;
        description
          "The 2048-bit MODP group.";
      }
      enum group15 {
        value 15;
        description
          "The 3072-bit MODP group.";
      }
      enum group16 {
        value 16;
        description
          "The 4096-bit MODP group.";
      }
      enum group18 {
        value 18;
        description
          "The 8192-bit MODP group.";
      }
      enum group19 {
        value 19;
        description
          "The 256-bit random ECP group.";
      }
      enum group20 {
        value 20;
        description
          "The 384-bit random ECP group.";
      }
      enum group21 {
        value 21;
        description
          "The 521-bit random ECP group.";
      }
      enum group24 {
        value 24;
        description
          "The 2048-bit MODP Group with 256-bit Prime Order Subgroup.";
      }
    }
    description
      "The type of DH group definition.";
  }

  typedef local-id-type-deviations {
