    }
    deviate add {
      default "AES-256-GCM";
    }
  }
  deviation "/ipsec:ipsec/ipsec:ike-proposals/ipsec:ike-proposal/ipsec:auth-algorithm" {
    deviate replace {
      type ipsec-devs-ar5710s:ah-auth-algorithm-type-deviations;
