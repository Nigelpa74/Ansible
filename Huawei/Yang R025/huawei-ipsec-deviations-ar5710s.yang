    }
    deviate add {
      default "pre-shared-key";
    }
  }
  deviation "/ipsec:ipsec/ipsec:ike-proposals/ipsec:ike-proposal/ipsec:dh" {
    deviate replace {
      type ipsec-devs-ar5710s:dh-group-type-deviations;
    }
    deviate add {
      max-elements 1;
    }
    deviate add {
      default "group14";
    }
