module huawei-ipsec-deviations-ar5710s {
  yang-version 1.1;
  namespace "urn:huawei:yang:huawei-ipsec-deviations-ar5710s";
  prefix ipsec-devs-ar5710s;

  import huawei-ipsec {
    prefix ipsec;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-extension {
    prefix ext;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-ipsec module.";

  revision 2024-11-22 {
    description
      "Remove unused yang file references.";
    reference "";
  }
  revision 2019-11-06 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef ah-auth-algorithm-type-deviations {
    type enumeration {
      enum MD5 {
        value 1;
        description
          "MD5.";
      }
      enum SHA1 {
        value 2;
        description
          "SHA1.";
      }
      enum SHA2-256 {
        value 3;
        description
          "SHA2-256.";
      }
      enum SHA2-384 {
        value 4;
        description
          "SHA2-384.";
      }
      enum SHA2-512 {
        value 5;
        description
          "SHA2-512.";
      }
      enum SM3 {
        value 6;
        description
          "SM3.";
      }
    }
    description
      "The type of authentication-algorithm definition.";
  }

