  typedef policy-mode-type-deviations {
    type enumeration {
      enum isakmp {
        value 1;
        description
          "Indicates use of isakmp to establish the IPsec SA.";
      }
      enum isakmp-template {
        value 2;
        description
          "Indicates use of isakmp template to establish the IPsec SA.";
      }
    }
    description
