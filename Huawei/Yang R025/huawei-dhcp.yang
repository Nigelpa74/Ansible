        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        description
          "Interface name.";
      }
    }
  }
  rpc reset-server-statistics {
    ext:node-ref "/dhcp:dhcp/dhcp:server";
    description
      "Clear statistics of DHCP server.";
  }
  rpc reset-snooping-alarm-statistics-by-interface {
    ext:node-ref "/dhcp:dhcp/dhcp:snooping";
    description
      "Clear DHCP snooping alarm statistics by interface.";
    input {
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        mandatory true;
        description
          "Interface name.";
      }
    }
  }
  rpc reset-snooping-alarm-statistics-by-vlan-and-interface {
    ext:node-ref "/dhcp:dhcp/dhcp:snooping";
    description
      "Clear DHCP snooping alarm statistics by VLAN and interface.";
    input {
      leaf vlan-id {
        type uint16 {
          range "1..4094";
        }
        mandatory true;
        description
          "VLAN ID.";
      }
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        description
          "Interface name.";
      }
    }
  }
  rpc reset-snooping-alarm-statistics-by-bd {
    ext:node-ref "/dhcp:dhcp/dhcp:snooping";
    description
      "Clear DHCP snooping alarm statistics by bridge domain.";
    input {
      leaf bd-id {
        type uint32 {
          range "1..16777215";
        }
        mandatory true;
        description
          "Bridge-domain ID.";
      }
    }
  }
  rpc reset-client-records {
    ext:node-ref "/dhcp:dhcp/dhcp:relay/dhcp:client-records";
    description
      "Clear DHCP client records.";
  }
  rpc reset-client-records-by-vlan-and-interface {
    ext:node-ref "/dhcp:dhcp/dhcp:relay/dhcp:client-records";
    description
      "Clear DHCP client records by VLAN and interface.";
    input {
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        mandatory true;
        description
          "Interface name.";
      }
      leaf start-pevlan {
        type uint16 {
          range "1..4094";
        }
        description
          "Start PE VLAN ID.";
      }
      leaf end-pevlan {
        type uint16 {
          range "1..4094";
        }
        description
          "End PE VLAN ID.";
      }
      leaf start-cevlan {
        type uint16 {
          range "1..4094";
        }
        description
          "Start CE VLAN ID.";
      }
      leaf end-cevlan {
        type uint16 {
          range "1..4094";
        }
        description
          "End CE VLAN ID.";
      }
    }
  }
  rpc reset-client-records-by-mac {
    ext:node-ref "/dhcp:dhcp/dhcp:relay/dhcp:client-records";
    description
      "Clear DHCP client records by MAC.";
    input {
      leaf mac-address {
        type pub-type:mac-address;
        mandatory true;
        description
          "MAC address.";
      }
    }
  }
  rpc reset-client-records-by-option-value {
    ext:node-ref "/dhcp:dhcp/dhcp:relay/dhcp:client-records";
    description
      "Clear DHCP client records by option value.";
    input {
      leaf option-value {
        type string {
          length "1..64";
          pattern '[0-9A-F]+';
        }
        mandatory true;
        description
          "The content of option value.";
      }
    }
  }
  rpc reset-interface-pool-address-state {
    description
      "Reset interface pool address state.";
    input  {
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        mandatory true;
        description
          "Interface pool name.";
      }
      leaf start-ip-address {
        when "../reset-flag='ip'";
        type inet:ipv4-address-no-zone;
        mandatory true;
        description
          "Start IP address.";
      }
      leaf end-ip-address {
        when "../reset-flag='ip'";
        type inet:ipv4-address-no-zone;
        description
          "End IP address.";
      }
      leaf reset-flag {
        type recycle-address-state;
        mandatory true;
        description
          "Address status.";
      }
    }
  }
  rpc reset-dhcp-proxy-user {
    ext:node-ref "/dhcp:dhcp-relay-type/dhcp:proxy-users/dhcp:proxy-user";
    description
      "Reset DHCP relay proxy user.";
  }
  rpc reset-dhcp-proxy-user-by-interface {
    ext:node-ref "/dhcp:dhcp-relay-type/dhcp:proxy-users/dhcp:proxy-user";
    description
      "Reset DHCP relay proxy user by interface.";
    input {
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        mandatory true;
        description
          "Interface name.";
      }
    }
  }
  rpc reset-dhcp-proxy-user-by-mac {
    ext:node-ref "/dhcp:dhcp-relay-type/dhcp:proxy-users/dhcp:proxy-user";
    description
      "Reset DHCP relay proxy user by MAC.";
    input {
      leaf mac-address {
        type pub-type:mac-address;
        mandatory true;
        description
          "Client MAC address.";
      }
    }
  }
  rpc reset-dhcp-proxy-user-by-client-ip-address {
    ext:node-ref "/dhcp:dhcp-relay-type/dhcp:proxy-users/dhcp:proxy-user";
    description
      "Reset DHCP relay proxy user by client IP address.";
    input {

      leaf client-ip-address {
        type inet:ipv4-address-no-zone;
        mandatory true;
        description
          "Client IP address.";
      }
      leaf vpn-name {
        type leafref {
          path "/ni:network-instance/ni:instances/ni:instance/ni:name";
        }
        description
          "VPN name.";
      }
    }
  }
  rpc reset-dhcp-proxy-user-by-server-ip-address {
    ext:node-ref "/dhcp:dhcp-relay-type/dhcp:proxy-users/dhcp:proxy-user";
    description
      "Reset DHCP relay proxy user by server IP address.";
    input {
      leaf server-ip-address {
        type inet:ipv4-address-no-zone;
        mandatory true;
        description
          "Server IP address.";
      }
      leaf vpn-name {
        type leafref {
          path "/ni:network-instance/ni:instances/ni:instance/ni:name";
        }
        description
          "VPN name.";
      }
    }
  }
  rpc client-renew {
    ext:node-ref "/dhcp:dhcp/dhcp:client";
    description
      "Manually renew the lease of the IP address obtained by a DHCP client.";
    input  {
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        description
          "Interface name.";
      }
    }
  }
  augment "/ifm:ifm/ifm:interfaces/ifm:interface" {
    description "Extend interface attribute.";
    container dhcp-if {
      description
        "Configure DHCP attributes on an interface.";
      container dhcp-packet-setting {
        when "(not(../../ifm:l2-mode-enable='true'))";
        description
          "Configure DHCP packets.";
        leaf ip-ttl {
          type uint8 {
            range "1..255";
          }
          must "not(../../../dhcp:dhcp-client-if/dhcp:address-allocation)";
          description
            "IP time to live.";
        }
        leaf dscp-outbound {
          type uint8 {
            range "0..63";
          }
          must "not(../../../dhcp:dhcp-client-if/dhcp:address-allocation)";
          description
            "DSCP outbound.";
        }
        leaf server-enable {
          type server-enable-state;
          description
            "Enable/disable the function of DHCP server on an interface.";
        }
      }
      container option82-formats {
        description
          "List of DHCP option82 formats.";
        list option82-format {
          key "sub-option-type";
          description
            "Configure a DHCP option82 format.";
          leaf sub-option-type {
            type option82-sub-option-type;
            description
              "DHCP option82 sub-option type.";
          }
          leaf option82-format {
            type option82-format;
            must "(((../sub-option-type != 'circuit-remote') and ((../option82-format = 'self-define'  or ../option82-format = 'user-defined') and ../user-define-text)) or ((../sub-option-type = 'circuit-remote') and (../option82-format = 'type1' or ../option82-format = 'type2' or ../option82-format = 'cn-telecom' or ../option82-format = 'cn-telecom-inherit' or ((../option82-format = 'self-define'  or ../option82-format = 'user-defined') and ../user-define-text))))";
            mandatory true;
            description
              "DHCP option82 format.";
          }
          leaf user-define-text {
            when "../option82-format = 'self-define' or ../option82-format = 'user-defined'";
            type string {
              length "1..255";
              pattern '([^\t]{1,})';
            }
            mandatory true;
            description
              "DHCP option82 user-defined string.";
          }
        }
      }
      container option82-vlan-formats {
        description
          "List of DHCP option82 formats with VALN.";
        list option82-vlan-format {
          key "vlan-id cevlan-id sub-option-type";
          description
            "Configure a DHCP option82 format with VLAN.";
          leaf vlan-id {
            type uint16 {
              range "0..4094";
            }
            description
              "Indicate an outer VLAN ID. Value 0 Indicates no VLAN.";
          }
          leaf cevlan-id {
            type uint16 {
              range "0..4094";
            }
            description
              "Indicates an inner VLAN ID. Value 0 Indicates no VLAN.";
          }
          leaf sub-option-type {
            type option82-sub-option-type;
            must "(../sub-option-type = 'circuit-remote' 
                     and not(/ifm:ifm/ifm:interfaces/ifm:interface[ifm:name = current()/../../../../ifm:name]/dhcp:dhcp-if/dhcp:option82-formats/dhcp:option82-format[dhcp:sub-option-type='circuit-id']) 
                     and not(/ifm:ifm/ifm:interfaces/ifm:interface[ifm:name = current()/../../../../ifm:name]/dhcp:dhcp-if/dhcp:option82-formats/dhcp:option82-format[dhcp:sub-option-type='remote-id']))
                   or ((../sub-option-type = 'circuit-id' or ../sub-option-type = 'remote-id') 
                     and not(/ifm:ifm/ifm:interfaces/ifm:interface[ifm:name = current()/../../../../ifm:name]/dhcp:dhcp-if/dhcp:option82-formats/dhcp:option82-format[dhcp:sub-option-type='circuit-remote']))";
            description
              "DHCP option82 sub-option type.";
          }
          leaf option82-format {
            type option82-format;
            must "(((../sub-option-type != 'circuit-remote') and (../option82-format = 'self-define' and ../user-define-text)) or ((../sub-option-type = 'circuit-remote') and (../option82-format = 'type1' or ../option82-format = 'type2' or ../option82-format = 'cn-telecom' or (../option82-format = 'self-define' and ../user-define-text))))";
            mandatory true;
            description
              "DHCP option82 format.";
          }
          leaf user-define-text {
            when "../option82-format = 'self-define' or ../option82-format = 'user-defined'";
            type string {
              length "1..255";
              pattern '([^\t]{1,})';
            }
            mandatory true;
            description
              "DHCP option82 user-defined string.";
          }
        }
      }
      container option82-insert-setting {
        description
          "Configure the interface to insert or forcibly insert DHCP option82 to DHCP packets.";
        choice option82-insert-format {
          description
            "Specify DHCP option82 insertion format.";
          case insert-format {
            description
              "Configure the interface to insert DHCP option82 to DHCP packets.";
            leaf insert {
              type empty;
              description
                "Configure the interface to insert DHCP option82 to DHCP packets.";
            }
          }
          case rebuild-format {
            description
            "Configure the interface to forcibly insert DHCP option82 to DHCP packets.";
            leaf rebuild {
              type empty;
              description
                "Configure the interface to forcibly insert DHCP option82 to DHCP packets.";
            }
          }
        }
      }
      container append-vendor-specific {
        when "../../ethernet:ethernet/ethernet:main-interface/ethernet:l2-attribute";
        description
          "Configure to insert the Sub9 suboption into Option 82.";
        leaf enble {
          type boolean;
          default "false";
          description
            "Enable/disable inserting the Sub9 suboption into Option 82.";
        }
      }
      container encapsulation {
        description
          "Configure suboptions inserted into the DHCP Option 82 field.";
        leaf suboption {
          type option82-encapsulation-sub-option;
          default "circuit-id remote-id subscriber-id vendor-specific-id";
          description
            "Configure suboptions inserted into the DHCP Option 82 field.";
        }
      }
      container subscriber-id {
        description
          "Configure the Sub6 suboption into the DHCP Option 82 field of DHCP messages and configures the format of the Sub6 suboption.";
        choice subscriber-id-format {
          description
            "The format of subscriber-id.";
          case ascii-format {
            description
              "The text of ascii.";
            leaf ascii-text {
              type string {
                length "1..128";
              }
              description
                "DHCP option82 ascii-type format.";
            }
          }
          case hex-format {
            description
              "The text of hex.";
            leaf hex-text {
              type string {
                length "1..256";
              }
              description
                "DHCP option82 hex-type format.";
            }
          }
        }
      }
      container anti-attack-check {
        description
          "Configure anti-attack check function.";
        leaf magic-cookie {
          type boolean;
          default "false";
          description
            "Enable/disable the function of checking the magic-cookie field in a DHCP packet and discarding a DHCP packet with an incorrect value in the magic-cookie field.";
        }
        leaf udp-checksum {
          type boolean;
          default "true";
          description
            "Enable/disable the function of checking the UDP header checksum in a DHCP packet and discarding a DHCP packet with an incorrect checksum.";
        }
      }
    }
    container dhcp-client-if {
      description
        "Configure DHCP client attributes on an interface.";
      leaf address-allocation {
        type empty;
        description
          "DHCP client allocate IP.";
      }
      leaf expected-lease {
        type uint32 {
          range "60..864000";
        }
        units "s";
        description
          "DHCP client expected lease.";
      }
      leaf option60 {
        type string {
          length "1..128";
          pattern '((\S[^\t]*\S)|\S)';
        }
        description
          "The value of DHCP client option60 on an interface.";
      }
      leaf default-route-preference {
        type uint8 {
          range "1..255";
        }
        default "60";
        description
          "Configure the default route preference that a DHCP server delivers to a DHCP client.";
      }
      leaf client-id {
        type string {
          length "2..64";
        }
        description
          "Configure an identifier for a DHCP client.";
      }
      leaf host-name {
        type string {
          length "1..64";
        }
        description
          "Configure a host name for a DHCP/BOOTP client.";
      }
      leaf default-ip-enable {
        type boolean;
        default "false";
        description
          "Enable/disable DHCP client default IP.";
      }
      leaf-list request-option {
        type enumeration {
          enum "option1" {
            value 1;
            description
              "The value is of enumerated type and can be 1.";
          }
          enum "option4" {
            value 4;
            description
              "The value is of enumerated type and can be 4.";
          }
          enum "option7" {
            value 7;
            description
              "The value is of enumerated type and can be 7.";
          }
          enum "option17" {
            value 17;
            description
              "The value is of enumerated type and can be 17.";
          }
          enum "option42" {
            value 42;
            description
              "The value is of enumerated type and can be 42.";
          }
          enum "option43" {
            value 43;
            description
              "The value is of enumerated type and can be 43.";
          }
          enum "option66" {
            value 66;
            description
              "The value is of enumerated type and can be 66.";
          }
          enum "option67" {
            value 67;
            description
              "The value is of enumerated type and can be 67.";
          }
          enum "option120" {
            value 120;
            description
              "The value is of enumerated type and can be 120.";
          }
          enum "option129" {
            value 129;
            description
              "The value is of enumerated type and can be 129.";
          }
          enum "option143" {
            value 143;
            description
              "The value is of enumerated type and can be 143.";
          }
          enum "option145" {
            value 145;
            description
              "The value is of enumerated type and can be 145.";
          }
          enum "option146" {
            value 146;
            description
              "The value is of enumerated type and can be 146.";
          }
          enum "option148" {
            value 148;
            description
              "The value is of enumerated type and can be 148.";
          }
          enum "option150" {
            value 150;
            description
              "The value is of enumerated type and can be 150.";
          }
        }
        max-elements 15;
        description
          "Configure a list of request options that the Option55 field in DHCP Request packets carries besides the default options.";
      }
      leaf-list request-option-exclude {
        type enumeration {
          enum "option3" {
            value 3;
            description
              "The value is of enumerated type and can be 3.";
          }
          enum "option6" {
            value 6;
            description
              "The value is of enumerated type and can be 6.";
          }
          enum "option15" {
            value 15;
            description
              "The value is of enumerated type and can be 15.";
          }
          enum "option28" {
            value 28;
            description
              "The value is of enumerated type and can be 28.";
          }
          enum "option33" {
            value 33;
            description
              "The value is of enumerated type and can be 33.";
          }
          enum "option44" {
            value 44;
            description
              "The value is of enumerated type and can be 44.";
          }
          enum "option121" {
            value 121;
            description
              "The value is of enumerated type and can be 121.";
          }
          enum "option184" {
            value 184;
            description
              "The value is of enumerated type and can be 184.";
          }
        }
        max-elements 8;
        description
          "Configure a list of default request options that are not carried in the Option55 field of DHCP Request messages.";
      }
      container bootp-alloc {
        description
          "Configure the BOOTP client function on an interface.";
        leaf enable {
          type boolean;
          default "false";
          description
            "Enable/disable the BOOTP client function on an interface.";
        }
        leaf unicast {
          type boolean;
          default "false";
          description
            "Enable/disable the client requests the server to unicast response packets to the client.";
        }
      }
      container client-track {
        description
          "Configure the track function between DHCP client and BFD and IP link.";
        choice track-type {
          default "bfd-session";
          description
            "Choice track type.";
          case bfd-session {
            description
              "Case bfd session.";
            leaf bfd-session {
              type string {
                length "1..15";
              }
              description
                "BFD session name.";
            }
          }
          case ip-link {
            description
              "Case ip link.";
            leaf ip-link {
              type string {
                length "1..31";
              }
              description
                "IP link name.";
            }
          }
        }
      }
      container gateway-detect {
        description
          "Configure gateway detection on a DHCP client.";
        leaf period {
          type uint32 {
            range "1..86400";
          }
          units "s";
          description
            "Specify an interval for gateway detection on a DHCP client.";
        }
        leaf retransmit {
          type uint8 {
            range "1..10";
          }
          description
            "Specify the retransmission count of gateway detection on a DHCP client.";
        }
        leaf timeout {
          type uint16 {
            range "300..2000";
          }
          units "ms";
          description
            "Specify the timeout period of gateway detection on a DHCP client.";
        }
      }
      container vendor-specific {
        description
          "Configure the vendor-specific on a DHCP client.";
        leaf insert-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the insertion of suboption1 of Option 125.";
        }
        leaf sub-option-value {
          when "../insert-enable='true'";
          type string {
            length "1..128";
          }
          description
            "Specify the content of sub-option value by users.";
        }
      }
      container client-status {
        config false;
        description
          "Operational state of DHCP client.";
        leaf fsm-state {
          type client-state;
          config false;
          description
            "DHCP client status.";
        }
        leaf mac-address {
          type pub-type:mac-address;
          config false;
          description
            "User MAC address.";
        }
        leaf ip-address {
          type inet:ipv4-address-no-zone;
          config false;
          description
            "IP address.";
        }
        leaf ip-mask {
          type inet:ipv4-address-no-zone;
          config false;
          description
            "IP mask.";
        }
        leaf server-address {
          type inet:ipv4-address-no-zone;
          config false;
          description
            "Server IP address.";
        }
        leaf lease-obtained-time {
          type yang:date-and-time;
          config false;
          description
            "Lease obtained time.";
        }
        leaf lease-expire-time {
          type yang:date-and-time;
          config false;
          description
            "Lease expires time.";
        }
        leaf lease-renew-time {
          type yang:date-and-time;
          config false;
          description
            "Lease renews time.";
        }
        leaf lease-rebind-time {
          type yang:date-and-time;
          config false;
          description
            "Lease rebinds time.";
        }
      }
      container client-statistics {
        config false;
        description
          "Statistics of DHCP client.";
        leaf total-packets-received {
          type uint32;
          units packet;
          config false;
          description
            "The number of total packets received.";
        }
        leaf bootp-reply-packets-received {
          type uint32;
          units packet;
          config false;
          description
            "The number of bootp reply packets received.";
        }
        leaf offer-packets-received {
          type uint32;
          units packet;
          config false;
          description
            "The number of offer packets received.";
        }
        leaf ack-packets-received {
          type uint32;
          units packet;
          config false;
          description
            "The number of ACK packets received.";
        }
        leaf nak-packets-received {
          type uint32;
          units packet;
          config false;
          description
            "The number of NAK packets received.";
        }
        leaf total-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of total packets send.";
        }
        leaf bootp-request-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of bootp request packets send.";
        }
        leaf discovery-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of discover packets send.";
        }
        leaf request-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of request packets send.";
        }
        leaf reboot-request-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of reboot request packets send.";
        }
        leaf select-request-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of select request packets send.";
        }
        leaf renew-request-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of renew request packets send.";
        }
        leaf rebind-request-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of rebind request packets send.";
        }
        leaf decline-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of decline packets send.";
        }
        leaf release-packets-send {
          type uint32;
          units packet;
          config false;
          description
            "The number of release packets send.";
        }
      }
    }
    container dhcp-snooping-if {
      description
        "Configure DHCP snooping interface attributes.";
      container basic-attribute {
        description
          "Configure basic DHCP snooping attribute on the interface.";
        leaf enable {
          type boolean;
          default "false";
          description
            "Enable/disable DHCP snooping on an interface. DHCP snooping cannot be enabled on both a VLANIF interface and a VLAN, DHCP snooping cannot be enabled both on a VBDIF interface and in a BD, DHCP snooping cannot be enabled on both a VBDIF interface and a Layer 2 sub-interface.";
        }
        leaf trust-enable {
          type boolean;
          default "false";
          description
            "Enable/disable trusted interfaces.";
        }
        leaf rate-limit {
          type uint16 {
            range "1..5000";
          }
          description
            "The rate limit on interface.";
        }
        leaf check-rate-enable {
          type boolean;
          description
            "Enable/disable the rate limit function.";
        }
        leaf alarm-rate-enable {
          type boolean;
          description
            "Enable/disable the rate limit alarm function.";
        }
        leaf alarm-rate-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "The alarm threshold for the DHCP packet rate on interfaces.";
        }
        leaf check-arp-enable {
          type boolean;
          default "false";
          description
            "Enable/disable ARP check.";
        }
        leaf alarm-arp-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the ARP alarm function.";
        }
        leaf alarm-arp-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "ARP alarm threshold.";
        }
        leaf check-ip-enable {
          type boolean;
          default "false";
          description
            "Enable/disable IP check.";
        }
        leaf alarm-ip-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the IP alarm function.";
        }
        leaf alarm-ip-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "IP alarm threshold.";
        }
        leaf alarm-reply-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the alarm function for discarded untrusted packets.";
        }
        leaf alarm-reply-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "The alarm threshold is configured for discarded untrusted packets.";
        }
        leaf check-mac-enable {
          type boolean;
          default "false";
          description
            "Enable/disable consistency check on MAC addresses.";
        }
        leaf alarm-mac-enable {
          type boolean;
          default "false";
          description
            "Enable/disable consistency check on MAC addresses.";
        }
        leaf alarm-mac-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "The alarm threshold for the consistency check on MAC addresses.";
        }
        leaf check-user-bind-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the check on DHCP snooping binding table.";
        }
        leaf alarm-user-bind-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the alarm function for discarded packets that do not match entries in the DHCP snooping binding table.";
        }
        leaf alarm-user-bind-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "The alarm threshold is configured for the DHCP snooping binding table.";
        }
        leaf max-user-number {
          type uint32 {
            range "1..32768";
          }
          description
            "Maximum number of users allowed on a DHCP snooping-enabled interface.";
        }
        leaf alarm-user-limit-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the alarm function for the maximum number of users.";
        }
        leaf alarm-user-limit-threshold {
          type uint16 {
            range "1..100";
          }
          default "100";
          description
            "Alarm threshold for the maximum number of users.";
        }
        leaf sticky-mac-enable {
          type boolean;
          description
            "Enable/disable sticky MAC on a DHCP snooping-enabled interface.";
        }
        leaf no-user-binding {
          type boolean;
          default "false";
          description
            "Enable/disable to configure the interface not to generate user binding table after DHCP snooping is enabled.";
        }
        leaf exclude-dhcp-snooping {
          type boolean;
          default "false";
          description
            "Enable/disable to disable DHCP snooping on a specified interface in a VLAN where DHCP snooping is enabled.";
        }
        leaf deny-dhcp-enable {
          type boolean;
          default "false";
          description
            "Enable/disable to deny DHCP packet on a DHCP snooping-enabled interface.";
        }
      }
      container static-binds {
        description
          "List of static binding table on an interface.";
        list static-bind {
          key "ip-address vlan-id cevlan-id";
          description
            "Configure static binding table on an interface.";
          leaf ip-address {
            type inet:ipv4-address-no-zone;
            description
              "IP address.";
          }
          leaf vlan-id {
            type uint16 {
              range "0..4094";
            }
            must "(../../../../ifm:class='main-interface' and ../vlan-id=0) or
                  (../../../../ethernet:ethernet/ethernet:l3-sub-interface/ethernet:dot1q-termination/ethernet:dot1q-vlans/ethernet:dot1q-vlans/ethernet:vlan-list and ../vlan-id!=0) or
                  (../../../../ethernet:ethernet/ethernet:l3-sub-interface/ethernet:qinq-termination/ethernet:qinq-vids/ethernet:qinq-vid and ../vlan-id!=0) or
                  (../../../../ethernet:ethernet/ethernet:l3-sub-interface/ethernet:vlan-type-dot1q and ../vlan-id=../../../../ethernet:ethernet/ethernet:l3-sub-interface/ethernet:vlan-type-dot1q/ethernet:vlan-type-vid)";
            description
              "VLAN ID, 0 means NULL.";
          }
          leaf cevlan-id {
            type uint16 {
              range "0..4094";
            }
            must "(../../../../ifm:class='main-interface' and ../cevlan-id=0) or
                  (../../../../ethernet:ethernet/ethernet:l3-sub-interface/ethernet:dot1q-termination/ethernet:dot1q-vlans/ethernet:dot1q-vlans/ethernet:vlan-list and ../cevlan-id=0) or
                  (../../../../ethernet:ethernet/ethernet:l3-sub-interface/ethernet:qinq-termination/ethernet:qinq-vids/ethernet:qinq-vid and ../cevlan-id!=0) or
                  (../../../../ethernet:ethernet/ethernet:l3-sub-interface/ethernet:vlan-type-dot1q and ../cevlan-id=0)";
            description
              "CE VLAN ID, 0 means NULL.";
          }
          leaf mac-address {
            type pub-type:mac-address {
              length "0..255";
              pattern '([0-9a-f][0|2|4|6|8|a|c|e][0-9a-f]{2}(-[0-9a-f]{4}){2})';
            }
            description
              "MAC address.";
          }
        }
      }
      container committed-access-rate {
        description
          "Configure information of DHCP snooping CAR in a VLAN.";
        leaf car-cir {
          type uint32 {
            range "1..100000000";
          }
          units pps;
          description
            "CAR CIR value.";
        }
        leaf car-cbs {
          type uint32 {
            range "1..536870912";
          }
          units pps;
          description
            "CAR CBS value.";
        }
      }
      container packets-discarded-statistics {
        config false;
        description
          "Statistics of DHCP snooping discarded packets.";
        leaf drop-arp-packets-count {
          type uint32;
          config false;
          description
            "Number of ARP packets discarded because they do not match entries in the DHCP snooping binding table.";
        }
        leaf drop-ip-packets-count {
          type uint32;
          config false;
          description
            "Number of IP packets discarded because they do not match entries in the DHCP snooping binding table.";
        }
        leaf packet-drop-by-user-bind {
          type uint32;
          config false;
          description
            "Number of packets discarded because they do not match entries in the DHCP snooping binding table.";
        }
        leaf packet-drop-by-mac {
          type uint32;
          config false;
          description
            "Number of packets discarded on an interface due to MAC address inconsistency.";
        }
        leaf packet-drop-by-untrust-reply {
          type uint32;
          config false;
          description
            "Number of packets discarded because they are untrusted.";
        }
        leaf packet-drop-by-rate {
          type uint32;
          units "pps";
          config false;
          description
            "Number of packets discarded on an interface after the packet rate limit is reached.";
        }
      }
    }
  }
  augment "/vlan:vlan/vlan:vlans/vlan:vlan" {
    description "Extend VLAN attribute.";
    container dhcp-vlan {
      description
        "Configure DHCP attributes in a VLAN.";
      container interface-option82-formats {
        description
          "List of configuring the format of the Option 82 field for an interface in the specified VLAN.";
        list interface-option82-format {
          key "if-name";
          description
            "Configure the format of the Option 82 field for an interface in the specified VLAN.";
          leaf if-name {
            type leafref {
              path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
            }
            description
              "Interface name. The interface must be the member interface of this VLAN.";
          }
          leaf option82-format {
            type option82-format;
            mandatory true;
            description
              "DHCP option82 format.";
          }
          leaf user-define-text {
            when "../option82-format = 'self-define' or ../option82-format = 'user-defined'";
            type string {
              length "1..255";
              pattern '([^\t]{1,})';
            }
            mandatory true;
            description
              "DHCP option82 user-defined string.";
          }
        }
      }
      container interface-option82-insert-settings {
        description
          "List of configuring all interfaces in a VLAN to insert or forcibly insert DHCP Option82 to DHCP packets.";
        list interface-option82-insert-setting {
          key "if-name";
          description
            "Configure all interfaces in a VLAN to insert or forcibly insert DHCP Option82 to DHCP packets.";
          leaf if-name {
            type leafref {
              path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
            }
            description
              "Interface name. The interface must be the member interface of this VLAN.";
          }
          leaf to-if-name {
            type leafref {
              path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
            }
            description
              "Interface name. The interface must be the member interface of this VLAN.";
          }
          choice option82-insert-format {
            mandatory true;
            description
              "Specify DHCP option82 insertion format.";
            case insert-format {
              description
                "Configure all interfaces in a VLAN to insert DHCP Option82 to DHCP packets.";
              leaf insert {
                type empty;
                description
                  "Configure all interfaces in a VLAN to insert DHCP Option82 to DHCP packets.";
              }
            }
            case rebuild-format {
              description
              "Configure all interfaces in a VLAN to forcibly insert DHCP Option82 to DHCP packets.";
              leaf rebuild {
                type empty;
                description
                  "Configure all interfaces in a VLAN to forcibly insert DHCP Option82 to DHCP packets.";
              }
            }
          }
        }
      }
      container option82-insert-setting {
        description
          "Configure all interfaces in a VLAN to insert or forcibly insert DHCP option82 to DHCP packets.";
        choice option82-insert-format {
          description
            "Specify DHCP option82 insertion format.";
          case insert-format {
            description
              "Configure all interfaces in a VLAN to insert DHCP option82 to DHCP packets.";
            leaf insert {
              type empty;
              description
                "Configure all interfaces in a VLAN to insert DHCP option82 to DHCP packets.";
            }
          }
          case rebuild-format {
            description
              "Configure all interfaces in a VLAN to forcibly insert DHCP option82 to DHCP packets.";
            leaf rebuild {
              type empty;
              description
                "Configure all interfaces in a VLAN to forcibly insert DHCP option82 to DHCP packets.";
            }
          }
        }
      }
      container append-vendor-specific {
        description
          "Configure to insert the Sub9 suboption into Option 82.";
        leaf enble {
          type boolean;
          default "false";
          description
            "Enable/disable inserting the Sub9 suboption into Option 82.";
        }
      }
      container encapsulation {
        description
          "Configure suboptions inserted into the DHCP Option 82 field.";
        leaf suboption {
          type option82-encapsulation-sub-option;
          default "circuit-id remote-id subscriber-id vendor-specific-id";
          description
            "Configure suboptions inserted into the DHCP Option 82 field.";
        }
      }
      container anti-attack-check {
        description
          "Configure anti-attack check function.";
        leaf magic-cookie {
          type boolean;
          default "false";
          description
            "Enable/disable the function of checking the magic-cookie field in a DHCP packet and discarding a DHCP packet with an incorrect value in the magic-cookie field.";
        }
        leaf udp-checksum {
          type boolean;
          default "true";
          description
            "Enable/disable the function of checking the UDP header checksum in a DHCP packet and discarding a DHCP packet with an incorrect checksum.";
        }
      }
    }
    container dhcp-snooping-vlan {
      description
        "Configure DHCP snooping VLAN attributes.";
      container basic-attribute {
        description
          "Configure basic attributes of DHCP snooping on a VLAN.";
        leaf enable {
          type boolean;
          default "false";
          description
            "Enable/disable DHCP snooping in a VLAN. DHCP snooping cannot be enabled on both a VLANIF interface and a VLAN, DHCP snooping cannot be enabled both on a VBDIF interface and in a BD, DHCP snooping cannot be enabled on both a VBDIF interface and a Layer 2 sub-interface.";
        }
        leaf check-rate-enable {
          type boolean;
          description
            "Enable/disable rate limit of DHCP packets.";
        }
        leaf vlan-rate {
          type uint32 {
            range "1..5000";
          }
          units pps;
          description
            "The rate limit in a VLAN.";
        }
        leaf trust-enable {
          type boolean;
          default "false";
          description
            "Enable/disable configuration information of a trusted VLAN.";
        }
        leaf check-arp-enable {
          type boolean;
          default "false";
          description
            "Enable/disable ARP check.";
        }
        leaf alarm-arp-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the ARP alarm function.";
        }
        leaf alarm-arp-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "ARP alarm threshold.";
        }
        leaf check-ip-enable {
          type boolean;
          default "false";
          description
            "Enable/disable IP check.";
        }
        leaf alarm-ip-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the IP alarm function.";
        }
        leaf alarm-ip-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "IP alarm threshold.";
        }
        leaf alarm-reply-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the alarm function when the number of discarded untrusted packets reaches the configured threshold.";
        }
        leaf alarm-reply-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "Untrusted packet discarding alarm threshold.";
        }
        leaf check-mac-enable {
          type boolean;
          default "false";
          description
            "Enable/disable consistency check on MAC address.";
        }
        leaf alarm-mac-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the consistency check alarm on MAC address.";
        }
        leaf alarm-mac-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "Consistency check alarm threshold on MAC address.";
        }
        leaf check-user-bind-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the check on DHCP snooping binding table.";
        }
        leaf alarm-user-bind-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the user binding table alarm.";
        }
        leaf alarm-user-bind-threshold {
          type uint16 {
            range "1..1000";
          }
          description
            "User binding table alarm threshold.";
        }
        leaf max-user-number {
          type uint16 {
            range "1..32768";
          }
          description
            "Maximum number of users allowed on all DHCP snooping-enabled interfaces in a VLAN.";
        }
        leaf alarm-user-limit-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the user limit alarm.";
        }
        leaf alarm-user-limit-threshold {
          type uint16 {
            range "1..100";
          }
          default "100";
          description
            "User limit alarm threshold.";
        }
        leaf no-user-binding {
          type boolean;
          default "false";
          description
            "Enable/disable to configure the interface not to generate user binding table after DHCP snooping is enabled in a VLAN.";
        }
        leaf deny-dhcp-enable {
          type boolean;
          default "false";
          description
            "Enable/disable to deny DHCP packet.";
        }
      }
      container vlan-trusts {
        description
          "List of configuring information of trusted interfaces.";
        list vlan-trust {
          key "if-name";
          description
            "Configure a trusted interface in the specified VLAN.";
          leaf if-name {
            type leafref {
              path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
            }
            must "(/ifm:ifm/ifm:interfaces/ifm:interface[ifm:name = current()]/ethernet:ethernet/ethernet:main-interface/ethernet:l2-attribute)";
            description
              "Names of trusted interface. The interface must be the member interface of this VLAN.";
          }
        }
      }
      container vlan-interfaces {
        description
          "List of configuring DHCP snooping-enabled interfaces in a VLAN.";
        list vlan-interface {
          key "if-name";
          description
            "Configure a DHCP snooping-enabled interface in a VLAN.";
          leaf if-name {
            type leafref {
              path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
            }
            description
              "Interface name.";
          }
          leaf enable {
            type boolean;
            default "false";
            description
              "Enable/disable DHCP snooping on an interface in a VLAN.";
          }
          leaf trust-flag {
            type boolean;
            default "false";
            description
              "Enable/disable DHCP snooping VLAN interface trust.";
          }
          leaf check-arp-enable {
            type boolean;
            default "false";
            description
              "Enable/disable ARP check.";
          }
          leaf alarm-arp-enable {
            type boolean;
            default "false";
            description
              "Enable/disable the ARP alarm function.";
          }
          leaf alarm-arp-threshold {
            type uint32 {
              range "1..1000";
            }
            description
              "ARP alarm threshold.";
          }
          leaf check-ip-enable {
            type boolean;
            default "false";
            description
              "Enable/disable IP check.";
          }
          leaf alarm-ip-enable {
            type boolean;
            default "false";
            description
              "Enable/disable the IP alarm function.";
          }
          leaf alarm-ip-threshold {
            type uint32 {
              range "1..1000";
            }
            description
              "IP alarm threshold.";
          }
          leaf alarm-reply-enable {
            type boolean;
            default "false";
            description
              "Enable/disable alarm of dropping untrusted packet.";
          }
          leaf alarm-reply-threshold {
            type uint32 {
              range "1..1000";
            }
            description
              "Threshold of dropping untrusted packet alarm.";
          }
          leaf check-mac-address-enable {
            type boolean;
            default "false";
            description
              "Enable/disable consistency check on MAC addresses.";
          }
          leaf alarm-mac-address-enable {
            type boolean;
            default "false";
            description
              "Enable/disable the consistency check alarm for MAC addresses.";
          }
          leaf alarm-mac-address-threshold {
            type uint32 {
              range "1..1000";
            }
            description
              "Consistency check alarm threshold for MAC address.";
          }
          leaf check-request-enable {
            type boolean;
            default "false";
            description
              "Enable/disable DHCP user binding table check.";
          }
          leaf alarm-request-enable {
            type boolean;
            default "false";
            description
              "Enable/disable DHCP userbind table alarm.";
          }
          leaf alarm-request-threshold {
            type uint32 {
              range "1..1000";
            }
            description
              "DHCP userbind table alarm threshold.";
          }
          leaf max-user-number {
            type uint32 {
              range "1..16384";
            }
            description
              "Maximum number of users allowed on a DHCP snooping-enabled interface in a VLAN.";
          }
          leaf alarm-user-limit-enable {
            type boolean;
            default "false";
            description
              "Enable/disable the user limit alarm.";
          }
          leaf alarm-user-limit-threshold {
            type uint32 {
              range "1..100";
            }
            default "100";
            description
              "User limit alarm threshold.";
          }
          container packets-discarded-statistics {
            config false;
            description
              "Statistics of DHCP snooping discarded packets.";
            leaf drop-arp-packets-count {
              type uint32;
              config false;
              description
                "Number of discarded ARP packets that do not match entries in the DHCP snooping binding table.";
            }
            leaf drop-ip-packets-count {
              type uint32;
              config false;
              description
                "Number of discarded IP packets that do not match entries in the DHCP snooping binding table.";
            }
            leaf drop-dhcp-request-conut-by-bind {
              type uint32;
              config false;
              description
                "Number of discarded DHCP request packets that do not match entries in the DHCP snooping binding table.";
            }
            leaf drop-dhcp-request-conut-by-mac-check {
              type uint32;
              config false;
              description
                "Number of discarded DHCP request packets that do not match entries in the MAC table.";
            }
            leaf drop-dhcp-reply-count {
              type uint32;
              config false;
              description
                "Number of discarded DHCP reply packets by untrusted port.";
            }
          }
        }
      }
      container static-binds {
        description
          "List of static binding tables in a VLAN.";
        list static-bind {
          must "(cevlan-id=0) or (cevlan-id!=0 and if-name)";
          key "ip-address cevlan-id";
          description
            "Configure a static binding table in a VLAN.";
          leaf ip-address {
            type inet:ipv4-address-no-zone;
            description
              "IP address.";
          }
          leaf cevlan-id {
            type uint16 {
              range "0..4094";
            }
            description
              "CE VLAN ID.";
          }
          leaf mac-address {
            type pub-type:mac-address {
              length "0..255";
            }
            description
              "MAC address.";
          }
          leaf if-name {
            type leafref {
              path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
            }
            description
              "Interface name.";
          }
        }
      }
      container packet-discarded-statistics {
        config false;
        description
          "Statistics of DHCP snooping discarded packets.";
        leaf drop-arp-packets-count {
          type uint32;
          config false;
          description
            "Number of discarded ARP packets that do not match entries in the DHCP snooping binding table.";
        }
        leaf drop-ip-packets-count {
          type uint32;
          config false;
          description
            "Number of discarded IP packets that do not match entries in the DHCP snooping binding table.";
        }
        leaf drop-dhcp-request-count-by-bind {
          type uint32;
          config false;
          description
            "Number of discarded DHCP request packets that do not match entries in the DHCP snooping binding table.";
        }
        leaf drop-dhcp-request-count-by-mac-check {
          type uint32;
          config false;
          description
            "Number of discarded DHCP request packets that do not match entries in the MAC table.";
        }
        leaf drop-dhcp-reply-count {
          type uint32;
          config false;
          description
            "Number of DHCP reply packets discarded because they are sent from untrusted interfaces.";
        }
      }
    }
  }
  augment "/bd:bd/bd:instances/bd:instance" {
    description "Extend BD attribute.";
    container dhcp-bd {
      description 
        "Configure DHCP attributes in BDs.";
      container option82-formats {
        description
          "List of configuring DHCP option82 formats.";
        list option82-format {
          key "sub-option-type";
          description
            "Configure a DHCP option82 format.";
          leaf sub-option-type {
            type option82-sub-option-type;
            description
              "DHCP option82 sub-option type.";
          }
          leaf option82-format {
            type option82-format;
            mandatory true;
            description
              "DHCP option82 format.";
          }
        }
      }
      container option82-insert-setting {
        description
          "Configure all interfaces in a BD to insert or forcibly insert DHCP option82 to DHCP packets.";
        choice option82-insert-format {
          description
            "Specify DHCP option82 insertion format.";
          case insert-format {
            description
              "Configure all interfaces in a BD to insert DHCP option82 to DHCP packets.";
            leaf insert {
              type empty;
              description
                "Configure all interfaces in a BD to insert DHCP option82 to DHCP packets.";
            }
          }
          case rebuild-format {
            description
              "Configure all interfaces in a BD to forcibly insert DHCP option82 to DHCP packets.";
            leaf rebuild {
              type empty;
              description
                "Configure all interfaces in a BD to forcibly insert DHCP option82 to DHCP packets.";
            }
          }
        }
      }
      container encapsulation {
        description
          "Configure suboptions inserted into the DHCP Option 82 field.";
        leaf suboption {
          type option82-encapsulation-sub-option;
          default "circuit-id remote-id subscriber-id vendor-specific-id";
          description
            "Configure suboptions inserted into the DHCP Option 82 field.";
        }
      }
    }
    container dhcp-snooping-bd {
      description
        "Configure information of DHCP snooping on a bridge-domain.";
      container basic-attribute {
        description
          "Configure basic attributes of DHCP snooping on bridge-domain.";
        leaf enable {
          type boolean;
          default "false";
          description
            "Enable/disable DHCP snooping in a BD. DHCP snooping cannot be enabled on both a VLANIF interface and a VLAN, DHCP snooping cannot be enabled both on a VBDIF interface and in a BD, DHCP snooping cannot be enabled on both a VBDIF interface and a Layer 2 sub-interface.";
        }
        leaf trust-enable {
          type boolean;
          default "false";
          description
            "Enable/disable trusted information on a BD.";
        }
        leaf nni-trust-enable {
          type boolean;
          default "false";
          description
            "Enable/disable trusted network node interface.";
        }
        leaf check-arp-enable {
          type boolean;
          default "false";
          description
            "Enable/disable ARP check.";
        }
        leaf alarm-arp-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the ARP alarm function.";
        }
        leaf alarm-arp-threshold {
          type uint32 {
            range "1..1000";
          }
          description
            "ARP alarm threshold.";
        }
        leaf check-ip-enable {
          type boolean;
          default "false";
          description
            "Enable/disable IP check.";
        }
        leaf alarm-ip-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the IP alarm function.";
        }
        leaf alarm-ip-threshold {
          type uint32 {
            range "1..1000";
          }
          description
            "IP alarm threshold.";
        }
        leaf alarm-reply-enable {
          type boolean;
          default "false";
          description
            "Enable/disable alarm of dropping untrusted packet.";
        }
        leaf alarm-reply-threshold {
          type uint32 {
            range "1..1000";
          }
          description
            "Threshold of dropping untrusted packet alarm.";
        }
        leaf check-mac-enable {
          type boolean;
          default "false";
          description
            "Enable/disable MAC check.";
        }
        leaf alarm-mac-enable {
          type boolean;
          default "false";
          description
            "Enable/disable consistency check alarm on MAC addresses.";
        }
        leaf alarm-mac-threshold {
          type uint32 {
            range "1..1000";
          }
          description
            "Consistency check alarm threshold on MAC addresses.";
        }
        leaf check-request-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the user binding table check.";
        }
        leaf alarm-request-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the user binding table alarm function.";
        }
        leaf alarm-request-threshold {
          type uint32 {
            range "1..1000";
          }
          description
            "User bind table alarm threshold.";
        }
        leaf max-user-number {
          type uint32 {
            range "1..16384";
          }
          description
            "Maximum number of DHCP snooping users in a BD.";
        }
        leaf alarm-user-limit-enable {
          type boolean;
          default "false";
          description
            "Enable/disable the user limit alarm.";
        }
        leaf alarm-user-limit-threshold {
          type uint32 {
            range "1..100";
          }
          default "100";
          description
            "User limit alarm threshold.";
        }
      }
      container static-binds {
        description
          "List of static binding tables on BDs.";
        list static-bind {
          must "(ce-vlan!=0 and pe-vlan!=0) or (ce-vlan=0)";
          key "ip-address pe-vlan ce-vlan";
          description
            "Configure a static binding table of a BD.";
          leaf ip-address {
            type inet:ipv4-address-no-zone;
            description
              "IP address.";
          }
          leaf pe-vlan {
            type uint16 {
              range "0..4094";
            }
            description
              "PE VLAN ID, 0 means NULL.";
          }
          leaf ce-vlan {
            type uint16 {
              range "0..4094";
            }
            description
              "CE VLAN ID, 0 means NULL.";
          }
          leaf mac-address {
            type pub-type:mac-address {
              length "0..255";
              pattern '([0-9a-f][0|2|4|6|8|a|c|e][0-9a-f]{2}(-[0-9a-f]{4}){2})';
            }
            description
              "MAC address.";
          }
        }
      }
      container packets-discarded-statistics {
        config false;
        description
          "Statistics of DHCP snooping discarded packets.";
        leaf drop-arp-packets-count {
          type uint32;
          config false;
          description
            "Number of discarded ARP packets that do not match entries in the DHCP snooping binding table.";
        }
        leaf drop-ip-packets-count {
          type uint32;
          config false;
          description
            "Number of discarded IP packets that do not match entries in the DHCP snooping binding table.";
        }
        leaf drop-dhcp-request-count-by-bind {
          type uint32;
          config false;
          description
            "Number of discarded DHCP request packets that do not match entries in the DHCP snooping binding table.";
        }
        leaf drop-dhcp-request-count-by-mac-check {
          type uint32;
          config false;
          description
            "Number of discarded DHCP request packets that do not match entries in the MAC table.";
        }
        leaf drop-dhcp-reply-count {
          type uint32;
          config false;
          description
            "Number of DHCP reply packets discarded because they are sent from untrusted interfaces.";
        }
      }
    }
  }
  augment "/l2vpn:l2vpn/l2vpn:instances/l2vpn:instance" {
    description "Extend L2VPN attribute.";
    container dhcp-snooping-vsi {
      description
        "Configure DHCP snooping VSI attributes.";
      leaf nni-server-enable {
        type boolean;
        default "false";
        description
          "Enable/disable the network node interface to server.";
      }
    }
  }
}
