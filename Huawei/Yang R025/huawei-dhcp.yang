  ext:task-name "dhcp";
  typedef option82-sub-option-type {
    type enumeration {
      enum "circuit-id" {
        value 1;
        description
          "DHCP option82 sub-option circuit-ID.";
      }
      enum "remote-id" {
        value 2;
        description
          "DHCP option82 sub-option remote-ID.";
      }
      enum "circuit-remote" {
        value 3;
        description
          "DHCP option82 sub-option circuit-ID and sub-option remote-ID.";
      }
    }
    description
      "The type of option82 sub-option.";
  }
  typedef option82-format {
    type enumeration {
      enum "common" {
        value 1;
        description
          "DHCP option82 common format.";
      }
      enum "extend" {
        value 2;
        description
          "DHCP option82 extend format.";
      }
      enum "user-defined" {
        value 3;
        description
          "DHCP option82 user-defined format.";
      }
      enum "default" {
        value 4;
        description
          "DHCP option82 default format.";
      }
      enum "type1" {
        value 5;
        description
          "DHCP option82 type1 format.";
      }
      enum "type2" {
        value 6;
        description
          "DHCP option82 type2 format.";
      }
      enum "self-define" {
        value 7;
        description
          "DHCP option82 self-define format.";
      }
      enum "default-extra" {
        value 8;
        description
          "DHCP option82 extra default format.";
      }
      enum "cn-telecom" {
        value 9;
        description
          "DHCP option82 cn-telecom format.";
      }
      enum "self-define-extra" {
        value 10;
        description
          "DHCP option82 extra self-define format.";
      }
      enum "intracom-vxlan" {
        value 11;
        description
          "DHCP option82 Intracom-VXLAN format.";
      }
      enum "cn-telecom-inherit" {
        value 12;
        description
          "DHCP option82 cn-telecom-inherit format.";
      }
    }
    description
      "The type of DHCP option82 format.";
  }
  typedef option82-vendor-sub-option-format {
    type enumeration {
      enum "ascii" {
        value 1;
        description
          "DHCP option82 ascii-type format.";
      }
      enum "hex" {
        value 2;
        description
          "DHCP option82 hex-type format.";
      }
      enum "ip-address" {
        value 3;
        description
          "DHCP option82 sub9 IP-address.";
      }
      enum "sysname" {
        value 4;
        description
          "System name.";
      }
    }
    description
      "The type of DHCP option82 vendor sub-option format.";
  }
  typedef server-enable-state {
    type enumeration {
      enum "enable" {
        value 1;
        description
          "Enable the function of DHCP server on an interface.";
      }
      enum "disable" {
        value 2;
        description
          "Disable the function of DHCP server on an interface.";
      }
    }
    description
      "The state of DHCP server flag.";
  }
  typedef option82-encapsulation-sub-option {
    type bits {
      bit circuit-id {
        position 0;
        description
          "Inserts the Circuit-ID suboption.";
      }
      bit remote-id {
        position 1;
        description
          "Inserts the Remote-ID suboption.";
      }
      bit subscriber-id {
        position 2;
        description
          "Inserts the Subscriber-ID (SID) suboption.";
      }
      bit vendor-specific-id {
        position 3;
        description
          "Inserts the vendor-specific suboption in the Sub9 field.";
      }
    }
    description
      "Configure suboptions inserted into the DHCP Option 82 field.";
  }
  typedef recycle-address-state {
    type enumeration {
      enum "used" {
        value 1;
        description
          "The IP address is in use.";
      }
      enum "conflicted" {
        value 2;
        description
          "The IP address is in conflict state.";
      }
      enum "expired" {
        value 3;
        description
          "The IP address is in expired state.";
      }
      enum "ip" {
        value 4;
        description
          "The IP address range.";
      }
      enum "all" {
        value 5;
        description
          "The IP address is in all state.";
      }
    }
    description
      "Status of the DHCP address pool.";
  }
  typedef option82-sysname-format {
    type enumeration {
      enum "sysname" {
        value 4;
        description
          "System name.";
      }
    }
    description
      "The type of DHCP option82 vendor sub-option sysname format.";
  }
  container dhcp {
    description
      "Configure Dynamic Host Configuration Protocol.";
    container common {
      description
        "Configure basic DHCP.";
      container global {
        description
          "Configure globally configured attributes.";
        leaf enable {
          type boolean;
          default "false";
          description
            "Enable/disable DHCP globally.";
        }
        leaf ignore-hostname {
          type boolean;
          default "false";
          description
            "Enable/disable DHCP ignore hostname.";
        }
        leaf rate-limit-enable {
          type boolean;
          default "true";
          description
            "Enable/disable DHCP packets rate limit.";
        }
        leaf rate-limit {
          type uint32 {
            range "1..8000";
          }
          units "pps";
          default "800";
          description
            "DHCP packets rate limit value.";
        }
        leaf aging-time {
          type uint32 {
            range "1..1440";
          }
          units "min";
          default "30";
          description
            "DHCP session CAR aging time.";
        }
        leaf check-magic-cookie {
          type boolean;
          default "false";
          description
            "Enable/disable the function of checking the magic-cookie field in a DHCP packet and discarding a DHCP packet with an incorrect value in the magic-cookie field.";
        }
        leaf check-udp-checksum {
          type boolean;
          default "true";
          description
            "Enable/disable the function of checking the UDP header checksum in a DHCP packet and discarding a DHCP packet with an incorrect checksum.";
        }
        leaf udp-checksum {
          type boolean;
          default "false";
          description
            "Enable/disable a device to add the UDP header checksum to DHCP packets to be sent.";
        }
        leaf broadcast-suppress {
          type boolean;
          default "false";
          description
            "Enable/disable the DHCP broadcast suppression function.";
        }
        leaf graceful-degradation {
          type boolean;
          default "false";
          description
            "Enable/disable the DHCP graceful-degradation.";
        }
        leaf mlag-sync-enable {
          type boolean;
          default "false";
          description
            "Enable/disable DHCP M-LAG sync.";
        }
      }
      container session-car {
        must "pir-value >= cir-value and pbs-value >= cbs-value";
        description
          "Configure session CAR.";
        leaf enable {
          type boolean;
          default "true";
          description
            "Enable/disable session CAR.";
        }
        leaf cir-value {
          type uint32 {
            range "0..1000000";
          }
          units "kbit/s";
          default "512";
          description
            "Specify the session CAR CIR value.";
        }
        leaf cbs-value {
          type uint32 {
            range "0..9000000";
          }
          units "Byte";
          default "64000";
          description
            "Specify the session CAR CBS value.";
        }
        leaf pir-value {
          type uint32 {
            range "0..1000000";
          }
          units "kbit/s";
          default "1200";
          description
          "Specify the session CAR PIR value.";
        }
        leaf pbs-value {
          type uint32 {
            range "0..9000000";
          }
          units "Byte";
          default "150000";
          description
          "Specify the session CAR PBS value.";
        }
      }
      container chasten {
        description
          "Configure DHCP user connection throttling.";
        leaf enable {
          type boolean;
          default "false";
          description
            "Enable/disable DHCP user connection throttling.";
        }
        leaf request-packets {
          type uint32 {
            range "1..10000";
          }
          default "10";
          description
            "Request packets.";
        }
        leaf check-period {
          type uint32 {
            range "1..3600";
          }
          units "s";
          default "180";
          description
            "Check period.";
        }
        leaf restrain-period {
          type uint32 {
            range "1..3600";
          }
          units "s";
          default "300";
          description
            "Restrain period.";
        }
      }
      container ipsec-peers {
        description
          "List of DHCPv4 IPsecs.";
        list ipsec-peer {
          must "(peer-address = '0.0.0.0' and vpn-name = '_public_') or (peer-address != '0.0.0.0')";
          key "peer-address vpn-name";
          description
            "Configure DHCPv4 IPsec attributes.";
          leaf peer-address {
            type inet:ipv4-address-no-zone;
            description
              "Peer address.";
          }
          leaf vpn-name {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            must "/ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']";
            description
              "VPN name.";
          }
          leaf sa-name {
            type string {
              length "1..15";
            }
            mandatory true;
            description
              "SA name.";
          }
        }
      }
      container option82 {
        description
          "Configure DHCP option82 attributes.";
        container global-formats {
          description
            "List of DHCP Option82 formats globally.";
          list global-format {
            key "sub-option-type";
            description
              "Configure a DHCP Option82 global format.";
            leaf sub-option-type {
              type option82-sub-option-type;
              description
                "DHCP option82 global sub-option type.";
            }
            leaf option82-format {
              type option82-format;
              mandatory true;
              description
                "DHCP option82 sub-option format type.";
            }
            leaf user-defind-text {
              when "../option82-format='user-defined'";
              type string {
                length "0..255";
                pattern '([^\t]{0,})';
              }
              description
                "The format string of DHCP option82 defined by user.";
            }
          }
        }
        container global-vlan-formats {
          description
            "List of DHCP Option82 formats with VLAN globally.";
          list global-vlan-format {
            key "vlan-id cevlan-id sub-option-type";
            description
              "Configure a DHCP Option82 global format with VLAN.";
            leaf vlan-id {
              type uint16 {
                range "0..4094";
              }
              description
                "Indicate an outer VLAN ID. Value 0 Indicates no VLAN configuration.";
            }
            leaf cevlan-id {
              type uint16 {
                range "0..4094";
              }
              description
                "Indicates an inner VLAN ID. Value 0 Indicates no VLAN configuration.";
            }
            leaf sub-option-type {
              type option82-sub-option-type;
              description
                "DHCP option82 global sub-option type.";
            }
            leaf option82-format {
              type option82-format;
              mandatory true;
              description
                "DHCP option82 sub-option format type.";
            }
            leaf user-defind-text {
              when "../option82-format='user-defined'";
              type string {
                length "0..255";
                pattern '([^\t]{0,})';
              }
              description
                "The format string of DHCP option82 defined by user.";
            }
          }
        }
        container vendor-sub-options {
          description
            "List of DHCP option82 sub-option9 formats.";
          list vendor-sub-option {
            key "sub-option-index";
            description
              "Configure DHCP option82 sub-option9 format.";
            leaf sub-option-index {
              type uint32 {
                range "1..255";
              }
              description
                "DHCP option82 sub-option index.";
            }
            choice sub-option-format {
              mandatory true;
              description
                "The format of sub option.";
              case ascii-format {
                description
                  "ASCII string format.";
                leaf ascii-string {
                  type string {
                    length "1..128";
                  }
                  description
                    "ASCII string.";
                }
              }
              case hex-format {
                description
                  "Hex string format.";
                leaf hex-string {
                  type string {
                    length "1..256";
                  }
                  description
                    "Hex string.";
                }
              }
              case sysname-format {
                description
                  "Sysname format.";
                leaf sysname {
                  type option82-sysname-format;
                  description
                    "Sysname.";
                }
              }
              case ip-format {
                description
                  "IP format.";
                leaf-list ip-addresses {
                  type inet:ip-address-no-zone;
                  max-elements 8;
                  description
                    "Configure the IP address.";
                }
              }
            }
          }
        }
        container encapsulation {
          description
            "Configure suboptions inserted into the DHCP Option 82 field.";
          leaf suboption {
            type option82-encapsulation-sub-option;
            default "circuit-id remote-id subscriber-id vendor-specific-id";
            description
              "Configure suboptions inserted into the DHCP Option 82 field.";
          }
        }
        container subscriber-id {
          description
            "Configure the Sub6 suboption into the DHCP Option 82 field of DHCP messages and configures the format of the Sub6 suboption.";
          choice subscriber-id-format {
            description
              "The format of subscriber-id.";
            case ascii-format {
              description
                "The text of ascii.";
              leaf ascii-text {
                type string {
                  length "1..128";
                }
                description
                  "DHCP option82 ascii-type format.";
              }
            }
            case hex-format {
              description
                "The text of hex.";
              leaf hex-text {
                type string {
                  length "1..256";
                }
                description
                  "DHCP option82 hex-type format.";
              }
            }
          }
        }
      }
      container openflow {
        description
          "Configure DHCP openflow.";
        leaf openflow-enable {
          type boolean;
          default "false";
          description
            "Enable/disable DHCP packet copy to SDN controller.";
        }
      }
      container anti-attack-option {
        description
          "Configure the device to check and discard DHCP messages with duplicate options.";
        leaf enable {
          type boolean;
          default "false";
          description
            "Enable/disable the device to check and discard DHCP messages with duplicate options.";
        }
        container options {
          must "../enable='true'";
          description
            "List of the function to check and discard DHCP messages with duplicate options.";
          list option {
            key "option-start";
            max-elements 254;
            description
              "Configure the option value.";
            leaf option-start {
              type uint8 {
                range "1..254";
              }
              description
                "Specify the start value of an option in a DHCP packet.";
            }
            leaf option-end {
              type uint8 {
                range "1..254";
              }
              must "../option-start<=../option-end";
              description
                "Specify the end value of an option in a DHCP packet.";
            }
          }
        }
      }
      container global-packet-statistics {
        config false;
        description
          "Statistics of DHCP global packets.";
        leaf total-packets-receive {
          type uint32;
          units packet;
          description
            "Total received count of packets.";
        }
        leaf discarded-packets-receive {
          type uint32;
          units packet;
          description
            "Total discarded count of received packets.";
        }
        leaf bootp-request-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received bootp request packets.";
        }
        leaf bootp-reply-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received bootp reply packets.";
        }
        leaf discover-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received DHCP discover packets.";
        }
        leaf offer-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received DHCP offer packets.";
        }
        leaf request-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received DHCP request packets.";
        }
        leaf ack-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received DHCP ACK packets.";
        }
        leaf release-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received DHCP release packets.";
        }
        leaf nak-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received DHCP NAK packets.";
        }
        leaf decline-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received DHCP decline packets.";
        }
        leaf inform-packets-receive {
          type uint32;
          units packet;
          description
            "Count of received DHCP inform packets.";
        }
        leaf total-packets-send {
          type uint32;
          units packet;
          description
            "Total sent count of packets.";
        }
        leaf total-discarded-packets {
          type uint32;
          units packet;
          description
            "Total discarded count of sent packets.";
        }
        leaf memory-exhaust-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to memory exhausted.";
        }
        leaf rate-limit-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to rate limit.";
        }
        leaf bad-packet-length-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad packet length.";
        }
        leaf hops-exceed-length-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to hops exceeded.";
        }
        leaf bad-magic-cookie-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad magic cookie.";
        }
        leaf duplicate-option-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to duplicate option.";
        }
        leaf bad-option-length-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad option length.";
        }
        leaf bad-chaddr-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad chaddr.";
        }
        leaf bad-request-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad request.";
        }
        leaf bad-reply-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad reply.";
        }
        leaf unknown-type-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to unknown DHCP message.";
        }
        leaf bad-broadcast-flag-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad broadcast flag.";
        }
        leaf bad-mac-type-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad MAC type.";
        }
        leaf bad-mac-length-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad MAC length.";
        }
        leaf bad-source-mac-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad source MAC.";
        }
        leaf invalid-option82-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to invalid option82.";
        }
        leaf getting-info-failed-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to getting common info failed.";
        }
        leaf bad-info-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to bad common info.";
        }
        leaf other-error-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to other error.";
        }
        leaf unknown-message-type-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to unknown message type.";
        }
        leaf max-user-limit-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to max-user limit.";
        }
        leaf add-binding-table-failed-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to add binding table failed.";
        }
        leaf client-transfered-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to client transferred.";
        }
        leaf destination-port-equals-source-port-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to destination port equals source port.";
        }
        leaf lease-query-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to lease query.";
        }
        leaf same-mac-discarded-packets {
          type uint32;
          units packet;
          config false;
          description
            "Discarded count of packets due to the user with same MAC.";
        }
      }
    }
    container relay {
      description
        "Configure DHCP relay.";
      uses dhcp:dhcp-relay-type;
    }
    container server {
      description
        "Configure DHCP server.";
      uses dhcp:dhcp-server-type;
    }
    container snooping {
      description
        "Configure DHCP snooping.";
      uses dhcp:dhcp-snooping-type;
    }
    container client {
      description
        "Configure DHCP client.";
      uses dhcp:dhcp-client-type;
    }
  }
  rpc reset-address-state {
    ext:node-ref "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool";
    description
      "Reset address state.";
    input  {
      leaf pool-name {
        type leafref {
          path "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool/dhcp:ip-pool-name";
        }
        mandatory true;
        description
          "Pool name.";
      }
      leaf start-ip-address {
        type inet:ipv4-address-no-zone;
        mandatory true;
        description
          "Start IP address.";
      }
      leaf end-ip-address {
        type inet:ipv4-address-no-zone;
        description
          "End IP address.";
      }
      leaf reset-flag {
        type recycle-address-state;
        mandatory true;
        description
          "Address status.";
      }
    }
  }
  rpc reset-pool-maxusage {
    ext:node-ref "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool/dhcp:ip-pool-max-usage";
    description
      "Reset pool maxusage.";
    input  {
      leaf pool-name {
        type leafref {
          path "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool/dhcp:ip-pool-name";
        }
        description
          "Pool name.";
      }
    }
  }
  rpc start-force-renew {
    ext:node-ref "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool";
    description
      "Start force renew.";
    input {
      leaf pool-name {
        type leafref {
          path "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool/dhcp:ip-pool-name";
        }
        mandatory true;
        description
          "Pool name.";
      }
      leaf section-index {
        type leafref {
          path "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool/dhcp:sections/dhcp:section/dhcp:section-index";
        }
        mandatory true;
        description
          "The section index.";
      }
      leaf start-ip {
        type inet:ipv4-address-no-zone;
        description
          "The start IP address of the section.";
      }
      leaf end-ip {
        type inet:ipv4-address-no-zone;
        description
          "The end IP address of the section.";
      }
      leaf recycle-flag {
        type boolean;
        description
          "Indicates the address recycling flag.";
      }
    }
  }
  rpc stop-force-renew {
    ext:node-ref "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool";
    description
      "Stop force renew.";
    input {
      leaf pool-name {
        type leafref {
          path "/dhcp:dhcp/dhcp:server/dhcp:global-ip-pools/dhcp:global-ip-pool/dhcp:ip-pool-name";
        }
        mandatory true;
        description
          "Pool name.";
      }
    }
  }
  rpc reset-client-ip {
    ext:node-ref "/dhcp:dhcp/dhcp:client";
    description
      "The DHCP client releases the IP address.";
    input  {
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        description
          "Interface name.";
      }
    }
  }
  rpc set-if-dynamic-bind-table {
    ext:node-ref "/ifm:ifm/ifm:interfaces/ifm:interface/dhcp:dhcp-snooping-if";
    description
      "Set the dynamic binding table on an interface.";
    input  {
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        mandatory true;
        description
          "Interface name.";
      }
      leaf ip-address {
        type inet:ipv4-address-no-zone;
        mandatory true;
        description
          "IP address.";
      }
      leaf mac-address {
        type pub-type:mac-address;
        description
          "MAC address.";
      }
      leaf vlan-id {
        type uint16 {
          range "1..4094";
        }
        description
          "VLAN ID.";
      }
      leaf cevlan-id {
        type uint16 {
          range "1..4094";
        }
        description
          "CE VLAN ID.";
      }
      leaf lease-day {
        type uint16 {
          range "0..999";
        }
        units "d";
        default "7";
        description
          "The lease time day.";
      }
      leaf lease-hour {
        type uint16 {
          range "0..23";
        }
        units "h";
        default "0";
        description
          "The lease time hour.";
      }
      leaf lease-minute {
        type uint16 {
          range "0..59";
        }
        units "min";
        default "0";
        description
          "The lease time minute.";
      }
    }
  }
  rpc set-vlan-dynamic-bind-table {
    ext:node-ref "/vlan:vlan/vlan:vlans/vlan:vlan/dhcp:dhcp-snooping-vlan";
    description
      "Set the dynamic binding table in a VLAN.";
    input  {
      leaf vlan-id {
        type uint16 {
          range "1..4094";
        }
        mandatory true;
        description
          "VLAN ID.";
      }
      leaf ip-address {
        type inet:ipv4-address-no-zone;
        mandatory true;
        description
          "IP address.";
      }
      leaf mac-address {
        type pub-type:mac-address;
        description
          "MAC address.";
      }
      leaf if-name {
        type leafref {
          path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
        }
        mandatory true;
        description
          "Interface name.";
      }
      leaf cevlan-id {
        type uint16 {
          range "1..4094";
        }
        description
          "CE VLAN ID.";
      }
      leaf lease-day {
        type uint16 {
          range "0..999";
        }
        units "d";
        default "7";
        description
          "The lease time day.";
      }
      leaf lease-hour {
        type uint16 {
          range "0..23";
        }
        units "h";
        default "0";
        description
          "The lease time hour.";
      }
      leaf lease-minute {
        type uint16 {
          range "0..59";
        }
        units "min";
        default "0";
        description
          "The lease time minute.";
      }
    }
  }
