        leaf ap-sn {
          type string {
            length "1..31";
          }
          config false;
          description
            "The AP SN.";
        }

        leaf state {
          type enumeration {
            enum "idle" {
              value 0;
              description
                "The state is idle.";
            }
            enum "normal" {
              value 1;
              description
                "The state is normal.";
            }
            enum "backup" {
              value 2;
              description
                "The state is backup.";
            }
            enum "fault" {
              value 3;
              description
                "The state is fault.";
            }
          }
          description
            "Tunnel AP mode.";
        }
        description
          "Statistics of register-tunnel-aps.";
      }
    }
