    container port-statistics {
      config false;
      description
        "List of port-statistics.";
      list port-statistic {

        key "ap-id port-index";
        leaf ap-id {
          type uint32;
          config false;
          description
            "APID.";
        }
        leaf port-index {
          type uint16;
          config false;
          description
            "Port-index.";
        }
        leaf port-type {
          type enumeration {
            enum fe {
              value 1;
              description
                "FE.";
            }
            enum ge {
              value 2;
              description
                "GE.";
            }
            enum gpon {
              value 3;
              description
                "Gpon.";
            }
            enum epon {
              value 4;
              description
                "Epon.";
            }
            enum adsl2plus {
              value 5;
              description
                "Adsl2plus.";
            }
            enum trunk {
              value 6;
              description
                "Trunk.";
            }
            enum multige {
              value 7;
              description
                "Multige.";
            }
            enum xge {
              value 8;
              description
                "Xge.";
            }
          }
          config false;
          description
            "Port-type.";
        }

        leaf port-mode {
          type enumeration {
            enum root {
              value 1;
              description
                "Root.";
            }
            enum endpoint {
              value 2;
              description
                "Endpoint.";
            }
            enum middle {
              value 3;
              description
                "Middle.";
            }
            enum null {
              value 4;
              description
                "Null.";
            }
          }
          config false;
          description
            "Port-mode.";
        }

        leaf port-negot {
          type enumeration {
            enum auto {
              value 1;
              description
                "Auto.";
            }
            enum forced {
              value 2;
              description
                "Forced.";
            }
            enum unknown {
              value 3;
              description
                "Unknown.";
            }
          }
          config false;
          description
            "Port-negot.";
        }

        leaf port-duplex {
          type enumeration {
            enum half {
              value 1;
              description
                "Half.";
            }
            enum full {
              value 2;
              description
                "Full.";
            }
            enum unknown {
              value 3;
              description
                "Unknown.";
            }
          }
          config false;
          description
            "Port-duplex.";
        }
        leaf port-speed {
          type uint32;
          config false;
          description
            "Port-speed.";
        }
        leaf port-state {
          type enumeration {
            enum down {
              value 1;
              description
                "Down.";
            }
            enum up {
              value 2;
              description
                "Up.";
            }
            enum unknown {
              value 3;
              description
                "Unknown.";
            }
          }
          config false;
          description
            "Port-state.";
        }
        leaf port-auth-state {
          type enumeration {
            enum init {
              value 1;
              description
                "Initial.";
            }
            enum authenticating {
              value 2;
              description
                "Authenticating.";
            }
            enum success {
              value 3;
              description
                "Success.";
            }
            enum fail {
              value 4;
              description
                "Fail.";
            }
          }
          config false;
          description
            "Port dot1x authentication status.";
        }
        leaf port-macsec-state {
          type enumeration {
            enum idle {
              value 1;
              description
                "Idle.";
            }
            enum abnormal {
              value 2;
              description
                "Abnormal.";
            }
            enum initiated {
              value 3;
              description
                "Initiated.";
            }
            enum potential-peer-established {
              value 4;
              description
                "Potential peer established.";
            }
            enum sak-ready {
              value 5;
              description
                "Sak ready.";
            }
            enum sak-expected {
              value 6;
              description
                "Sak expected.";
            }
            enum succeeded {
              value 7;
              description
                "Succeeded.";
            }
          }
          config false;
          description
            "Port MACsec MKA session status.";
        }
        description
          "Statistics of port.";
      }
    }
    container replace-ap {
      description
        "Configure replace AP.";
      leaf ap-id {
        type uint32;
        description
          "The AP ID.";
      }
      leaf new-ap-mac {
        type pub-type:mac-address;
        description
          "New AP-MAC.";
      }
      leaf replace-flag {
        type boolean;
        description
          "Enable/disable replace.";
      }
    }
    container uplink-port {
      presence
        "Configure Uplink port for leader ap.";
      description
        "Configure uplink port for leader ap.";
      leaf port-type {
        type enumeration {
          enum "ge" {
            value 0;
            description
              "Specify GE port.";
          }
          enum "multige" {
            value 1;
            description
              "Specify MultiGE port.";
          }
          enum "xge" {
            value 2;
            description
              "Specify 10GE port.";
          }
        }
        mandatory true;
        description
          "Specify the port type of the uplink port.";
      }
      leaf port-index {
        type uint8 {
          range 0..27;
        }
        mandatory true;
        description
          "Specify the port index of the uplink port.";
      }
      leaf vlan-replace {
        type boolean;
        default "false";
        description
          "Enable/disable the VLAN replacement function of the uplink port.";
      }
    }

    leaf leader-ap-work-mode {
      type enumeration {
        enum "gateway" {
          value 0;
          description
            "Inner gateway mode.";
        }
        enum "bridge" {
          value 1;
          description
            "Bridge mode.";
        }
      }
      default "bridge";
      description
        "The LeaderAP work mode.";
    }
    container tunnel-aps {
      description
        "Configure of the tunnel-aps.";
      container tunnel-ap-groups {
        description
          "List of the tunnel-ap-groups.";
        list tunnel-ap-group {
          ext:generated-by system {
            ext:filter "profile-name='default'";
            description
              "The default profile is generated by system.";
          }
          ext:operation-exclude "delete" {
            ext:filter "profile-name='default'";
            description
              "The default profile cannot be deleted.";
          }
          key "profile-name";
          description
            "Configure of the tunnel-ap-group.";
          leaf profile-name {
            type string {
              length "1..35";
              pattern
                '[^\s?]+';
              pattern
                '[!-~]+';
            }
            description
              "Tunnel-ap-group profile-name.";
          }
          choice tunnel-dtls-type {
            default "cert";
            description
              "Choice tunnel device DTLS type.";
            case disable {
              description
                "Case DTLS disable.";
              leaf dtls-disable {
                type empty;
                description
                  "Tunnel device DTLS disable.";
              }
            }
            case psk {
              description
                "Case DTLS psk.";
              leaf dtls-psk {
                type pub-type:password-extend {
                  length "8..148";
                }
                description
                  "Tunnel device DTLS psk.";
              }
            }
            case cert {
              description
                "Case DTLS cert.";
              leaf dtls-pki-realm {
                type leafref {
                  path "/pki:pki/pki:domains/pki:domain/pki:name";
                }
                default "default";
                description
                  "Tunnel device DTLS cert pki-realm.";
              }
            }
          }
        }
      }
      container tunnel-ap-instances {
        description
          "List of the tunnel-ap-instances.";
        list tunnel-ap-instance {
          key "ap-id";
          unique "ap-sn";
          leaf ap-id {
            type uint32;
            description
              "The AP ID.";
          }
          leaf tunnel-ap-group {
            type leafref {
              path "../../../tunnel-ap-groups/tunnel-ap-group/profile-name";
            }
            default "default";
            description
              "Tunnel ap group.";
          }
          leaf ap-sn {
            ext:case-sensitivity "lower2upper";
            type string {
              length "1..31";
              pattern
                '[0-9a-zA-Z]+';
            }
            mandatory true;
            description
              "The AP SN.";
          }
          description
            "Configure of the tunnel-ap-instance.";
        }
      }
      leaf user-isolate {
        type enumeration {
          enum "disable" {
            value 0;
            description
              "Disable.";
          }
          enum "l2" {
            value 1;
            description
              "Layer 2 isolate.";
          }
        }
        default "l2";
        description
          "Config user-isolate.";
      }
    }
    leaf spectrum-analysis-source {
      type inet:ip-address;
      description
        "Configure the source IP address for the AC to send packets to the spectrum server.
         By default, the IP address of the outbound interface of a route is used as the source IP address.";
    }
    container ac-protect {
      leaf enable {
        type boolean;
        default "false";
        description
          "Enable/disable the AC protect.";
      }
      leaf alarm-restrain {
        type boolean;
        default "false";
        description
          "Enable/disable the AC protect alarm restrain.";
      }
      leaf cold-backup-kickoff-station {
        type boolean;
        default "false";
        description
          "Enable/disable the AC protect cold backup kickoff station.";
      }
      leaf restore {
        type boolean;
        default "true";
        description
          "Enable/disable the AC protect restore.";
      }
      leaf fast-switch {
        type boolean;
        default "false";
        description
          "Enable/disable the AC fast switch.";
      }
      description
        "Configure the AC protect.";
    }
  }
  rpc reset-ap {
    description
      "Reset AP operation.";
    input  {
      choice reset-info {
        description
          "Reset info, choose one from AP-MAC and AP-ID and AP-GROUP and AP type.";
        case ap-mac-info {
          description
            "AP-MAC.";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "AP-MAC.";
          }
        }
        case ap-id-info {
          description
            "The AP ID.";
          leaf ap-id {
            type uint32;
            description
              "The AP ID.";
          }
        }
        case ap-group-info {
          description
            "The AP Group.";
          leaf ap-group {
            type string {
              length "1..35";
            }
            description
              "The AP Group.";
          }
        }
        case ap-type-info {
          description
            "The AP-TYPE.";
          leaf ap-type {
            type string {
              length "1..31";
            }
            description
              "The AP-TYPE.";
          }
        }
        case wait-rtu-validate {
          description
            "Wait rtu validate.";
          leaf wait-rtu-validate {
            type empty;
            description
              "Wait rtu validate.";
          }
        }
      }
    }
    output  {
      container result-info {
        description
          "The ap-result output.";
        leaf result {
          type string {
            length "1..300";
          }
          description
            "The ap-result output.";
        }
      }
    }
  }
  rpc reset-ap-with-factory-configuration {
    description
      "Reset AP with factory configuration operation.";
    input  {
      choice reset-info {
        mandatory true;
        description
          "Reset info, choose one from AP-MAC and AP-ID.";
        case ap-mac-info {
          description
            "AP-MAC.";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "AP-MAC.";
          }
        }
        case ap-id-info {
          description
            "The AP ID.";
          leaf ap-id {
            type uint32;
            description
              "The AP ID.";
          }
        }
      }
    }
    output  {
      container result-info {
        description
          "The ap-result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "The ap-result output.";
        }
      }
    }
  }
  rpc led-blink-time {
    description
      "Set the AP led blinking function.";
    input  {
      leaf oper-type {
        type enumeration {
          enum "blink" {
            value 0;
            description
              "Blink AP.";
          }
          enum "cancel" {
            value 1;
            description
              "Cancel blink AP.";
          }
        }
        mandatory true;
        description
          "Config blink oper-type.";
      }
      leaf time {
        when "../oper-type = 'blink'";
        type uint32 {
          range "1..86400";
        }
        mandatory true;
        description
          "Config led blink time.";
      }
      choice ap-info {
        mandatory true;
        description
          "The AP info.";
        case ap-id {
          description
            "The AP ID.";
          leaf ap-id {
            type uint32;
            description
              "The AP ID.";
          }
        }
        case ap-mac {
          description
            "The AP MAC.";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "The AP MAC.";
          }
        }
        case all {
          description
            "Blink all ap.";
          leaf ap-all {
            when "../oper-type = 'cancel'";
            type empty;
            description
              "Blink all ap.";
          }
        }
      }
    }
    output  {
      leaf result {
        type string {
          length "1..100";
        }
        description
          "The result output.";
      }
    }
  }

  rpc ap-provision-commit {
    description
      "Commit ap provision config.";
    input  {
      choice commit-type {
        case ap-id-type {
          leaf ap-id {
            type uint32;
            description
              "Commit specific ap.";
          }
          description
            "Commit specific ap.";
        }
        case ap-group-type {
          leaf ap-group {
            type string {
              length "1..35";
            }
            description
              "Commit aps which are in the specific ap-group.";
          }
          description
            "Commit aps which are in the specific ap-group.";
        }
        case all-type {
          leaf all {
            type empty;
            description
              "Commit all aps.";
          }
          description
            "Commit all aps.";
        }
        description
          "Config commit-type.";
      }
    }
    output  {
      container result-info {
        description
          "The ap commit result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "The ap commit result output.";
        }
      }
    }
  }
  rpc ap-license-notify {
    description
      "Controller notify AC the license information.";
    input  {
      container license-infos {
        list license-info {
          key "license-type";
          leaf license-type {
            type enumeration {
              enum "indoor-ap" {
                value 0;
                description
                  "License type is indoor-ap.";
              }
              enum "outdoor-ap" {
                value 1;
                description
                  "License type is outdoor-ap.";
              }
              enum "indoor-ap-s" {
                value 2;
                description
                  "License type is indoor-ap-s.";
              }
              enum "outdoor-ap-s" {
                value 3;
                description
                  "License type is outdoor-ap-s.";
              }
              enum "indoor-ap-ec" {
                value 4;
                description
                  "License type is indoor-ap-ec.";
              }
              enum "outdoor-ap-ec" {
                value 5;
                description
                  "License type is outdoor-ap-ec.";
              }
              enum "common" {
                value 6;
                description
                  "License type is common.";
              }
              enum "wifi6-indoor-ap" {
                value 7;
                description
                  "License type is wifi6-indoor-ap.";
              }
              enum "wifi6-outdoor-ap" {
                value 8;
                description
                  "License type is wifi6-outdoor-ap.";
              }
              enum "agile-distribute-ap" {
                value 9;
                description
                  "License type is agile-distribute-ap.";
              }
              enum "wifi7-ap" {
                value 10;
                description
                  "License type is wifi7-ap.";
              }
              enum "security" {
                value 11;
                description
                  "License type is security.";
              }
            }
            description
              "Config license info of WLAN AC device, controlling AP access and wireless services.";
          }
          leaf expire-time {
            type yang:date-and-time;
            mandatory true;
            description
              "Config expire-time YYYY/MM/DD HH:MM:SS.";
          }

          description
            "List of AC the license information.";
        }
        description
          "List of AC the license information.";
      }
    }
  }
  rpc notify-ap-report-lldp-data {
    description
      "Controller notify fit central-ap full report lldp info.";
    input  {
      container ap-instances {
        description
          "List of ap-instance.";
        list ap-instance {
          key "ap-sn";
          description
            "Notify specific ap-list to report lldp info.";
          leaf ap-sn {
            type string {
              length "1..31";
            }
            description
              "Notify specific ap to report lldp info.";
          }
        }
      }
    }
  }

  rpc notify-ap-report-state {
    description
      "Controller notify ac to report ap state info.";
    input  {
      choice type {
        description
          "Controller notify ac to report ap state info.";
        case all-ap {
          description
            "All-AP info.";
          leaf all-ap {
            type empty;
            description
              "All-ap.";
          }
        }
        case ap-id-info {
          description
            "Specific AP.";
          container ap-instances {
            description
              "List of ap-instance.";
            list ap-instance {
              key "ap-id";
              description
                "Notify specific ap-list to report state info.";
              leaf ap-id {
                type uint32;
                description
                  "Notify specific ap to report state info.";
              }
            }
          }
        }
      }
    }
  }

  rpc register-tunnel-apstatus-ack {
    description
      "Controller response remote tunnel ap register information.";
    input  {
      container ap-instances {
        description
          "List of ap-instance.";
        list ap-instance {
          key "ap-sn";
          description
            "Query the registration status of the AP.";
          leaf ap-sn {
            type string {
              length "1..31";
            }
            description
              "AP SN.";
          }
          leaf ap-id {
            type uint32;
            description
              "The tunnel ap ID.";
          }
        }
      }
    }
  }
  rpc register-status-ack {
    description
      "Controller response remote ap register information.";
    input  {
      container ap-instances {
        description
          "List of ap-instance.";
        list ap-instance {
          key "ap-sn";
          description
            "Query the registration status of the AP.";
          leaf ap-sn {
            type string {
              length "1..31";
            }
            description
              "AP SN.";
          }
          leaf register-result {
            type boolean;
            description
              "True means succeed else means failed.";
          }
          leaf register-fail-reason {
            when "../register-result = 'false'";
            type uint32;
            description
              "AP register fail reason.";
          }
          leaf status {
            type string {
              length "1..32";
            }
            description
              "AP register status.";
          }
        }
      }
    }
  }
  rpc get-ap-connect-fail-reason {
    description
      "Controller get ap connect fail reason.";
    input  {
      container ap-instances {
        description
          "List of ap-instance.";
        list ap-instance {
          key "ap-mac";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "The AP mac.";
          }
          description
            "Config of ap-instance.";
        }
      }
    }
    output  {
      container reason-lists {
        list reason-list {
          key "time";
          description
            "List of the AP connected failed reasons.";
          leaf time {
            type yang:date-and-time;
            description
              "When the ap connect failed.";
          }
          leaf reason {
            type string {
              length "1..256";
            }
            description
              "The reason of ap connected failed.";
          }
          leaf mac {
            type pub-type:mac-address;
            description
              "The AP mac.";
          }
        }
        description
          "List of the history of AP connected failed.";
      }
    }
  }
  rpc reset-ap-connect-fail-reason {
    description
      "Reset ap connect fail reason.";
    input  {
      leaf ap-mac {
        type pub-type:mac-address;
        description
          "The AP mac.";
      }
    }
  }

  rpc set-auth-svr-down-vap {
    description
      "Active or inactive auth-server-down vap.";
    input {
      leaf oper-type {
        type enumeration {
          enum "active" {
            value 0;
            description
              "Active.";
          }
          enum "inactive" {
            value 1;
            description
              "Inactive.";
          }
        }
        mandatory true;
        description
          "Active or inactive auth server down vap.";
      }
      leaf vap-profile {
        type string {
          length "1..35";
        }
        description
          "Configure vap-profile.";
      }
    }

    output  {
      container result-info {
        description
          "The result of setting auth-server-down vap.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "The result output.";
        }
      }
    }
  }

  rpc ap-ping {
    description
      "Ping a network device from a specified AP.";
    input {
      leaf ap-id {
        type uint32;
        mandatory true;
        description
          "The AP ID used to ping other network devices.";
      }
      leaf host {
        type string {
          length "1..20";
        }
        mandatory true;
        description
          "The domain name or IP address of the destination host.";
      }
      leaf packet-count {
        type uint32 {
          range "1..10";
        }
        default 4;
        description
          "The number of ICMP Echo Request packets to be sent.";
      }
      leaf packet-size {
        type uint32 {
          range "20..8100";
        }
        default 56;
        description
          "The length of an Echo Request packet excluding the IP header and ICMP header.";
      }
      leaf interval {
        type uint32 {
          range "1..5000";
        }
        units "ms";
        default "2000";
        description
          "The time to wait before sending the next ICMP Request packet.";
      }
      leaf timeout {
        type uint32 {
          range "0..10000";
        }
        units "ms";
        default "2000";
        description
          "The time to wait before sending the next ICMP Request packet.";
      }
    }
    output  {
      container result-info {
        description
          "The ap-ping output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "The ap-ping output.";
        }
      }
    }
  }
  rpc get-ap-ping-result {
    description
      "Get ap ping result.";
    output {
      container result-info {
        description
          "The ap-ping result output.";
        leaf status {
          type enumeration {
            enum "idle" {
              value 0;
              description
                "AP ping is not started.";
            }
            enum "ongoing" {
              value 1;
              description
                "The AP ping operation is in progress.";
            }
            enum "finished" {
              value 2;
              description
                "The AP ping operation is complete.";
            }
            enum "timeout" {
              value 3;
              description
                "The AP ping operation is timeout.";
            }
          }
          description
            "The status of the AP ping operation.";
        }
        leaf ap-id {
          type uint32;
          description
            "The AP ID used to ping other network devices.";
        }
        leaf host {
          type string {
            length "1..20";
          }
          description
            "The domain name or IP address of the destination host.";
        }
        leaf success-packet-count {
          type uint32;
          description
            "Number of successful ping packets.";
        }
        leaf fail-packet-count {
          type uint32;
          description
            "Number of failed ping packets.";
        }
        leaf average-response-time {
          type uint32;
          units "ms";
          description
            "Average response time.";
        }
        leaf min-response-time {
          type uint32;
          units "ms";
          description
            "Minimum response time.";
        }
        leaf max-response-time {
          type uint32;
          units "ms";
          description
            "Maximum response time.";
        }
      }
    }
  }
  rpc ap-diagnostic-information {
    description
      "Collects AP diagnostic information.";
    input {
      leaf ap-id {
        type uint32;
        mandatory true;
        description
          "Specifies an AP ID.";
      }
    }
    output {
      leaf result {
        type string {
          length "1..100";
        }
        description
          "Displays the collection result.";
      }
    }
  }
  rpc ap-public-key {
    description
      "Collects AP public key.";
    input {
      leaf ap-id {
        type uint32;
        mandatory true;
        description
          "Specifies an AP ID.";
      }
    }
    output {
      leaf name {
        type string {
          length "1..127";
        }
        description
          "Displays the collection result.";
      }
    }
  }
  rpc ap-container-information {
    description
      "Collects AP container information.";
    input {
      leaf ap-id {
        type uint32;
        mandatory true;
        description
          "Specifies an AP ID.";
      }
    }
    output {
      container container-infos {
        list container-info {
          key "name";
          leaf name {
            type string {
              length "1..255";
            }
            description
              "Container name.";
          }
          leaf type {
            type string {
              length "1..255";
            }
            description
              "Container type.";
          }

          leaf version {
            type string {
              length "1..255";
            }
            description
              "Container version.";
          }

          leaf vendor-name {
            type string {
              length "1..255";
            }
            description
              "Container vendor name.";
          }
          leaf status {
            type string {
              length "1..255";
            }
            description
              "Container status.";
          }

          leaf cpu-usage {
            type string {
              length "1..255";
            }
            description
              "Container cpu usage.";
          }
          leaf max-mem {
            type string {
              length "1..255";
            }
            description
              "Container max memory.";
          }
          leaf used-mem {
            type string {
              length "1..255";
            }
            description
              "Container used memory.";
          }
          leaf mem-usage {
            type string {
              length "1..255";
            }
            description
              "Container memory usage.";
          }
          leaf mem-usage-of-host {
            type string {
              length "1..255";
            }
            description
              "Container memory usage of host.";
          }
          leaf disk-size {
            type string {
              length "1..255";
            }
            description
              "Container disk size.";
          }
          leaf disk-usage {
            type string {
              length "1..255";
            }
            description
              "Container disk usage.";
          }
          leaf app-status {
            type string {
              length "1..255";
            }
            description
              "Container app state.";
          }
          leaf start-time {
            type string {
              length "1..255";
            }
            description
              "Container start time.";
          }
          leaf last-start-time {
            type string {
              length "1..255";
            }
            description
              "Container last start time.";
          }
          leaf architecture {
            type string {
              length "1..31";
            }
            description
              "System architecture of the image software package.";
          }
          container device-lists {
            list device-list {
              key "device-index";
              leaf device-index {
                type string {
                  length "1..255";
                }
                description
                  "Device index.";
              }
              leaf device-name {
                type string {
                  length "1..255";
                }
                description
                  "Device name.";
              }
              description
                "Device list.";
            }
            description
              "List of device.";
          }
          description
            "Container information.";
        }
        description
          "List of Container information.";
      }
    }
  }
  rpc ap-module {
    description
      "Collects AP module.";
    input {
      leaf ap-id {
        type uint32;
        mandatory true;
        description
          "Specifies an AP ID.";
      }
    }
    output {
      leaf module-name {
        type string {
          length "1..255";
        }
        description
          "Displays the ap module name.";
      }
    }
  }
  rpc set-remote-ap-mode {
    description
      "Set the remote AP mode.";
    input  {
      container ap-instances {
        description
          "List of AP instances.";
        list ap-instance {
          key "ap-mac";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "AP MAC address.";
          }
          leaf ap-mode {
            type enumeration {
              enum "fit" {
                value 0;
                description
                  "Set the remote AP mode to Fit.";
              }
            }
            description
              "AP mode.";
          }
          description
            "Configure the AP instance.";
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }
  rpc set-ap-power-save-mode {
    description
      "Set AP power save mode.";
    input  {
      container ap-instances {
        description
          "List of AP instances.";
        list ap-instance {
          key "ap-mac";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "AP MAC address.";
          }
          leaf ap-power-save-mode {
            type power-save-mode;
            description
              "AP power save workmode.";
          }
          leaf latest-wakeuptime {
            type yang:date-and-time;
            mandatory true;
            description
              "Config latest wakeuptime YYYY/MM/DD HH:MM:SS.";
          }
          description
            "Configure the AP instance.";
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }
  rpc set-psmap-para-collection {
    description
      "Set AP power save mode parameter collection flag.";
    input  {
      container ap-instances {
        description
          "List of AP instances.";
        list ap-instance {
          key "ap-mac";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "AP MAC address.";
          }
          leaf ap-green-para-flag {
            type enumeration {
              enum "turn-off" {
                value 0;
                description
                  "Set the remote AP not to report green para.";
              }
              enum "turn-on" {
                value 1;
                description
                  "Set the remote AP to report green para.";
              }
            }
            description
              "AP green para report flag.";
          }
          description
            "Configure the AP instance.";
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }

  rpc ap-psm-keepalive {
    description
      "AP power save mode keepalive msg.";
    input {
      container psm-keepalive {
        description
          "Keepalive msg.";
        leaf psm-keepalive-msg {
          type string {
            length "1..100";
          }
          description
            "Keepalive msg.";
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Keepalive reply.";
        }
      }
    }
  }
  rpc trigger-ftm {
    description
      "Trigger FTM Measurement.";
    input  {
      container ap-instances {
        description
          "List of AP instances.";
        list ap-instance {
          key "ap-id";
          leaf ap-id {
            type uint32;
            description
              "The AP ID.";
          }
          description
            "Configure the AP instance.";
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }
  rpc set-gnss {
    description
      "Set Location Infomation.";
    input  {
      container ap-instances {
        description
          "List of AP instances.";
        list ap-instance {
          key "ap-id";
          leaf ap-id {
            type uint32;
            description
              "The AP ID.";
          }
          leaf longitude {
            type decimal64 {
              fraction-digits 10;
            }
            units "°";
            description
              "Longitude.";
          }
          leaf latitude {
            type decimal64 {
              fraction-digits 10;
            }
            units "°";
            description
              "Latitude.";
          }
          leaf altitude {
            type decimal64 {
              fraction-digits 10;
            }
            units "m";
            description
              "Altitude.";
          }
          leaf altitude-type {
            type int8;
            description
              "Altitude type.";
          }
          leaf floor-id {
            type int16;
            description
              "Floor Id.";
          }
          leaf device-height {
            type decimal64 {
              fraction-digits 10;
            }
            units "m";
            description
              "Device Height.";
          }
          description
            "Configure the AP instance.";
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }
  rpc load-file {
    description
      "Load file to AP.";
    input  {
      choice type {
        description
          "Specifying a file load object.";
        case all-ap {
          description
            "Specified all APs.";
          leaf all-ap {
            type empty;
            description
              "All APs.";
          }
        }
        case ap-id {
          description
            "Specified AP ID.";
          leaf ap-id {
            type uint32;
            description
              "Specified AP ID.";
          }
        }
        case ap-group {
          description
            "Specified AP group.";
          leaf ap-group {
            type string {
              length "1..35";
            }
            description
              "Specified AP group name.";
          }
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }
  rpc set-camera-quick-detection {
    description
      "Enable the ap for quick camera detection.";
    input  {
      choice type {
        description
          "Specifying camera quickly detects object.";
        case all-ap {
          description
            "Specified all APs.";
          leaf all-ap {
            type empty;
            description
              "All APs.";
          }
        }
        case ap-id {
          description
            "Specified AP ID.";
          leaf ap-id {
            type uint32;
            description
              "Specified AP ID.";
          }
        }
        case ap-group {
          description
            "Specified AP group.";
          leaf ap-group {
            type string {
              length "1..35";
            }
            description
              "Specified AP group name.";
          }
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }
  rpc update-au-status {
    description
      "Trigger update au status.";
    input  {
      container ap-instances {
        description
          "List of ap-instance.";
        list ap-instance {
          key "ap-mac";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "The AP mac.";
          }
          description
            "Config of ap-instance.";
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }

  rpc get-ap-ftm-distance {
    description
      "Controller get ap ftm distance.";
    input  {
      container ap-instances {
        description
          "List of ap-instance.";
        list ap-instance {
          key "ap-mac";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "The AP mac.";
          }
          description
            "Config of ap-instance.";
        }
      }
    }
    output {
      container ftm-infos {
        list ftm-info {
          key "ap-mac";
          description
            "List of the AP connected failed reasons.";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "The ap terminal mac.";
          }
          leaf terminal-mac {
            type pub-type:mac-address;
            description
              "The terminal mac.";
          }
          leaf distance {
            type decimal64 {
              fraction-digits 5;
            }
            units "m";
            description "The distance between AP and terminal.";
          }
        }
        description
          "List of the distance between AP and terminal.";
      }
    }
  }
  rpc get-ap-radio-binging-profile-name {
    description
      "Get profile name for ap radio binding.";
    input  {
      container ap-instances {
        description
          "List of ap-instance.";
        list ap-instance {
          key "ap-mac";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "The AP mac.";
          }
          leaf radio-id {
            type uint32;
            description
              "Specified AP ID.";
          }
          leaf profile-type {
            type enumeration {
              enum "rrm-profile" {
                value 0;
                description
                  "Rrm-profile type.";
              }
            }
            description
              "Specified profile type.";
          }
          description
            "Config of ap-instance.";
        }
      }
    }
    output {
      container profile-infos {
        list profile-info {
          key "ap-mac";
          description
            "List of the AP connected failed reasons.";
          leaf ap-mac {
            type pub-type:mac-address;
            description
              "The ap mac.";
          }
          leaf radio-id {
            type uint32;
            description
              "Specified AP ID.";
          }
          leaf profile-name {
            type string {
              length "1..35";
            }
            description
              "Profile name.";
          }
        }
        description
          "List of the profile information.";
      }
    }
  }
  rpc container-cpu {
    description
      "Set container cpu resource.";
    input  {
      choice type {
        description
          "Specifying container cpu resource.";
        case set-cpu-num {
          description "Set CPU num.";
          leaf set-cpu-num {
            type uint32 {
              range "0 | 10";
            }
            description
              "Set CPU num.";
            }
        }
        case show-cpu-num {
          description "Show CPU num.";
          leaf show-cpu-num {
            type empty;
            description "Show CPU num.";
          }
        }
      }
    }
    output  {
      container result-info {
        description
          "Result output.";
        leaf result {
          type string {
            length "1..100";
          }
          description
            "Result output.";
        }
      }
    }
  }
  ext:task-name "pcm";
}
