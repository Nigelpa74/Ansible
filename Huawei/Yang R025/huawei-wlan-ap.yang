module huawei-wlan-ap {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-wlan-ap";
  prefix hw-wlan-ap;
  import ietf-inet-types {
    prefix inet;
  }
  import huawei-pub-type {
    prefix pub-type;
  }
  import huawei-extension {
    prefix ext;
  }
  import ietf-yang-types {
    prefix yang;
  }
  import huawei-pki {
    prefix pki;
  }
