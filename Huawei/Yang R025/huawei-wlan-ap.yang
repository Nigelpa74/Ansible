        }
        leaf ap-mac {
          type pub-type:mac-address;
          config false;
          description
            "Configure the AP MAC.";
        }
        leaf ap-type {
          type string {
            length "1..31";
          }
          config false;
          description
            "Configure the ap-type.";
        }
        leaf site-code {
          type string {
            length "1..16";
          }
          config false;
          description
            "Configure the site-code.";
        }
      }
    }

    container register-aps {
      config false;
      description
        "List of register-aps.";
      list register-ap {
        key "ap-id";

        leaf ap-id {
          type uint32;
          config false;
          description
            "The AP ID.";
        }
        leaf ap-mac {
          type pub-type:mac-address;
          config false;
          description
            "The AP MAC.";
        }
        leaf ap-sn {
          type string {
            length "1..31";
          }
          config false;
          description
            "The AP SN.";
        }
        leaf ap-type {
          type string {
            length "1..31";
          }
          config false;
          description
            "The ap-type.";
        }
        leaf ap-name {
          type string {
            length "1..63";
          }
          config false;
          description
            "The AP name.";
        }
        leaf site-code {
          type string {
            length "1..16";
          }
          config false;
          description
            "Configure the site-code.";
        }
        uses hw-wlan-ap:ap-run-info;
        leaf security-switch {
          type boolean;
          config false;
          description
            "The security license switch.";
        }
        leaf pair-ap-mac {
          type pub-type:mac-address;
          config false;
          description
            "The Other Distribute AP MAC.";
        }
