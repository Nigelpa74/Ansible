  typedef switch-type {
    type enumeration {
      enum "enable" {
        value 0;
        description
          "Enable.";
      }
      enum "disable" {
        value 1;
        description
          "Disable.";
      }
    }
    description
      "Enable or disable.";
  }

  typedef power-save-mode {
    type enumeration {
      enum "normal" {
        value 0;
        description
          "Normal energy mode.";
      }
      enum "sleep" {
        value 1;
        description
          "Sleep energy mode.";
      }
      enum "idle" {
        value 2;
        description
          "Idle energy mode.";
      }
    }
    description
      "Power save mode.";
  }

  grouping ap-run-info {
    description
      "AP run info.";
    leaf ip-address {
      type inet:ip-address;
      config false;
      description
        "AP ip address.";
    }
    leaf vendor {
      type string {
        length "1..63";
      }
      config false;
      description
        "The ap-vendor.";
    }
    leaf version {
      type string {
        length "1..63";
      }
      config false;
      description
        "The ap-file-version.";
    }
    leaf patch-version {
      type string {
        length "1..63";
      }
      config false;
      description
        "The ap-patch-version.";
    }
    leaf run-state {
      type enumeration {
        enum normal {
          value 1;
          description
            "Normal state.";
        }
        enum fault {
          value 2;
          description
            "Fault state.";
        }
        enum downloading {
          value 3;
          description
            "Downloading state.";
        }
        enum version-mismatch {
          value 4;
          description
            "Version-mismatch state.";
        }
        enum standby {
          value 5;
          description
            "Standby state.";
        }
        enum countrycode-mismatch {
          value 6;
          description
            "Countrycode-mismatch state.";
        }
        enum type-mismatch {
          value 7;
          description
            "Type-mismatch state.";
        }
        enum idle {
          value 8;
          description
            "Idle state.";
        }
      }
      config false;
      description
        "The ap's running state.";
    }
    leaf ap-group {
      type string {
        length "1..35";
      }
      config false;
      description
        "The AP Group.";
    }
    leaf central-ap-id {
      type uint32;
      config false;
      description
        "The Central AP ID.";
    }
    leaf central-ap-mac {
      type pub-type:mac-address;
      config false;
      description
        "The Central AP MAC.";
    }
    leaf central-ap-name {
      type string {
        length "1..63";
      }
      config false;
      description
        "The Central AP name.";
    }
  }

  grouping ap-provision {
    description
      "Configure ap provision para.";
    container ap-provision {
      description
        "Configure ap provision para.";
      leaf address-mode {
        type enumeration {
          enum "dhcp" {
            value 0;
            description
              "DHCP mode.";
          }
          enum "static" {
            value 1;
            description
              "Static mode.";
          }
          enum "slaac" {
            value 2;
            description
              "SLAAC mode.";
          }
        }
        description
          "Set AP ip address mode.";
      }
      container ip-address-info {
        presence
          "Configure AP address and AC list.";
        description
          "Configure AP address and AC list.";
        choice address-type {
          description
            "Configure AP address.";
          case ipv4 {
            container ap-ip-address {
              when "../../address-mode = 'static'";
              leaf ap-ip-address {
                type inet:ip-address;
                mandatory true;
                description
                  "Config AP ip address.";
              }
              leaf sub-net-mask {
                type uint8 {
                  range "0..32";
                }
                mandatory true;
                description
                  "Config AP ip sub net mask.";
              }
              leaf gate-way {
                type inet:ip-address;
                description
                  "Config gateway ip-address.";
              }
              description
                "Configure ap-address.";
            }
            container ap-ipv4-list {
              leaf ac-ipv4-list {
                type string {
                  length "1..128";
                }
                description
                  "List of AC IP addresses.";
              }
              description
                "Configure the list of AC IP addresses.";
            }
            description
              "Configure AP IPv4 address and AC list.";
          }
          case ipv6 {
            container ap-ipv6-address {
              when "../../address-mode = 'static'";
              leaf ap-ip-v6-address {
                type inet:ip-address;
                mandatory true;
                description
                  "Config AP IPv6 address.";
              }
              leaf prefix-length {
                type uint32 {
                  range "1..128";
                }
                mandatory true;
                description
                  "Config AP IPv6 prefix length.";
              }
              leaf gate-way {
                type inet:ip-address;
                description
                  "Config gateway ip-address.";
              }
              description
                "Configure AP IPv6 address.";
            }
            container ap-ipv6-list {
              leaf ac-ipv6-list {
                type string {
                  length "1..256";
                }
                description
                  "List of AC IPv6 addresses.";
              }
              description
                "Configure the list of AC IPv6 addresses.";
            }
            description
              "Configure AP IPv6 address and AC list.";
          }
        }
      }
      leaf management-vlan {
        type uint32 {
          range "1..4094";
        }
        description
          "Config management VLAN.";
      }
      leaf ap-mode {
        type enumeration {
          enum "fit" {
            value 0;
            description
              "Fit Mode.";
          }
          enum "fat" {
            value 1;
            description
              "Fat Mode.";
          }
          enum "cloud" {
            value 2;
            description
              "Cloud Mode.";
          }
        }
        description
          "Configure ap-mode.";
      }
      leaf server-auth-switch {
        type switch-type;
        description
          "Configure server-auth-switch.";
      }
      container server-auth-cn-lists {
        description
          "List of server-auth-cn.";
        list server-auth-cn-list {
          key "cn";
          max-elements 5;
          description
            "Configure server-auth-cn-list.";
          leaf cn {
            type string {
              length "1..64";
            }
            description
              "Configure server-auth-cn.";
          }
        }
      }
    }
  }

  container wlan-ap {
    description
      "The AP instances.";
    leaf ap-auth-mode {
      type enumeration {
        enum "mac" {
          value 0;
          description
            "Mac mode.";
        }
        enum "sn" {
          value 1;
          description
            "Sn mode.";
        }
        enum "no-auth" {
          value 2;
          description
            "No auth mode.";
        }
      }
      default "mac";
      description
        "The AP auth mode.";
    }
    container ap-mac-whitelists {
      description
        "List of AP mac whitelist.";
      list ap-mac-whitelist {
        key "ap-mac";
        description
          "Configure AP mac whitelist.";
        leaf ap-mac {
          type pub-type:mac-address;
          description
            "The AP mac whitelist.";
        }
      }
    }
    container ap-sn-whitelists {
      description
        "List of AP sn whitelist.";
      list ap-sn-whitelist {
        key "ap-sn";
        description
          "Configure AP sn whitelist.";
        leaf ap-sn {
          type string {
            length "1..31";
          }
          description
            "The AP sn whitelist.";
        }
      }
    }
    container ap-mac-blacklists {
      description
        "List of AP mac blacklist.";
      list ap-mac-blacklist {
        key "ap-mac";
        description
          "Configure AP mac blacklist.";
        leaf ap-mac {
          type pub-type:mac-address;
          description
            "The AP mac blacklist.";
        }
      }
    }
    container ap-types {
      description
        "List of AP type.";
      list ap-type {
        ext:generated-by "system" {
          description
            "The default ap-type is generated by system.";
          ext:filter "state='default'";
        }
        ext:operation-exclude "delete" {
          ext:filter "state='default'";
          description
            "The default ap-type cannot be deleted.";
        }

        key "type-name";
        unique "type-id";
        description
          "Configure AP type.";
        leaf type-name {
          type string {
            length "1..31";
          }
          description
            "The AP type description.";
        }
        leaf type-id {
          type uint32 {
            range "0..1023";
          }
          mandatory true;
          description
            "The AP type ID.";
        }
        leaf state {
          type enumeration {
            enum "default" {
              value 0;
              description
                "The default ap-type.";
            }
            enum "configured" {
              value 1;
              description
                "The configured ap-type.";
            }
          }
          config false;
          description
            "The ap-type state which can be configured or default.";
        }
      }
    }
    leaf temp-mgmt-psk {
      type pub-type:password-extend {
        length "8..188";
      }
      description
        "Temporary management psk.";
    }
    leaf ap-lldp {
      type boolean;
      default "true";
      description
        "Enable/disable AP LLDP function.";
    }
    container ap-instances {
      description
        "List of the AP instances.";
      list ap-instance {
        must "not(./ap-provision/ap-mode)";
        must "(./ap-mac) or (./ap-sn)";
        key "ap-id";
        unique "ap-mac";
        unique "ap-sn";
        description
          "Configure the AP instances.";
        leaf ap-id {
          type uint32;
          description
            "The AP ID.";
        }
        leaf ap-mac {
          type pub-type:mac-address;
          description
            "The AP MAC.";
        }
        leaf ap-sn {
          type string {
            length "1..31";
            pattern
              '[0-9a-zA-Z]+';
          }
          description
            "The AP SN.";
        }
        leaf ap-type {
          type leafref {
            path "/wlan-ap/ap-types/ap-type/type-name";
          }
          description
            "Config the ap-type.";
        }
        leaf ap-name {
          type string {
            length "1..63";
            pattern
              '[ \S]+';
            pattern
              '[^?]+';
            pattern
              '([^ ]|[^ ].*[^ ])';
          }
          description
            "The AP name.";
        }
        leaf location {
          type string {
            length "1..63";
          }
          description
            "Config ap location.";
        }
        leaf scene {
          type enumeration {
            enum "cross-room" {
              value 0;
              description
                "Cross room.";
            }
            enum "cross-room-cov" {
              value 1;
              description
                "Cross room cov.";
            }
          }
          description
            "Configure scene.";
        }
        leaf site-code {
          type string {
            length "14";
          }
          description
            "Configure site-code.";
        }
        leaf longitude {
          type decimal64 {
            fraction-digits 16;
          }
          description
            "Configure longitude.";
        }
        leaf latitude {
          type decimal64 {
            fraction-digits 16;
          }
          description
            "Configure latitude.";
        }
        leaf pair-ap-mac {
          type pub-type:mac-address;
          description
            "The other AP MAC of DAP.";
        }
        uses hw-wlan-ap:ap-provision;
        uses hw-wlan-ap:ap-run-info;
        leaf update-status {
          type enumeration {
            enum "none" {
              value 0;
              description
                "AP is not updating.";
            }
            enum "updating" {
              value 1;
              description
                "AP is updating.";
            }
            enum "update-fail" {
              value 2;
              description
                "AP update fail.";
            }
            enum "update-success" {
              value 3;
              description
                "AP update success.";
            }
          }
          config false;
          description
            "AP update status.";
        }
        container license-control {
          description
            "Configure license control switch.";
          leaf experience-switch {
            type boolean;
            default false;
            description
              "Enable/disable experience license switch.";
          }
          leaf security-switch {
            type boolean;
            default false;
            description
              "Enable/disable security license switch.";
          }
          leaf local-security-switch {
            type boolean;
            default false;
            description
              "Enable/disable local-security license switch.";
          }
          leaf url-filter-state {
            type enumeration {
              enum "off" {
                value 0;
                description
                  "Disable url filter category.";
              }
              enum "on" {
                value 1;
                description
                  "Enable url filter category.";
              }
              enum "limited" {
                value 2;
                description
                  "Remote query is not supported.";
              }
            }
            default "off";
            description
              "License status for url filter function.";
          }
        }
        leaf ap-zone {
          type string {
            length "1..35";
            pattern
              '[^\s?]+';
            pattern
              '([^"]|[^"].*[^"])';
          }
          default "default";
          description
            "Configure ap-zone name.";
        }
        container au-instances {
          description
            "List of AUs.";
          list au-instance {
            key "au-id";
            description
              "Configure the AU instances.";
            leaf au-id {
              type uint8 {
                range 0..7;
              }
              description
                "The AU ID.";
            }
            leaf name {
              type string {
                length "1..31";
                pattern
                  '[ \S]+';
                pattern
                  '[^?-]+';
                pattern
                  '([^ ]|[^ ].*[^ ])';
                pattern
                  '([^"]|[^"].*[^"])';
              }
              description
                "The name of AU.";
            }
            leaf switch {
              type boolean;
              default true;
              description
                "Enable/disable AU.";
            }
            leaf status {
              type enumeration {
                enum "absent" {
                  value 0;
                  description
                    "The AU is not in position.";
                }
                enum "normal" {
                  value 1;
                  description
                    "The AU is in position.";
                }
                enum "normaliot" {
                  value 2;
                  description
                    "The AU is in position and carries IoT.";
                }
                enum "unknown" {
                  value 3;
                  description
                    "Unknown state.";
                }
                enum "shutdown" {
                  value 4;
                  description
                    "The AU is shutdown.";
                }
              }
              default "absent";
              description
                "AU status.";
            }
          }
        }
        leaf asfn-id {
          type uint32 {
            range "0..255";
          }
          description
            "The ASFN ID.";
        }
        leaf altitude {
          type string {
            length "1..31";
            pattern
              '\d{1,22}(\.\d{1,8})?';
          }
          units "m";
          description
            "Configure altitude.";
        }
        leaf floor-id {
          type int32 {
            range "-32768..32767";
          }
          description
            "The floor ID.";
        }
        leaf floor-height {
          type string {
            length "1..31";
            pattern
              '\d{1,22}(\.\d{1,8})?';

          }
          units "m";
          description
            "The Floor height above the ground.";
        }
        container csi {
          description
            "Configure channel state information measurement.";
          leaf enable {
            type boolean;
            description
              "Enable/disable channel state information measurement.";
          }
          leaf sensitivity-level {
            type uint8 {
              range "0..100";
            }
            description "Configure distance sensitivity level of channel state information measurement.";
          }
          leaf action-sensitivity-level {
            type enumeration {
              enum "high" {
                value 0;
                description "Breathe detection is enabled.";
              }
              enum "low" {
                value 1;
                description "Breathe detection is disabled.";
              }
            }
            description "Configure action sensitivity level of channel state information measurement.";
          }
          container distance-range {
            presence "Configure csi detection distance.";
            description 
              "Configure csi detection distance.";
            leaf presence-enter-range {
              type uint8 {
                range "0..100";
              }
              units "10 cm";
              mandatory true;
              description "Configure the detection distance of the status changing from absence to presence.
                If the configured detection distance exceeds the maximum capability of an AP, the AP capability prevails.";
            }
            leaf presence-leave-range {
              type uint8 {
                range "0..100";
              }
              units "10 cm";
              mandatory true;
              description "Configure the detection distance of the status changing from presence to absence.
                If the configured detection distance exceeds the maximum capability of an AP, the AP capability prevails.";
            }
          }
          leaf motion-detection-threshold {
            type uint8 {
              range "0..100";
            }
            description "Configure motion amplitude detection threshold. If the detected value is less than the threshold, the motion is ignored. It can be used to eliminate misidentification caused by interference.";
          }
          leaf presence-aging-time {
            type uint16 {
              range "1..65535";
            }
            units "s";
            description "Configure the aging time after the lasttime that the person is detected. When breathe detection is enabled, the minimum aging time takes effect is 45s.";
          }
          leaf presence-re-enter-delay {
            type uint16 {
              range "0..600";
            }
            units "s";
            description "Configure the delay time of the status re-entering to presence after the status is aged to absence.";
          }
          leaf report-to-container-switch {
            type boolean;
            default "false";
            description "Enable/disable report csi result to container.";
          }
          container report-to-server {
            presence "Configure csi result report server information.";
            description 
              "Configure csi result report server information.";
            leaf server-ip {
              type inet:host;
              mandatory true;
              description "Configure csi server ip address or domain.";
            }
            leaf server-port {
              type uint16 {
                range "1..65535";
              }
              mandatory true;
              description "Configure csi server UDP port.";
            }
          }
        }
        leaf app-auto-downgrade-switch {
            type boolean;
            description
              "Enable/disable automatic downgrade of applications.";
        }
        container camera-detection {
          description
            "Configure camera detection.";
          leaf mode {
            type enumeration {
              enum "normal-mode" {
                value 0;
                description
                  "Enables camera detection in normal mode.";
              }
              enum "quick-mode" {
                value 1;
                description
                  "Enables camera detection in quick mode.";
              }
              enum "disable" {
                value 2;
                description
                  "Disables camera detection.";
              }
            }
            description
              "Enable/disable camera detection.";
          }
          leaf sensitivity-level {
            type uint8 {
              range "1..14";
            }
            description "Configure camera detection sensitivity level.";
          }
        }
        container iot-mcx-instances {
          description
            "List of IoT mcx.";
          list iot-mcx-instance {
            key "iot-mcx-id";
            description
              "Configure the IoT mcx instances.";
            leaf iot-mcx-id {
              type uint8 {
                range 0..1;
              }
              description
                "The IoT mcx ID.";
            }
            leaf switch {
              type enumeration {
                enum "auto" {
                  value 0;
                  description
                    "Auto detect IoT mcx status.";
                }
                enum "enable" {
                  value 1;
                  description
                    "Enable IoT mcx switch.";
                }
                enum "disable" {
                  value 2;
                  description
                    "Disable IoT mcx switch.";
                }
              }
              default "auto";
              description
                "Enable/disable IoT mcx.";
            }
            leaf status {
              type enumeration {
                enum "absent" {
                  value 0;
                  description
                    "The IoT mcx is not in position.";
                }
                enum "normal" {
                  value 1;
                  description
                    "The IoT mcx is in position.";
                }
              }
              default "absent";
              description
                "IoT mcx status.";
            }
          }
        }
      }
    }
