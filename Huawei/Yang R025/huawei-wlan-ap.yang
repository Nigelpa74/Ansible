    uses hw-wlan-ap:ap-provision;
    container license-managements {
      description
        "Configure license management.";
      leaf license-centralized {
        type boolean;
        default false;
        description
          "Enable/disable centralized license control.";
      }
      leaf license-client-source {
        when "../license-centralized = 'true'";
        type inet:ip-address;
        description
          "Configure the source address for license client.";
      }
      leaf license-server {
        when "../license-centralized = 'true'";
        type inet:ip-address;
        description
          "Configure an IP address for the license server.";
      }
    }

    container unauthed-aps {
      config false;
      description
        "List of unauthed-aps.";
      list unauthed-ap {
        key "ap-sn";
        description
          "Statistics of unauthed-aps.";
        leaf ap-sn {
          type string {
            length "1..31";
          }
          config false;
          description
