  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:option-info" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:sampler-rates" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:service-type-sampler-rates" {
