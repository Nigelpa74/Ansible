  }
  deviation "/netstream:netstream/netstream:sampler-rate-all-flows" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:option-application-labels" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:aggregations" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:monitors" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flexflow-records/netstream:flexflow-record/netstream:source-mac" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flexflow-records/netstream:flexflow-record/netstream:source-as" {
