module huawei-netstream-deviations-ar5710s {
  namespace "urn:huawei:yang:huawei-netstream-deviations-ar5710s";
  prefix netstream-devs-ar5710s;

  import huawei-netstream {
    prefix netstream;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-devm {
    prefix devm;
  }
  import huawei-extension {
    prefix ext;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-netstream module.";

  revision 2019-11-06 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef nsm-origin-version-deviations {
    type enumeration {
      enum 5 {
        value 5;
        description
          "Version 5.";
      }
      enum 9 {
        value 9;
        description
          "Version 9.";
      }
    }
    description
      "Description of origin version type.";
  }

  typedef nsm-flow-type-deviations {
    type enumeration {
      enum ip-flow {
        value 0;
        description
          "IPv4.";
      }
      enum ipv6-flow {
        value 1;
        description
          "IPv6.";
      }
    }
    description
      "Description of flow type.";
  }

  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:source-ipv4-port" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:source-ipv6-port" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:as-type" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:bgp-nexthop" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:option-template-timeout-rate" {
    deviate not-supported;
  }
  deviation "/netstream:netstream/netstream:flow-instances/netstream:flow-instance/netstream:option-template-refresh-rate" {
