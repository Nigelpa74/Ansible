    }
    leaf leak-entry-number {
      type uint32;
      description
        "The number of leak IPv6 session entries.";
    }
    leaf unrecoverable-entry-number {
      type uint32;
      description
        "The number of unrecoverable IPv6 session entries.";
    }
    leaf session-spec {
      type uint32;
      description
        "IPv6 session specification.";
    }
    leaf leak-entry-usage {
      type uint32;
      units %;
      description
        "The ratio of the number of leaked entries in the current IPv6 session table to the number of specifications.";
    }
    leaf leak-entry-threshold {
      type uint32;
      description
        "Alarm threshold for leaked entries in the IPv6 session table.";
    }
  }
  notification ipv6-session-unrecoverable-entry-exceed {
    description
      "The number of IPv6 session unrecoverable entries exceeds the threshold.";
    leaf current-entry-number {
      type uint32;
      description
        "The number of current IPv6 session entries.";
    }
    leaf leak-entry-number {
      type uint32;
      description
        "The number of leak IPv6 session entries.";
    }
    leaf unrecoverable-entry-number {
      type uint32;
      description
        "The number of unrecoverable IPv6 session entries.";
    }
    leaf session-spec {
      type uint32;
      description
        "IPv6 session specification.";
    }
    leaf unrecoverable-entry-usage {
      type uint32;
      units %;
      description
        "The ratio of the number of unrecoverable entries in the current IPv6 session table to the number of specifications.";
    }
    leaf unrecoverable-entry-threshold {
      type uint32;
      description
        "Alarm threshold for unrecoverable entries in the IPv6 session table.";
    }
  }
  notification ipv6-session-exceed {
    description
      "The number of IPv6 session resources exceeds the limit.";
    leaf session-res-usage {
      type uint32;
      units %;
      description
        "Percentage of the number of current IPv6 sessions to the maximum number of IPv6 sessions.";
    }
    leaf session-res-threshold {
      type uint32;
      description
        "Indicates the alarm threshold of IPv6 session resources.";
    }
    leaf topn-source-ipv6-address {
      type string {
        length "1..256";
      }
      description
        "Source IPv6 address with the highest IPv6 session resource usage. A maximum of three source IPv6 addresses can be displayed. If multiple source IPv6 addresses are displayed, they are separated by commas (,).";
    }
  }
  notification ipv6-session-exceed-clear {
    description
      "The number of IPv6 session resources falls below the limit.";
    leaf session-res-usage {
      type uint32;
      units %;
      description
        "Percentage of the number of current IPv6 sessions to the maximum number of IPv6 sessions.";
    }
    leaf session-res-threshold {
      type uint32;
      description
        "Indicates the alarm threshold of IPv6 session resources.";
    }
  }
  notification ipv6-session-threshold-exceed {
    description
      "The number of IPv6 session resources exceeds the threshold.";
    leaf session-res-usage {
      type uint32;
      units %;
      description
        "Percentage of the number of current IPv6 sessions to the maximum number of IPv6 sessions.";
    }
    leaf session-res-threshold {
      type uint32;
      description
        "Indicates the alarm threshold of IPv6 session resources.";
    }
    leaf topn-source-ipv6-address {
      type string {
        length "1..256";
      }
      description
        "Source IPv6 address with the highest IPv6 session resource usage. A maximum of three source IPv6 addresses can be displayed. If multiple source IPv6 addresses are displayed, they are separated by commas (,).";
    }
  }
  notification ipv6-session-threshold-exceed-clear {
    description
      "The number of IPv6 session resources falls below the threshold.";
    leaf session-res-usage {
      type uint32;
      units %;
      description
        "Percentage of the number of current IPv6 sessions to the maximum number of IPv6 sessions.";
    }
    leaf session-res-threshold {
