      description
        "Indicates the alarm threshold of IPv6 session resources.";
    }
  }
  notification ipv6-security-session-exceed {
    description
      "The number of IPv6 security session resources exceeds the limit.";
    leaf security-session-res-usage {
      type uint32;
      units %;
      description
        "Percentage of the number of current IPv6 security sessions to the maximum number of IPv6 security sessions.";
    }
    leaf security-session-res-threshold {
      type uint32;
      units %;
      description
        "Indicates the alarm threshold of IPv6 security session resources.";
    }
    leaf security-session-maximum-number {
      type uint32;
      description
          "Indicates the maximum number of IPv6 security sessions.";
    }
  }
  notification ipv6-security-session-exceed-clear {
