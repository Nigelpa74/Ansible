    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:ethernet/pic:down-hold-time" {
    deviate replace {
      type uint32 {
        range "0..3600000";
      }
    }
    deviate add {
      default "0";
    }
    deviate delete {
      must "not(../trans-mode) or (../trans-mode and ../trans-mode!='otn-mode' and ../trans-mode!='wan-mode')";
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:ethernet/pic:up-hold-time" {
    deviate replace {
      type uint32 {
        range "0..3600000";
      }
    }
    deviate add {
      default "0";
    }
    deviate delete {
      must "not(../trans-mode) or (../trans-mode and ../trans-mode!='otn-mode' and ../trans-mode!='wan-mode')";
    }
  }
