    }
  }
  deviation "/driver:driver/driver:global-attribute/pic:global/pic:down-hold-time" {
    deviate replace {
      type uint32 {
        range "0..3600000";
      }
    }
  }
  deviation "/driver:driver/driver:global-attribute/pic:global/pic:non-certified-optical-status-alarm" {
    deviate replace {
      type devm:switch-status-type;
    }
    deviate replace {
      default "enable";
    }
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/ifm-trunk:trunk/pic:jumbo-frame/pic:max-jumbo-frame" {
    deviate delete {
      must '../max-jumbo-frame >= ../max-non-jumbo-frame';
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:ethernet/pic:speed" {
    deviate replace {
      type pic-devs-ar5710s:eth-speed-type-deviations;
