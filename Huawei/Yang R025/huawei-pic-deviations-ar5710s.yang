module huawei-pic-deviations-ar5710s {
  namespace "urn:huawei:yang:huawei-pic-deviations-ar5710s";
  prefix pic-devs-ar5710s;

  import huawei-pic {
    prefix pic;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-driver {
    prefix driver;
  }
  import huawei-ifm-trunk {
    prefix ifm-trunk;
  }
  import huawei-devm {
    prefix devm;
  }
  import huawei-license {
    prefix lcs;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-pic module.";

  revision 2025-02-24 {
    description
      "The deviations of the huawei-pic module were modified.";
    reference "Huawei private.";
  }
  revision 2023-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef fec-mode-type-deviations {
    type enumeration {
      enum none {
        value 0;
        description
          "None.";
      }
      enum rs-fec {
        value 10;
        description
          "Rs fec mode.";
      }
      enum rs544-fec {
        value 11;
        description
          "Rs544 fec mode.";
      }
      enum base-r-fec {
        value 12;
        description
          "Base-r fec mode.";
      }
      enum na {
        value 13;
        description
          "Not support fec mode.";
      }
    }
    description
      "Port fec mode type.";
  }

  typedef flowctl-type-deviations {
    type enumeration {
      enum all-enabled {
        value 3;
        description
          "All Enabled.";
      }
      enum receive-enabled {
        value 1;
        description
          "Receive Enabled.";
      }
      enum send-enabled {
        value 2;
        description
          "Send Enabled.";
      }
      enum all-disabled {
        value 0;
        description
          "All Disabled.";
      }
    }
    description
      "Flow control method of an Ethernet port.";
  }

  typedef port-negotiation-mode-type-deviations {
    type enumeration {
      enum slave {
        value 0;
        description
          "Slave.";
      }
      enum auto {
        value 2;
        description
          "Auto.";
      }
      enum master {
        value 3;
        description
          "Master.";
      }
      enum slave-priority {
        value 4;
        description
          "Slave priority.";
      }
      enum master-priority {
        value 5;
        description
          "Master priority.";
      }
    }
    description
      "Port negotiation mode type.";
  }

  typedef eth-duplex-auto-type-deviations {
    type enumeration {
      enum half {
        value 1;
        description
          "Half duplex.";
      }
      enum full {
        value 2;
        description
          "Full duplex.";
      }
    }
    description
      "Duplex-auto type.";
  }

  typedef eth-speed-type-deviations {
    type enumeration {
      enum 10M {
        value 0;
        description
          "Configure 10M.";
      }
      enum 100M {
        value 1;
        description
          "Configure 100M.";
      }
      enum 1000M {
        value 2;
        description
          "Configure 1000M.";
      }
      enum 10G {
        value 6;
        description
          "Configure 10G.";
      }
      enum 40G {
        value 7;
        description
          "Configure 40G.";
      }
      enum auto {
        value 9;
        description
          "Auto.";
      }
      enum 2.5G {
        value 15;
        description
          "Configure 2.5G.";
      }
      enum 5G {
        value 17;
        description
          "Configure 5G.";
      }
      enum 10GE-GE-AUTO {
        value 40;
        description
          "Configure 10GE-GE-AUTO.";
      }
      enum 25GE-GE-AUTO {
        value 41;
        description
          "Configure 25GE-GE-AUTO.";
      }
      enum 2.5G-MODE {
        value 42;
        description
          "Configure 2.5G-MODE.";
      }
    }
    description
      "Speed type.";
  }

  typedef panel-split-ports-split-type-deviations {
    type enumeration {
      enum 4X10GE {
        value 1;
        description
          "Four 10G optical fiber ports.";
      }
      enum 4X25GE {
        value 22;
        description
          "Four 25G optical fiber ports.";
      }
      enum 2X50GE {
        value 24;
        description
          "Two 50G optical fiber ports.";
      }
      enum 4X50GE {
        value 25;
        description
          "Four 50G optical fiber ports.";
      }
      enum 2X100GE {
        value 26;
        description
          "Two 100G optical fiber ports.";
      }
      enum 4X100GE {
        value 27;
        description
          "Four 100G optical fiber ports.";
      }
      enum 2X200GE {
        value 28;
        description
          "Two 200G optical fiber ports.";
      }
      enum 2X400GE {
        value 43;
        description
          "Two 400G optical fiber ports.";
      }
      enum 4X200GE {
        value 45;
        description
          "Four 200G optical fiber ports.";
      }
    }
    description
      "Enum of split type.";
  }

  typedef port-trans-mode-type-deviations {
    type enumeration {
      enum lan-mode {
        value 0;
        description
          "LAN Mode.";
      }
      enum otn-mode {
        value 2;
        description
          "OTN Mode.";
      }
    }
    description
      "Port transmit mode type.";
  }

  typedef switch-type-deviations {
    type enumeration {
      enum DEFAULT {
        value 0;
        description
          "Switch port default.";
      }
      enum 25GETO50GE {
        value 2;
        description
          "Switch port from 25GE to 50GE.";
      }
      enum 40GETO100GE {
        value 3;
        description
          "Switch port from 40GE to 100GE.";
      }
      enum 100GETO40GE {
        value 4;
        description
          "Switch port from 100GE to 40GE.";
      }
      enum 100GETO200GE {
        value 5;
        description
          "Switch port from 100GE to 200GE.";
      }
      enum GETO10GE {
        value 6;
        description
          "Switch port from GE to 10GE.";
      }
    }
    description
      "Port switch type.";
  }

