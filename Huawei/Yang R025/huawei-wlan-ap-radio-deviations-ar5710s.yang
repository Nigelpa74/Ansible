  }
  deviation "/hw-wlan-ap:wlan-ap/hw-wlan-ap:ap-instances/hw-wlan-ap:ap-instance/hw-ap-radio:radio-instances/hw-ap-radio:radio-instance/hw-ap-radio:asfn-roam" {
