module huawei-remote-unit-mng {
  namespace "urn:huawei:yang:huawei-remote-unit-mng";
  prefix rumng;
  
  import huawei-pub-type {
    prefix pub-type;
  }
  import huawei-ifm {
    prefix ifm;
  } 
  import huawei-extension {
    prefix ext;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";

  description
    "This module contains a collection of YANG definitions for
     managing remote unit.";
revision 2025-06-20 {
    description 
    	"1.Add lldp neighbor.
         2.Add the pattern of alias.
         3.Modify the description of mac-type.
         4.Add the mandatory attribute to the input of query-remote-unit-mac.
         5.Add portid node value range.
         6.Add default value of poe-force-power.
         7.Trim the backup group related nodes, and add standard descriptions for the nodes upgrade-cutoff-time and ifname.";
