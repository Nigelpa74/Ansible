  deviation "/ni:network-instance/ni:instances/ni:instance/mpls:mpls/mpls-ldp:ldp/mpls-ldp:instance/mpls-ldp:peer-infos/mpls-ldp:peer-info/mpls-ldp:mldp-mbb-capability" {
