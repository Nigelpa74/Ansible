  }
  deviation "/ni:network-instance/ni:instances/ni:instance/mpls:mpls/mpls-ldp:ldp/mpls-ldp:instance" {
    deviate add {
      must "../../../ni:name='_public_'";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/mpls:mpls/mpls-ldp:ldp/mpls-ldp:instance/mpls-ldp:auth-peers/mpls-ldp:auth-peer/mpls-ldp:authen-mode" {
    deviate replace {
      type mpls-ldp-devs-ar5710s:ldp-peer-auth-mode-deviations;
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/mpls:mpls/mpls-ldp:ldp/mpls-ldp:instance/mpls-ldp:auth-peer-groups/mpls-ldp:auth-peer-group/mpls-ldp:authen-mode" {
    deviate replace {
      type enumeration {
        enum md5 {
          value 1;
          description
            "Specifies mode for cipher or plain MD5 password.";
        }
        enum keychain {
          value 2;
          description
            "Specifies mode for keychain password.";
        }
