module huawei-mpls-ldp-deviations-ar5710s {
  namespace "urn:huawei:yang:huawei-mpls-ldp-deviations-ar5710s";
  prefix mpls-ldp-devs-ar5710s;

  import huawei-mpls-ldp {
    prefix mpls-ldp;
  }
  import huawei-mpls {
    prefix mpls;
  }
  import huawei-network-instance {
    prefix ni;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-mpls-ldp module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef ldp-peer-auth-mode-deviations {
    type enumeration {
      enum md5 {
        value 1;
        description
          "Specifies mode for cipher or plain MD5 password.";
      }
      enum keychain {
        value 2;
        description
          "Specifies mode for keychain password.";
      }
    }
    description
      "LDP Peer Authentication Type.";
  }

  typedef ldp-route-type-deviations {
    type enumeration {
      enum igp {
        value 1;
        description
          "IP route.";
      }
      enum egp {
        value 2;
        description
          "EGP route.";
      }
      enum unknown {
        value 0;
        description
          "Unknown route type.";
      }
    }
    description
      "LDP Route Type.";
  }

  deviation "/mpls-ldp:reset-ldp-session/mpls-ldp:input/mpls-ldp:vrfname" {
    deviate not-supported;
  }
  deviation "/mpls-ldp:reset-all-ldp/mpls-ldp:input/mpls-ldp:vrfname" {
    deviate not-supported;
  }
  deviation "/mpls-ldp:reset-ldp-traffic-statistics" {
    deviate not-supported;
  }
  deviation "/mpls-ldp:reset-mldp-traffic-statistics" {
    deviate not-supported;
  }
  deviation "/mpls-ldp:reset-mldp-all-traffic-statistics" {
    deviate not-supported;
  }
  deviation "/mpls-ldp:diagnose-lsp-establishment/mpls-ldp:input/mpls-ldp:vrfname" {
    deviate not-supported;
