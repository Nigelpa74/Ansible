      enum "1X25GE-NULL" {
        value 19;
        description
          "Split to 1*25GE on current port and null on other ports.";
      }
      enum "1X10GE-1X10GE" {
        value 20;
        description
          "Split to 1*10GE on current port and 1*10GE on another port.";
      }
      enum "ADAPT" {
        value 21;
        description
          "Auto-adapt.";
      }
      enum "4X25GE" {
        value 22;
        description
          "Four 25G optical fiber ports.";
      }
      enum "1X50GE" {
        value 23;
        description
          "One 50G optical fiber port.";
      }
      enum "2X50GE" {
        value 24;
        description
          "Two 50G optical fiber ports.";
      }
      enum "4X50GE" {
        value 25;
        description
          "Four 50G optical fiber ports.";
      }
      enum "2X100GE" {
        value 26;
        description
          "Two 100G optical fiber ports.";
      }
      enum "4X100GE" {
        value 27;
        description
          "Four 100G optical fiber ports.";
      }
      enum "2X200GE" {
        value 28;
        description
          "Two 200G optical fiber ports.";
      }
      enum "1X100GE-4XGE" {
        value 32;
        description
          "Split to 1*100GE on current port and 4*GE on other ports.";
      }
      enum "4X25GE-4XGE" {
        value 33;
        description
          "Split to 4*25GE on current port and 4*GE on other ports.";
      }
      enum "1X40GE-4X10GE" {
        value 35;
        description
          "Split to 1*40GE on current port and 4*10GE on other ports.";
      }
      enum "1X50GE-4X10GE" {
        value 36;
        description
          "Split to 1*50GE on current port and 4*10GE on other ports.";
      }
      enum "NULL-4X25GE" {
        value 37;
        description
          "Split to 4*25GE on other ports.";
      }
      enum "NULL-8X10GE" {
        value 41;
        description
          "Split to 8*10GE on other ports.";
      }
      enum "3X100GE" {
        value 42;
        description
          "Three 100G optical fiber ports.";
      }
      enum "2X400GE" {
        value 43;
        description
          "Two 400G optical fiber ports.";
      }
      enum "1X800GE" {
        value 44;
        description
          "One 800G optical fiber port.";
      }
      enum "4X200GE" {
        value 45;
        description
          "Four 200G optical fiber ports.";
      }
    }
    description
      "Enum of split type.";
  }
