              "Channel number.";
          }
          leaf enable {
            type enumeration {
              enum "enable" {
                value 0;
                description
                  "Enable.";
              }
              enum "disable" {
                value 1;
                description
                  "Disable.";
              }
            }
            default "enable";
            description
              "Enable or disable channel.";
          }
          choice work-mode {
            description
              "Optical module gain or power value.";
            case agc {
              description
                "Optical module gain value.";
              leaf agc-value {
                type uint32 {
                  range "0..65535";
                }
                units "dB";
