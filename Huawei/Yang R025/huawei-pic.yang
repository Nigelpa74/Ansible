        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Port position. The position is expressed in the format of slotID/cardID/portID. For example, 1/0/1. Here 1/0/1 is an example. The value may vary with devices.";
      }
    }
  }
  rpc reset-link-flap-statistic {
    ext:node-ref "/devm:devm/devm:ports/devm:port/pic:ethernet/pic:link-flap-statistic-infos"; 
    description
      "Clearing the link flapping alarm statistic info.";
    input  {
      leaf port-position {
        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Port position. The position is expressed in the format of portType/slotID/cardID/portID. For example, GigabitEthernet1/0/1. Here GigabitEthernet1/0/1 is an example. The value may vary with devices.";
      }
    }
  }
  rpc port-prbs-check-start {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "PRBS generator or checker start.";
    input {
      container prbs-infos {
        description
          "List of to-be-started ports PRBS.";
        list prbs-info {
          key "port-name";
          description
            "List of information about ports PRBS.";
          leaf port-name {
            type string {
              length "1..32";
            }
            mandatory true;
            description
              "Indicates the physical port name.";
          }
          leaf direction {
            type prbs-direction-type;
            mandatory true;
            description
              "PRBS implement direction.";
          }
          leaf action {
            type prbs-action-type;
            mandatory true;
            description
              "PRBS check start type.";
          }
          leaf prbs-type {
            type prbs-pattern-type;
            mandatory true;
            description
              "PRBS type.";
          }
          leaf timeout {
            type uint32 {
              range "1..30";
            }
            units "min";
            mandatory true;
            description
              "PRBS implement direction time out.";
          }
        }
      }
    }
  }
  rpc port-prbs-check-stop {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "PRBS generator or checker stop.";
    input {
      container prbs-infos {
        description
          "List of to-be-stopped ports PRBS.";
        list prbs-info {
          key "port-name";
          description
            "List of information about ports PRBS.";
          leaf port-name {
            type string {
              length "1..32";
            }
            mandatory true;
            description
              "Indicates the physical port name.";
          }
          leaf direction {
            type prbs-direction-type;
            mandatory true;
            description
              "PRBS check stop direction.";
          }
          leaf action {
            type prbs-action-type;
            mandatory true;
            description
              "PRBS check stop type.";
          }
        }
      }
    }
  }
  rpc port-prbs-check-result-get {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "PRBS generator and checker get check result.";
    input {
      leaf port-name {
        type string {
          length "1..32";
        }
        description
          "Indicates the physical port name. If port-name is not specified, all ports are queried.";
      }
    }
    output {
      container check-result-infos {
        description
          "List of PRBS check result information.";
        list check-result-info {
          key "port-name";
          description
            "Indicates the physical port name.";
          leaf port-name {
            type string {
              length "1..32";
            }
            description
              "Indicates the physical port name.";
          }
          leaf media-generator {
            type prbs-pattern-type;
            description
              "PRBS media generator.";
          }
          leaf media-generator-time-left {
            type uint32 {
              range "0..255";
            }
            units "min";
            description
              "Media generate time left.";
          }
          leaf media-checker {
            type prbs-pattern-type;
            description
              "PRBS media checker.";
          }
          leaf media-checker-time-left {
            type uint32 {
              range "0..255";
            }
            units "min";
            description
              "Media check time left.";
          }
          container media-side-check-result-infos {
            description
              "List of media side check result information.";
            list media-side-check-result-info {
              key "lane-num";
              description
              "Indicates the physical lane num.";
              leaf lane-num {
                type uint32 {
                  range "0..32";
                }
                description
                  "Indicates the physical lane num.";
              }
              leaf ber {
                type string {
                  length "0..32";
                }
                description
                  "Port BER check result.";
              }
              leaf error-counters {
                type uint64;
                description
                  "Port error counters check result.";
              }
              leaf lol {
                type string {
                  length "0..32";
                }
                description
                  "Port LOL result.";
              }
            }
          }
        }
      }
    }
  }
  rpc upgrade-optical-module {
    description
      "Upgrade optical-module.";
    input {
      leaf board-position {
        type string {
          length "1..32";
        }
        description
          "Board position. The board-position is expressed in the format of slotID. For example, 1. Here 1 is an example. The value may vary with devices.";
      }
    }
  }
  rpc upgrade-trusted-optical-module {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "Upgrading trusted optical module firmware.";
    input  {
      leaf filename {
        type string {
          length "1..80";
        }
        mandatory true;
        description
          "Indicates the upgrade file name of the optical module firmware.";
      }
      leaf position {
        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Port position. The position is expressed in the format of slotID/cardID/portID. For example, 1/0/1. Here 1/0/1 is an example. The value may vary with devices.";
      }
    }
  }
  rpc abort-upgrade-trusted-optical-module {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "Abort trusted optical module firmware upgrade.";
    input  {
      leaf position {
        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Port position. The position is expressed in the format of slotID/cardID/portID. For example, 1/0/1. Here 1/0/1 is an example. The value may vary with devices.";
      }
    }
  }
  rpc get-upgrade-trusted-optical-module-info {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "Get upgrade trusted optical module information.";
    input  {
      leaf position {
        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Port position. The position is expressed in the format of slotID/cardID/portID. For example, 1/0/1. Here 1/0/1 is an example. The value may vary with devices.";
      }
    }
    output  {
      leaf support-upgrade {
        type boolean;
        default "false";
        description
          "Whether to support user upgrade.";
      }
      leaf upgrade-status {
        type string {
          length "1..128";
        }
        description
          "The last upgrade completion status.";
      }
      leaf completion-time {
        type string {
          length "1..128";
        }
        description
          "The last upgrade completion time.";
      }
    }
  }
  rpc optical-link-dirty-check {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "Set optical link dirty check action.";
    input {
      leaf port-name {
        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Indicates the physical port name.";
      }
      leaf action {
        type enumeration {
          enum "start" {
            value 0;
            description
              "Set optical link dirty check disable.";
          }
          enum "stop" {
            value 1;
            description
              "Set optical link dirty check enable.";
          }
        }
        mandatory true;
        description
          "Optical link dirty check.";
      }
    }
  }
  rpc cable-snr-test {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "Port cable SNR test result.";
    input {
      leaf position {
        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Port position. The position is expressed in the format of slotID/cardID/portID. For example, 1/0/1. Here 1/0/1 is an example. The value may vary with devices.";
      }
    }
    output {
      leaf result {
        type enumeration {
          enum "good" {
            value 0;
            description
              "The quality of network cable is good.";
          }
          enum "poor" {
            value 1;
            description
              "The quality of network cable is poor.";
          }
        }
        description
          "Test result.";
      }
      leaf description {
        type string {
          length "1..256";
        }
        description
          "The description of network cable.";
      }
    }
  }
  rpc get-optical-link-dirty-check-result {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "Optical link dirty check result.";
    input {
      leaf port-name {
        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Indicates the physical port name. If port-name is not specified, all ports are queried.";
      }
    }
    output {
      container check-result-infos {
        description
          "List of optical link dirty check result information.";
        list check-result-info {
          key "port-name lane-number";
          description
            "Indicates the physical port name.";
          leaf port-name {
            type string {
              length "1..32";
            }
            description
              "Indicates the physical port name.";
          }
          leaf lane-number {
            type uint32 {
              range "1..32";
            }
            description
              "Lane index of the optical module.";
          }
          leaf status {
            type string {
              length "1..32";
            }
            description
              "Indicates the check status.";
          }
          leaf result {
            type string {
              length "1..32";
            }
            description
              "Indicates the check result.";
          }
        }
      }
    }
  }
  rpc test-loopback {
    ext:node-ref "/devm:devm/devm:ports/devm:port";
    description
      "Test loopback.";
    input  {
      leaf port-name {
        type string {
          length "1..32";
        }
        mandatory true;
        description
          "Indicates the physical port name.";
      }
      leaf loopback-mode {
        type loopback-type;
        mandatory true;
          description
            "Loopback mode.";
      }
      leaf clear-period {
        type uint32 {
          range "5..3600";
        }
        units "s";
        description
          "Loopback clear period.";
      }
    }
  }
  rpc upgrade-firmware {
    ext:node-ref "/devm:devm/devm:cards/devm:card";
    description
      "Upgrade firmware.";
    input {
      leaf firmware-type {
        type enumeration {
          enum "mcu" {
            value 1;
            description
              "MCU.";
          }
        }
        mandatory true;
        description
          "Firmware type.";
      }
      choice upgrade-type {
        mandatory true;
        description
          "Choose upgrade type.";
        case all {
          description
            "Upgrade all cards.";
          leaf all {
            type empty;
            description
              "All cards.";
          }
        }
        case specify {
          description
            "Specify upgrade card.";
          leaf card-position {
            type string {
              length "1..32";
            }
            description
              "Card Position.";
          }
        }
      }
    }
  }
  rpc get-upgrade-firmware-result {
    ext:node-ref "/devm:devm/devm:cards/devm:card";
    description
      "Get firmware upgrade result.";
    input {
      leaf firmware-type {
        type enumeration {
          enum "mcu" {
            value 1;
            description
              "MCU.";
          }
        }
        mandatory true;
        description
          "Firmware type.";
      }
    }
    output {
      container upgrade-infos {
        description
          "List of firmware upgrade result.";
        list upgrade-info {
          key "card-position";
          description
            "Statistics of firmware upgrade result.";
          leaf card-position {
            type string {
              length "1..32";
            }
            description
              "Card Position.";
          }
          leaf need-upgrade {
            type string {
              length "1..32";
            }
            description
              "Firmware need upgrade.";
          }
          leaf upgrade-status {
            type string {
              length "1..32";
            }
            description
              "Firmware upgrade status.";
          }
          leaf completion-time {
            type yang:date-and-time;
            description
              "Firmware upgrade completion time.";
          }
        }
      }
    }
  }
  augment /driver:driver/driver:global-attribute {
    description
      "Global configuration.";
    container global {
      description
        "Configure Ethernet port.";
      leaf hold-off-timer {
        ext:dynamic-default ;
        type uint32 {
          range "0|20..10000";
        }
        units "ms";
        description
          "Global TAD Hold Down Time.";
      }
      leaf hold-up-timer {
        ext:dynamic-default ;
        type uint32 {
          range "0|200..3600000";
        }
        units "ms";
        description
          "Global TAD Hold Up Time.";
      }
      leaf up-hold-time {
        ext:dynamic-default ;
        type uint32 {
          range "0..86400000";
        }
        units "ms";
        description
          "Global Eth Up Hold Time.";
      }
      leaf down-hold-time {
        type uint32 {
          range "0..86400000";
        }
        units "ms";
        default "0";
        description
          "Global Eth Down Hold Time.";
      }
      leaf crc-enable {
        type boolean;
        default "true";
        description
          "Enable/disable the crc error monitor.";
      }
      leaf symbol-enable {
        type boolean;
        default "true";
        description
          "Enable/disable the symbol error monitor.";
      }
      leaf input-enable {
        type boolean;
        default "true";
        description
          "Enable/disable the input error monitor.";
      }
      leaf output-enable {
        type boolean;
        default "true";
        description
          "Enable/disable the Output error monitor.";
      }
      leaf sdh-enable {
        type boolean;
        default "true";
        description
          "Enable/disable the sdh error monitor.";
      }
      leaf bip8-sd-enable {
        type boolean;
        default "true";
        status "deprecated";
        description
          "Enable/disable the BIP8-SD error monitor. This node is deprecated and '/fm:fm/fm:traps/fm:trap' is recommended.";
      }
      leaf badbytes-enable {
        type boolean;
        default "true";
        description
          "Enable/disable the Bad-Bytes error monitor.";
      }
      leaf optical-enable {
        type boolean;
        default "true";
        description
          "Enable/disable the optical module abnormal monitor.";
      }
      leaf device-transceiver-force-enable {
        type boolean;
        default "false";
        description
          "Enable/disable the forcible configuration of the device transceiver type.";
      }
      leaf tx-pause-enable {
        type boolean;
        default "true";
        description
          "Enable/disable the tx-pause error monitor.";
      }
      leaf loopback-clear {
        type boolean;
        default "false";
        description
          "Enable/disable the loop auto-clear function.";
      }
      leaf loopback-clear-period {
        type uint32 {
          range "1..2880";
        }
        units "min";
        default "5";
        description
          "The period of loop auto-clear function.";
      }
      leaf port-down-laser-shut-log-enable {
        type boolean;
        default "false";
        description
          "Enable/disable the laser-shut log for port down.";
      }
      leaf optical-certified-alarm {
        type boolean;
        default "true";
        description
          "Enable/disable the trap function for an uncertified optical module.";
      }
      leaf optical-certified-down {
        type boolean;
        default "false";
        description
          "Enable/disable the down function for an uncertified optical module.";
      }
      leaf non-certified-optical-status-alarm {
        type boolean;
        default "false";
        description
          "Enable/disable the alarm function for the uncertified optical module status.";
      }
      leaf optical-alarm-std-enable {
        type enumeration {
          enum "disabled" {
            value 0;
            description
              "Disabled.";
          }
          enum "enabled" {
            value 1;
            description
              "Enabled.";
          }
        }
        default "disabled";
        description
          "Enable or disable the optical module alarm threshold standardization.";
      }
      leaf port-bandwidth-type {
        type enumeration {
          enum "data-link" {
            value 0;
            description
              "Data link.";
          }
          enum "physical" {
            value 1;
            description
              "Physical.";
          }
        }
        default "data-link";
        description
          "Port Bandwidth Type.";
      }
      leaf driver-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "default" {
            value 0;
            description
              "Default Mode.";
          }
          enum "lower" {
            value 1;
            description
              "Lower mode.";
          }
          enum "higher" {
            value 2;
            description
              "Higher mode.";
          }
        }
        description
          "E1 driver Mode.";
      }
      leaf link-flap-protection {
        ext:dynamic-default ;
        type devm:switch-status-type; 
        description
          "Configures link flapping protection on all interfaces.";
      }
      leaf speed-downgrade {
        ext:dynamic-default ;
        type enumeration {
          enum "disable" {
            value 0;
            description
              "Disable.";
          }
          enum "enable" {
            value 1;
            description
              "Enable.";
          }
        }
        description
          "For the Ethernet PHY, when the network cable is connected, the connection is attempted from the highest rate supported by both parties by default. Sometimes, due to factors such as external disturbance, excessive cable length, or poor cable quality, a high-speed connection cannot be established.";
      }
      leaf cpos-mix-service-mode-enable {
        ext:dynamic-default;
        type boolean;
        description
          "Enable/disable coexistence of MP services and any of TDM, ATM, and IMA services on the same subcard. If MP services and any of TDM, ATM, and IMA services have been configured on the same subcard, delete those services before disabling this node.";
      }
      leaf high-frequency-update {
        type devm:switch-status-type;
        default "disable";
        description
          "Set statistics high frequency update mode.";
      }
      leaf fall-flow-change-enable {
        type boolean;
        default "true";
        description
          "Enable/disable whether to check the traffic change fall alarm.";
      }
      leaf fall-flow-change-remain-time {
        type uint32 {
          range "1..1440";
        }
        units "min";
        default "5";
        description
          "Indicates the time when the traffic detection alarm is cleared. Within the specified period, the alarm is not detected after the alarm is generated. After the specified period expires, the alarm is detected again.";
      }
      leaf shutdown-inactive-port {
        type boolean;
        default "false";
        description
          "Enable/disable the shutdown function for the port where the RTU is not activated.";
      }
      leaf flow-change-rx-threshold {
        type uint32 {
          range "0..100";
        }
        units "%";
        default "50";
        description
          "Configure the threshold of the traffic change proportion that triggers a traffic change event in the inbound direction.";
      }
      leaf flow-change-tx-threshold {
        type uint32 {
          range "0..100";
        }
        units "%";
        default "50";
        description
          "Configure the threshold of the traffic change proportion that triggers a traffic change event in the outbound direction.";
      }
      leaf single-forward-detect {
          type devm:switch-status-type;
          default "disable";
          description
            "Enable/disable the single forward detect.";
      }
      leaf flow-change-fall-rx-threshold {
        type uint32 {
          range "1..100";
        }
        units "%";
        description
          "Configure the threshold for the percentage of traffic that suddenly decreases in the receive direction. When the percentage of traffic that suddenly decreases in the receive direction exceeds the threshold, a traffic fall alarm is generated.";
      }
      leaf flow-change-fall-tx-threshold {
        type uint32 {
          range "1..100";
        }
        units "%";
        description
          "Configure the threshold for the percentage of traffic that suddenly decreases in the transmit direction. When the percentage of traffic that suddenly decreases in the transmit direction exceeds the threshold, a traffic fall alarm is generated.";
      }
      leaf flow-change-fall-start-bandwidth-ratio {
        type uint32 {
          range "1..100";
        }
        units "%";
        description
            "Configure the threshold of the bandwidth usage that enable the function of reporting the traffic fall alarm.";
      }
      leaf down-hold-period {
        type uint32 {
          range "0..172800";
        }
        units "s";
        default "0";
        description
            "Global port down-hold suppression period.";
      }
      leaf down-hold-times {
        type uint32 {
          range "0..100";
        }
        default "0";
        description
            "Global port down-hold suppression times.";
      }
    }
  }
  augment /ifm:ifm/ifm:interfaces/ifm:interface/ifm-trunk:trunk {
    description
      "Configure jumbo frame on the Eth-Trunk interface.";
    container jumbo-frame {
      description
        "Configure jumbo frame on the Eth-Trunk interface.";
      leaf max-jumbo-frame {
        ext:dynamic-default;
        type uint32 {
          range "1518..15560";
        }
        must "../max-jumbo-frame >= ../max-non-jumbo-frame";
        description
          "Maximum jumbo frame size. It is related to the hardware type.";
      }
      leaf max-non-jumbo-frame {
        type uint32 {
          range "1518..9312";
        }
        must "../max-jumbo-frame >= ../max-non-jumbo-frame";
        default "1518";
        description
          "Maximum non-jumbo frame size.";
      }
    }
  }
  augment /devm:devm/devm:cards/devm:card {
    description
      "Flexible card.";
    container card-tdm-param {
      ext:operation-exclude create;
      description
        "Configure card tdm param.";
      leaf idle-code {
        ext:dynamic-default ;
        ext:case-sensitivity "lower-only";
        type string {
          length "1..2";
          pattern '\s*[a-f0-9]+';
        }
        description
          "Idle code.";
      }
      leaf idle-code-e1 {
        ext:dynamic-default ;
        type string {
          length "1..2";
          pattern '\s*0|ff';
        }
        description
          "E1 port idle code.";
      }
      leaf impedance {
        ext:dynamic-default ;
        type enumeration {
          enum "75ohms" {
            value 75;
            description
              "Configure 75ohms.";
          }
          enum "120ohms" {
            value 120;
            description
              "Configure 120ohms.";
          }
        }
        description
          "ImpedanceMode.";
      }
    }
    container service-mode {
      ext:operation-exclude create;
      description
        "Configure serviceMode.";
      leaf portrate {
        ext:dynamic-default ;
        type enumeration {
          enum "155M" {
            value 0;
            description
              "Configure 155M bytes.";
          }
          enum "622M" {
            value 1;
            description
              "Configure 622M bytes.";
          }
        }
        description
          "Set port rate.";
      }
      leaf bandwidth-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "ETH-28X10GF" {
            value 1;
            description
              "Twenty-eight 10G optical fiber ports.";
          }
          enum "ETH-26X10GF-18XGF" {
            value 2;
            description
              "Twenty-six 10G optical fiber ports and eighteen 1G optical fiber ports.";
          }
          enum "ETH-20X10GF-24XGF" {
            value 3;
            description
              "Twenty 10G optical fiber ports and twenty-four 1G optical fiber ports.";
          }
          enum "ETH-2X100GE-30X10GF-10XGF" {
            value 4;
            description
              "Two 100G optical fiber ports, thirty 10G optical fiber ports and ten 1G optical fiber ports.";
          }
          enum "ETH-2X100GE-26X10GF-14XGF" {
            value 5;
            description
              "Two 100G optical fiber ports, twenty-six 10G optical fiber ports and fourteen 1G optical fiber ports.";
          }
          enum "ETH-2X100GE" {
            value 6;
            description
              "Two 100G optical fiber ports.";
          }
          enum "ETH-1X100GE-4X10GF" {
            value 7;
            description
              "One 100G optical fiber port and four 10G optical fiber ports.";
          }
         enum "POS-8X622M" {
           value 12;
           description
             "Eight 622M POS port.";
         }
         enum "POS-4X2.5G" {
           value 13;
           description
             "Four 2.5G POS port.";
         }
         enum "POS-1X10G" {
           value 14;
           description
             "One 10G POS port.";
         }
        enum "POS-8X155M" {
          value 15;
          description
            "Eight 155M POS port.";
         }
         enum "ETH-2X50GE-2X25GE-2X10GF-14XGF" {
            value 16;
            description
            "Two 50G optical fiber ports, two 25G optical fiber ports, two 10G optical fiber ports and fourteen 1G optical fiber ports.";
          }
          enum "ETH-2X50GE-6X10GF-14XGF" {
            value 17;
            description
            "Two 50G optical fiber ports, six 10G optical fiber ports and fourteen 1G optical fiber ports.";
          }
          enum "ETH-2X25GE-12X10GF-14XGF" {
            value 18;
            description
            "Two 25G optical fiber ports, twelve 10G optical fiber ports and fourteen 1G optical fiber ports.";
          }
          enum "ETH-16X10GF-14XGF" {
            value 19;
            description
            "Sixteen 10G optical fiber ports and fourteen 1G optical fiber ports.";
          }
          enum "ETH-2X100GE-4X25GE-16X10GF-4XGF" {
            value 20;
            description
            "Two 100G optical fiber ports, four 25G optical fiber ports, sixteen 10G optical fiber ports and four 1G optical fiber ports.";
          }
          enum "ETH-2X100GE-20X10GF-4XGF" {
            value 21;
            description
            "Two 100G optical fiber ports, twenty 10G optical fiber ports and four 1G optical fiber ports.";
          }
          enum "ETH-4X25GE-6X10GF-14XGF" {
            value 22;
            description
            "Four 25G optical fiber ports, six 10G optical fiber ports and fourteen 1G optical fiber ports.";
          }
          enum "POS-16X622M" {
            value 23;
            description
             "Sixteen 622M POS ports.";
          }
          enum "POS-8X2.5G" {
            value 24;
            description
              "Eight 2.5G POS ports.";
          }
          enum "POS-2X10G" {
            value 25;
            description
              "Two 10G POS ports.";
          }
          enum "POS-16X155M" {
            value 26;
            description
              "Sixteen 155M POS ports.";
          }
        }
        description
          "Bandwidth Mode. Modifying the configuration affects the instances of ports and interfaces. For details about the impact, see the description of each enumerated item.";
      }
    }
    container em-set {
      ext:operation-exclude create;
      description
        "Configure E&M voice signaling.";
      leaf single-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "bell-1" {
            value 0;
            description
              "Bell-1 mode.";
          }
          enum "bell-2" {
            value 1;
            description
              "Bell-2 mode.";
          }
          enum "bell-3" {
            value 2;
            description
              "Bell-3 mode.";
          }
          enum "bell-4" {
            value 3;
            description
              "Bell-4 mode.";
          }
          enum "bell-5" {
            value 4;
            description
              "Bell-5 mode.";
          }
        }
        description
          "E&M signaling mode.";
      }
      leaf userline-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "4wire" {
            value 1;
            description
              "Configure 4 wire mode.";
          }
          enum "2wire" {
            value 0;
            description
              "Configure 2 wire mode.";
          }
        }
        description
          "E&M user line mode.";
      }
    }
    container service-switch {
      ext:operation-exclude create;
      description
        "Configure service switch.";
      leaf service-switch-mode {
        type enumeration {
          enum "p2mp" {
            value 0;
            description
              "Point to multipoint mode.";
          }
          enum "time-delay" {
            value 1;
            description
              "Time delay mode.";
          }
          enum "cas" {
            value 2;
            description
              "Channel associated signalling mode.";
          }
        }
        default "p2mp";
        description
          "Service mode switch.";
      }
    }
    container queue-priority {
      ext:operation-exclude create;
      description
        "Configure MAC Queue Priority Enable.";
      leaf queue-pri-enable {
        ext:dynamic-default ;
        type enumeration {
          enum "disable" {
            value 0;
            description
              "Disable.";
          }
          enum "enable" {
            value 1;
            description
              "Enable.";
          }
        }
        description
          "MAC Queue Priority Enable.";
      }
    }
    container frame-format {
      ext:operation-exclude create;
      description
        "Configure card frame format.";
      leaf frame-format {
        ext:dynamic-default ;
        type enumeration {
          enum "SDH" {
            value 0;
            description
              "Synchronous Digital Hierarchy.";
          }
          enum "SONET" {
            value 1;
            description
              "Synchronous Optical Network.";
          }
        }
        description
          "FrameFormat.";
      }
    }
    container process-mode {
      ext:operation-exclude create;
      must "not(shield-mode = 'disabled' and process-mode = 'isolate')";
      description
        "Configure subcard fault process mode.";
      leaf process-mode {
        ext:dynamic-default ;
        type fault-process-mode-type;
        description
          "Card fault process mode.";
      }
      leaf shield-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "disabled" {
            value 0;
            description
              "Disabled.";
          }
          enum "enabled" {
            value 1;
            description
              "Enabled.";
          }
        }
        description
          "Shield Card-Fault Process-Mode Global-Config.";
      }
      leaf fault-process-mode-status {
        type fault-process-mode-type;
        config false;
        description
          "Configure subcard fault process mode.";
      }
    }
    container port-group-modes {
      description
        "List of switch mode supported by port group.";
      list port-group-mode {
        ext:generated-by system;
        ext:operation-exclude create;
        key "port-groupid";
        description
          "Configure switch mode supported by port group.";
        leaf port-groupid {
          type uint32 {
            range "1..10000";
          }
          description
            "Index of Port Group.";
        }
        leaf port-list {
          type string {
            length "0..64";
          }
          config false;
          description
            "Port list in group.";
        }
        leaf mode-type {
          ext:dynamic-default ;
          type enumeration {
            enum "25GE-10GE" {
              value 1;
              description
                "Configure 25GE-10GE.";
            }
            enum "10GE-1GE" {
              value 2;
              description
                "Configure 10GE-1GE.";
            }
            enum "25GE" {
              value 3;
              description
                "Configure to 25GE.";
            }
            enum "10GE" {
              value 4;
              description
                "Configure to 10GE.";
            }
          }
          description
            "Switch mode.";
        }
      }
    }
    container cmu-switchs {
      description
        "List of cmu Switch.";
      list cmu-switch {
        key "switch-id";
        description
          "Configure the ID, name and alarm type for the switch parameter monitored by the environment monitoring unit. Only AUXQ supports this function.";
        leaf switch-id {
          type uint32 {
            range "0..3";
          }
          description
            "Cmu Switch ID.";
        }
        leaf alarm-triggering-mode {
          type switch-alarm-triggering-mode;
          mandatory true;
          description
            "Specify cmu alarm-triggering-mode.";
        }
        choice monitor {
          mandatory true;
          description
            "Monitor object.";
          case monitor-object {
            description
              "Monitor object.";
            leaf object-name {
              type monitor-name-type;
              description
                "Specify cmu sensor.";
            }
          }
          case user-defined {
            description
              "User defined name.";
            leaf user-defined-name {
              type string {
                length "1..63";
              }
              description
                "User defined name.";
            }
          }
        }
      }
    }
    container panel-slots {
      config false;
      description
        "Operational state of card panel extend slots.";
      leaf slot {
        type string {
          length "0..32";
        }
        config false;
        description
          "Card Panel Slots.";
      }
    }
    container invalid-ports {
      config false;
      description
        "List of invalid Port.";
      list port {
        key "position slotid";
        config false;
        description
          "Statistics of invalid ports.";
        leaf position {
          type string {
            length "0..32";
          }
          config false;
          description
            "Port position.";
        }
        leaf slotid {
          type string {
            length "0..32";
          }
          config false;
          description
            "SlotID.";
        }
      }
    }
  }
  augment /devm:devm/devm:ports/devm:port {
    description
      "Ports.";
    container ethernet {
      ext:operation-exclude create;
      description
        "Configure Ethernet port.";
      leaf speed {
        ext:dynamic-default ;
        type eth-speed-type;
        description
          "Speed of an Ethernet port. This leaf needs to be set at the same time as other leafs.";
      }
      leaf duplex {
        ext:dynamic-default ;
        type eth-duplex-type;
        description
          "Duplex type of an Ethernet port. This leaf needs to be set at the same time as other leafs.";
      }
      leaf duplex-auto {
        ext:dynamic-default ;
        when "../negotiation='enabled'";
        type eth-duplex-type;
        description
          "Configure the duplex auto-negotiation mode. This mode can be configured only after auto-negotiation is enabled.";
      }
      leaf negotiation {
        ext:dynamic-default ;
        type enumeration {
          enum "enabled" {
            value 1;
            description
              "Enabled.";
          }
          enum "disabled" {
            value 0;
            description
              "Disabled.";
          }
        }
        description
          "Auto negotiation on an Ethernet port. This leaf needs to be set at the same time as other leafs.";
      }
      leaf negotiation-mode {
        ext:dynamic-default ;
        type port-negotiation-mode-type;
        description
          "Auto negotiation mode. If the hardware does not support it, returning to the current interface does not support it.";
      }
      container negotiation-compatible-mode {
        description
          "Configure negotiation compatible mode information.";
        leaf negotiation-compatible-mode {
          ext:dynamic-default;
          type devm:switch-status-type;
          description
            "Negotiation compatible mode. If the hardware does not support it, returning to the current interface does not support it.";
        }
        leaf precursor {
          type int32 {
            range "-15..15";
          }
          must "../postcursor";
          description
            "Specifies precursor. Precursor and postcursor should be set at the same time.";
        }
        leaf postcursor {
          type int32 {
            range "-15..15";
          }
          must "../precursor";
          description
            "Specifies postcursor. Precursor and postcursor should be set at the same time.";
        }
      }
      leaf down-hold-time {
        ext:dynamic-default ;
        type uint32 {
          range "0..86400000";
        }
        units "ms";
        must "not(../trans-mode) or (../trans-mode and ../trans-mode!='otn-mode' and ../trans-mode!='wan-mode')";
        description
          "Down hold time.";
      }
      leaf up-hold-time {
        ext:dynamic-default ;
        type uint32 {
          range "0..86400000";
        }
        units "ms";
        must "not(../trans-mode) or (../trans-mode and ../trans-mode!='otn-mode' and ../trans-mode!='wan-mode')";
        description
          "Up hold time.";
      }
      leaf trans-mode {
        ext:dynamic-default ;
        type port-trans-mode-type;
        description
          "Transmit mode of an Ethernet port.";
      }
      leaf speed-switch-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "manual" {
            value 0;
            description
              "Manual.";
          }
          enum "auto" {
            value 1;
            description
              "Auto.";
          }
        }
        description
          "Port speed switch mode. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf bit-error {
        ext:dynamic-default ;
        when "../trans-mode='otn-mode'";
        type enumeration {
          enum "crc" {
            value 0;
            description
              "CRC error.";
          }
          enum "prefec" {
            value 1;
            description
              "Prefec error.";
          }
        }
        description
          "Bit error type. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf trigger-time {
        ext:dynamic-default ;
        when "../trans-mode='otn-mode' and ../bit-error!='crc'";
        type uint32 {
          range "1..100";
        }
        must "(../trigger-time-type = '200ms' and ../trigger-time < 5) or (../trigger-time-type = 'second' and ../trigger-time)";
        description
          "Prefec error detecting cycle.";
      }
      leaf trigger-time-type {
        ext:dynamic-default ;
        when "../trans-mode='otn-mode' and ../bit-error!='crc'";
        type enumeration {
          enum "second" {
            value 0;
            description
              "Second level.";
          }
          enum "200ms" {
            value 1;
            description
              "Configure 200ms level.";
          }
        }
        must "(../trigger-time-type = '200ms' and ../trigger-time < 5) or (../trigger-time-type = 'second' and ../trigger-time)";
        description
          "Prefec error detecting cycle type. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf tx-power-cfg-type {
        ext:dynamic-default ;
        type enumeration {
          enum "tx-power-target" {
            value 0;
            description
              "Optical power configurations enable.";
          }
          enum "attenuation" {
            value 1;
            description
              "Optical attenuation configuration enable.";
          }
        }
        description
          "Optical power cfg type. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf tx-power-target-value {
        when "../tx-power-cfg-type = 'tx-power-target'";
        type int32 {
          range "-180..30";
        }
        units "0.1 dB";
        description
          "Optical power target value. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf fec-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "standard" {
            value 1;
            description
              "Standard.";
          }
          enum "none" {
            value 0;
            description
              "None.";
          }
          enum "enhanced" {
            value 2;
            description
              "Enhanced.";
          }
          enum "enhanced-i-4" {
            value 4;
            description
              "Enhanced-i-4.";
          }
          enum "enhanced-i-7" {
            value 3;
            description
              "Enhanced-i-7.";
          }
          enum "lhaul-sd" {
            value 5;
            description
              "Lhaul-sd.";
          }
          enum "enhanced-pid" {
            value 8;
            description
              "Enhanced pid.";
          }
          enum "lhaul-sd-pid" {
            value 9;
            description
              "Lhaul sd pid.";
          }
          enum "rs-fec" {
            value 10;
            description
              "Rs fec mode.";
          }
          enum "rs544-fec" {
            value 11;
            description
              "Rs544 fec mode.";
          }
          enum "base-r-fec" {
            value 12;
            description
              "Base-r fec mode.";
          }
          enum "na" {
            value 13;
            description
              "Not support fec mode.";
          }
        }
        description
          "Fec mode. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf eth-fec-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "standard" {
            value 1;
            description
              "Standard.";
          }
          enum "none" {
            value 2;
            description
              "None.";
          }
          enum "disable" {
            value 0;
            description
              "Disable.";
          }
        }
        description
          "Eth Fec Mode. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf fec-pre-alm-thrc {
        ext:dynamic-default ;
        type uint32 {
          range "1..999";
        }
        must "../fec-pre-alm-thrp and ../fec-pre-rsum-thrp and ../fec-pre-rsum-thrc";
        description
          "PreFec error ratio coefficient. The configuration is delivered when the following condition is met: (fec-pre-alm-thrc *10^ fec-pre-rsum-thrp) > (fec-pre-rsum-thrc *10^ fec-pre-alm-thrp). If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf fec-pre-alm-thrp {
        ext:dynamic-default ;
        type uint32 {
          range "1..8";
        }
        must "../fec-pre-alm-thrc and ../fec-pre-rsum-thrp and ../fec-pre-rsum-thrc";
        description
          "PreFec error ratio exponent. The configuration is delivered when the following condition is met: (fec-pre-alm-thrc *10^ fec-pre-rsum-thrp) > (fec-pre-rsum-thrc *10^ fec-pre-alm-thrp). If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf fec-pre-rsum-thrc {
        ext:dynamic-default ;
        type uint32 {
          range "1..999";
        }
        must "../fec-pre-rsum-thrp and ../fec-pre-alm-thrp and ../fec-pre-alm-thrc";
        description
          "For resume-threshold: PreFec error ratio coefficient. The configuration is delivered when the following condition is met: (fec-pre-alm-thrc *10^ fec-pre-rsum-thrp) > (fec-pre-rsum-thrc *10^ fec-pre-alm-thrp). If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf fec-pre-rsum-thrp {
        ext:dynamic-default ;
        type uint32 {
          range "1..9";
        }
        must "../fec-pre-rsum-thrc and ../fec-pre-alm-thrp and ../fec-pre-alm-thrc";
        description
          "For resume-threshold: PreFec error ratio exponent. The configuration is delivered when the following condition is met: (fec-pre-alm-thrc *10^ fec-pre-rsum-thrp) > (fec-pre-rsum-thrc *10^ fec-pre-alm-thrp). If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf jumbo-frame {
        ext:dynamic-default ;
        type uint32 {
          range "0..4294967295";
        }
        description
          "Maximum packet length of jumbo frames. The range is related to the hardware. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf flowctl {
        ext:dynamic-default ;
        type enumeration {
          enum "all-enabled" {
            value 3;
            description
              "All Enabled.";
          }
          enum "receive-enabled" {
            value 1;
            description
              "Receive Enabled.";
          }
          enum "send-enabled" {
            value 2;
            description
              "Send Enabled.";
          }
          enum "all-disabled" {
            value 0;
            description
              "All Disabled.";
          }
          enum "default-config" {
            value 9;
            description
              "Default config.";
          }
        }
        description
          "Flow control method of an Ethernet port.";
      }
      leaf gf-media-type {
        ext:dynamic-default ;
        type enumeration {
          enum "copper" {
            value 3;
            description
              "Copper.";
          }
          enum "fiber100" {
            value 2;
            description
              "Fiber 100M.";
          }
          enum "fiber1000" {
            value 1;
            description
              "Fiber 1000M.";
          }
          enum "auto" {
            value 0;
            description
              "Auto.";
          }
        }
        description
          "Medium type on an Ethernet GF port. This leaf needs to be set at the same time as other leafs.";
      }
      leaf device-transceiver-type {
        when "/driver:driver/driver:global-attribute/pic:global/pic:device-transceiver-force-enable='true' and (not(../pic:switch-speed) or ../pic:switch-speed = '1G')";
        type enumeration {
          enum "1000BASE-X" {
            value 1;
            description
              "1000BASE-X.";
          }
          enum "1000BASE-T" {
            value 3;
            description
              "1000BASE-T.";
          }
        }
        description
          "Device transceiver type of forcible configuration.";
      }
      leaf hold-up {
        ext:dynamic-default ;
        type enumeration {
          enum "enabled" {
            value 1;
            description
              "Enabled.";
          }
          enum "disabled" {
            value 0;
            description
              "Disabled.";
          }
        }
        description
          "Whether the hold-up function is configured on a Ethernet port.";
      }
      choice ipg {
        description
          "Configure the interpacket gap.";
        case ipg-type {
          description
            "Set the interpacket gap type to Shrink or Non-shrink.";
          leaf txipg {
            ext:dynamic-default ;
            type enumeration {
              enum "shrink" {
                value 0;
                description
                  "Shrink.";
              }
              enum "non-shrink" {
                value 1;
                description
                  "Non-shrink.";
              }
            }
            description
              "Configure the interpacket gap type.";
          }
        }
        case ipg-value {
          description
            "Set the interpacket gap to a specified value.";
          leaf inter-packet-gap {
            ext:dynamic-default ;
            type uint32 {
              range "8..12";
            }
            units "Byte";
            description
              "Configure the interpacket gap value. The default values are related to the hardware type. There are many default values. Such as 11, 12.";
          }
        }
      }
      leaf mru {
        ext:dynamic-default ;
        type uint32 {
          range "1520..9700";
        }
        description
          "Maximum Receive Unit. The MRU value should be a multiple of 8.";
      }
      leaf mac-itf-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "SGMII" {
            value 0;
            description
              "SGMII.";
          }
          enum "1000base-x-auto-negotiation" {
            value 1;
            description
              "Configure 1000Base-X auto-negotiation.";
          }
          enum "1000base-x-not-auto-negotiation" {
            value 2;
            description
              "Configure 1000Base-X not-auto-negotiation.";
          }
        }
        description
          "PHY/MAC workmode of an Ethernet Interface. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf combo-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "auto" {
            value 1;
            description
              "Auto mode.";
          }
          enum "copper" {
            value 2;
            description
              "Copper mode.";
          }
          enum "fiber" {
            value 3;
            description
              "Fiber mode.";
          }
        }
        description
          "Combo port mode. Default value is dynamic, it is related to hardware type.";
      }
      leaf switch-speed {
        ext:dynamic-default ;
        type switch-speed-type;
        description
          "Switch GE/10GE/25GE. If the hardware does not support it, returning to the current interface does not support it.";
      }

      leaf promiscuous-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "on" {
            value 1;
            description
              "Promiscuous mode on.";
          }
          enum "off" {
            value 0;
            description
              "Promiscuous mode off.";
          }
        }
        description
          "Promiscuous of an Ethernet MGE port.";
      }
      leaf flexphy-speed {
        ext:dynamic-default ;
        type enumeration {
          enum "50GE" {
            value 50;
            description
              "Configure 50GE.";
          }
          enum "100GE" {
            value 100;
            description
              "Configure 100GE.";
          }
        }
        description
          "Port speed in manual switch mode. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf attenuation {
        ext:dynamic-default ;
        when "../trans-mode='otn-mode' and ../tx-power-cfg-type = 'attenuation'";
        type uint32 {
          range "0..200";
        }
        units "0.1 dB";
        description
          "Optical attenuation. Default values are related to hardware types. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf local-fault-status {
        type enumeration {
          enum "normal" {
            value 0;
            description
              "Normal.";
          }
          enum "fault" {
            value 1;
            description
              "Fault.";
          }
        }
        config false;
        description
          "Local fault.";
      }
      leaf romote-fault-status {
        type enumeration {
          enum "normal" {
            value 0;
            description
              "Normal.";
          }
          enum "fault" {
            value 1;
            description
              "Fault.";
          }
        }
        config false;
        description
          "Remote fault.";
      }
      leaf remote-fault {
        ext:dynamic-default ;
        type enumeration {
          enum "disable" {
            value 0;
            description
              "Disables the function of sending remote faults to the remote end.";
          }
          enum "enable" {
            value 1;
            description
              "Enables the function of sending remote faults to the remote end.";
          }
        }
        description
          "Enables or disables the function of sending remote faults to the remote end.";
      }
      leaf los-trap-down-hold {
        ext:dynamic-default ;
        type enumeration {
          enum "disable" {
            value 1;
            description
              "LOS trap disable.";
          }
          enum "enable" {
            value 0;
            description
              "LOS trap enable.";
          }
        }
        must "not(../trans-mode) or (../trans-mode and ../trans-mode!='otn-mode' and ../trans-mode!='wan-mode')";
        description
          "Controls whether the LOS alarm is reported when an interface goes down due to LOS.";
      }
      leaf down-filter {
        ext:dynamic-default ;
        type enumeration {
          enum "disable" {
            value 0;
            description
              "Disable the interface down filtering.";
          }
          enum "enable" {
            value 1;
            description
              "Enable the interface down filtering.";
          }
        }
        description
          "Controls the interface down filtering.";
      }
      leaf peer-identity {
        type string {
          length "0..507";
        }
        description
          "Port description.";
      }
      leaf fault-detect {
        ext:dynamic-default ;
        type devm:switch-status-type;
        description
          "Enables or disables the fault detection function of a port. Default value is dynamic, it is related to hardware type.";
       }
       leaf inter-frame-gap {
         type uint32 {
           range "8..16";
         }
         default "12";
         description
            "Configures the inter frame gap (IFG).";
       }
       leaf statistics-include-interframe {
         type devm:switch-status-type;
         default "enable";
         description
            "Configures traffic statistics on an interface to contain the inter-frame gap.";
       }
      leaf link-flap-protection {
        type devm:switch-status-type;
        default "enable";
        description
           "Configures an interface to the Error-Down state when the number of interface flapping events reaches the maximum value.";
      }
      leaf link-flap-alarm {
        type devm:switch-status-type;
        default "disable";
        description
           "Indicates whether the link flap alarm takes effect.";
      }
      leaf link-flap-interval {
        type uint32 {
          range "5..86400";
        }
        units "s";
        default "10";
        description
          "Specifies the interval for the first group of link flapping on an interface.";
      }
      leaf link-flap-threshold {
       type uint32 {
         range "2..1200";
       }
       default "5";
       description
         "Specifies the maximum number of times for the first group of link flapping on an interface.";
      }
      leaf link-flap-resume-threshold {
        type uint32 {
          range "0..50";
        }
        must "../link-flap-threshold > ../link-flap-resume-threshold";
        default "0";
        description
          "Specifies the alarm clearance threshold for link flapping in the first group.";
      }
      leaf link-flap-second-interval {
        type uint32 {
          range "5..86400";
        }
        units "s";
        must "../link-flap-interval != ../link-flap-second-interval and ../link-flap-second-threshold";
        description
          "Specifies the interval for the second group of link flapping on an interface.";
      }
      leaf link-flap-second-threshold {
       type uint32 {
         range "2..1200";
       }
       must "../link-flap-second-interval";
       description
         "Specifies the maximum number of times for the second group of link flapping on an interface.";
      }
      leaf up-delay {
       type uint32 {
         range "0..3600";
       }
       units "s";
       default "0";
       description
         "Specifies the delay after which an interface goes up.";
      }
      leaf flow-change-alarm-interval {
        type uint32 {
          range "1..10";
        }
        units "min";
        default 5;
        description
          "Configure the interval for detecting traffic change alarms.";
      }
      leaf flow-change-alarm-rx-threshold {
        type uint32 {
          range "1..100";
        }
        units "%";
        default 50;
        description
          "Configure the threshold of the traffic change proportion that triggers a traffic change alarm in the inbound direction.";
      }
      leaf flow-change-alarm-tx-threshold {
        type uint32 {
          range "1..100";
        }
        units "%";
        default 50;
        description
          "Configure the threshold of the traffic change proportion that triggers a traffic change alarm in the outbound direction.";
      }
      leaf flow-change-alarm-start-bandwidth {
        type uint32 {
          range "1..100";
        }
        units "%";
        default 20;
        description
          "Configure the interface bandwidth usage when detection on the traffic change alarm was started.";
      }
      leaf combo {
        ext:dynamic-default ;
        type enumeration {
          enum "auto" {
            value 1;
            description
              "Auto.";
          }
          enum "copper" {
            value 2;
            description
              "Copper.";
          }
          enum "fiber" {
            value 3;
            description
              "Fiber.";
          }
        }
        description
          "Combo mode.";
      }
      leaf-list speed-autos {
        type enumeration {
          enum "default" {
            value 0;
            description
              "Full capabilities.";
          }
          enum "10M" {
            value 8193;
            description
              "Configure 10M.";
          }
          enum "100M" {
            value 18;
            description
              "Configure 100M.";
          }
          enum "1000M" {
            value 4;
            description
              "Configure 1000M.";
          }
          enum "2.5G" {
            value 128;
            description
              "Configure 2.5G.";
          }
          enum "5G" {
            value 256;
            description
              "Configure 5G.";
          }
          enum "10G" {
            value 8;
            description
              "Configure 10G.";
          }
        }
        max-elements 3;
        description
          "Configure the speed negotiation capability of an interface.";
      }
      leaf duplex-status {
        type eth-duplex-type;
        config false;
        description
          "Duplex type of an Ethernet port.";
      }
      container eth-wan-attr {
        ext:operation-exclude create;
        when "../trans-mode='wan-mode'";
        description
          "Configure Ethernet port attributes.";
        leaf frame-format {
          ext:dynamic-default ;
          type enumeration {
            enum "SDH" {
              value 0;
              description
                "Synchronous Digital Hierarchy.";
            }
            enum "SONET" {
              value 1;
              description
                "Synchronous Optical Network.";
            }
          }
          description
            "Frame format of an Ethernet WAN port. Default values are related to hardware types. If the hardware does not support it, returning to the current interface does not support it.";
        }
        leaf j0-mode {
          ext:dynamic-default ;
          type enumeration {
            enum "1byte" {
              value 1;
              description
                "Configure 1 byte mode.";
            }
            enum "16byte" {
              value 16;
              description
                "Configure 16 bytes mode.";
            }
            enum "64byte-or-null-mode" {
              value 64;
              description
                "Configure 64bytes or null mode.";
            }
          }
          description
            "J0 mode on an Ethernet WAN port.";
        }
        leaf j0-value {
          when "../j0-mode='1byte'";
          type uint32 {
            range "0..255";
          }
          default "1";
          description
            "Value of j0-mode on an Ethernet WAN port.";
        }
        leaf j0-trace {
          ext:dynamic-default ;
          when "../j0-mode='16byte' or ../j0-mode='64byte-or-null-mode'";
          type string {
            length "0..62";
          }
          must "(string-length(../j0-trace)<16 and ../j0-mode='16byte') or ../j0-mode='64byte-or-null-mode'";
          description
            "Description of the j0 mode on an Ethernet WAN port.";
        }
        leaf j1-mode {
          ext:dynamic-default ;
          type enumeration {
            enum "1byte" {
              value 1;
              description
                "Configure 1 byte mode.";
            }
            enum "16byte" {
              value 16;
              description
                "Configure 16 bytes mode.";
            }
            enum "64byte-or-null-mode" {
              value 64;
              description
                "Configure 64byte or null mode.";
            }
          }
          description
            "J1 mode on an Ethernet WAN port.";
        }
        leaf j1-value {
          when "../j1-mode='1byte'";
          type uint32 {
            range "0..255";
          }
          default "1";
          description
            "Value of j1-mode on an Ethernet WAN port.";
        }
        leaf j1-trace {
          ext:dynamic-default ;
          when "../j1-mode='16byte' or ../j1-mode='64byte-or-null-mode'";
          type string {
            length "0..62";
          }
          must "(string-length(../j1-trace)<16 and ../j1-mode='16byte') or ../j1-mode='64byte-or-null-mode'";
          description
            "Description of the j1 mode on an Ethernet WAN port.";
        }
        leaf c2 {
          ext:dynamic-default ;
          type uint32 {
            range "0..255";
          }
          description
            "C2 mode on an Ethernet WAN port.";
        }
        leaf clock {
          ext:dynamic-default ;
          type enumeration {
            enum "master" {
              value 0;
              description
                "Master clock.";
            }
            enum "slave" {
              value 1;
              description
                "Slave clock.";
            }
          }
          description
            "Active/standby clock on an Ethernet WAN port. Default values are related to hardware types. If the hardware does not support it, returning to the current interface does not support it.";
        }
        leaf scramble {
          ext:dynamic-default ;
          type enumeration {
            enum "enabled" {
              value 3;
              description
                "Enabled.";
            }
            enum "disabled" {
              value 0;
              description
                "Disabled.";
            }
          }
          description
            "Whether the scrambling function is configured on an Ethernet WAN port. Default values are related to hardware types. If the hardware does not support it, returning to the current interface does not support it.";
        }
        leaf rx-j0-value {
          type uint32 {
            range "0..255";
          }
          config false;
          description
            "Receive j0 value.";
        }
        leaf rx-j0-trace {
          type string {
            length "0..64";
          }
          config false;
          description
            "Receive J0 description.";
        }
        leaf rx-j1-value {
          type uint32 {
            range "0..255";
          }
          config false;
          description
            "Receive j1 value.";
        }
        leaf rx-j1-trace {
          type string {
            length "0..64";
          }
          config false;
          description
            "Receive J1 description.";
        }
        leaf rx-c2 {
          type uint32 {
            range "0..255";
          }
          config false;
          description
            "Receive C2 value.";
        }
        leaf rx-j0-mode {
          type enumeration {
            enum "1byte" {
              value 1;
              description
                "Configure 1byte.";
            }
            enum "16byte" {
              value 16;
              description
                "Configure 16byte.";
            }
            enum "64byte-or-null-mode" {
              value 64;
              description
                "Configure 64byte or null mode.";
            }
            enum "peer" {
              value 128;
              description
                "Peer.";
            }
          }
          config false;
          description
            "Rx j0 mode on an Ethernet WAN port.";
        }
        leaf rx-j1-mode {
          type enumeration {
            enum "1byte" {
              value 1;
              description
                "Configure 1byte.";
            }
            enum "16byte" {
              value 16;
              description
                "Configure 16byte.";
            }
            enum "64byte-or-null-mode" {
              value 64;
              description
                "Configure 64byte or null mode.";
            }
            enum "peer" {
              value 128;
              description
                "Peer.";
            }
          }
          config false;
          description
            "Rx j1 mode on an Ethernet WAN port.";
        }
        uses bit-error-rate {
          description
            "Bit error rate.";
        }
      }
      container fall-flow-change {
          description
            "Configure traffic change fall information.";
        leaf interval {
          ext:dynamic-default;
          type uint32 {
            range "1..10";
          }
          units "min";
          description
            "Configure the interval for detecting traffic fall alarms.";
        }
        leaf rx-threshold-ratio {
          ext:dynamic-default;
          type uint32 {
            range "1..100";
          }
          units "%";
          description
            "Configure the threshold of the traffic fall proportion that triggers a traffic fall alarm in the inbound direction.";
        }
        leaf tx-threshold-ratio {
          ext:dynamic-default;
          type uint32 {
            range "1..100";
          }
          units "%";
          description
            "Configure the threshold of the traffic fall proportion that triggers a traffic fall alarm in the outbound direction.";
        }
        leaf start-bandwidth-ratio {
          ext:dynamic-default;
          type uint32 {
            range "1..100";
          }
          units "%";
          description
            "Configure the interface bandwidth usage when detection on the traffic fall alarm was started.";
        }
        leaf check-enable {
          ext:dynamic-default;
          type boolean;
          description
            "Enable/disable the traffic fall alarm function on an interface.";
        }
      }
      container fec-error-statistics {
        config false;
        description
          "Indicates the FEC bit error statistics.";
        leaf bit0-error-count {
          type uint64;
          description
            "FEC can correct the number of 0bit error.";
        }
        leaf bit1-error-count {
          type uint64;
          description
            "FEC can correct the number of 1bit error.";
        }
        leaf bit0-and-bit1-error-count {
          type uint64;
          description
            "FEC can correct the number of 0bit and 1bit error.";
        }
        leaf symbol-error-count {
          type uint64;
          description
            "FEC can correct the number of symbol error.";
        }
        leaf correctable-error-count {
          type uint64;
          description
            "Correctable error count.";
        }
        leaf uncorrectable-error-count {
          type uint64;
          description
            "Uncorrectable error count.";
        }
        leaf pre-fec {
          type string {
            length "1..32";
          }
          description
            "Pre-FEC BER.";
        }
      }
      container local-loopback-result {
        config false;
        description
          "Operational state of local loopback result test.";
        leaf result {
          type enumeration {
            enum "success" {
              value 0;
              description
                "The test is successful.";
            }
            enum "test-error" {
              value 1;
              description
                "Loopback detection error.";
            }
            enum "no-test" {
              value 2;
              description
                "Query without test.";
            }
            enum "test-clashes" {
              value 3;
              description
                "Loopback detection is not supported. For example, the port is shut down or loopback is configured.";
            }
            enum "test-no-support" {
              value 4;
              description
                "The device does not support loopback detection.";
            }
          }
          description
            "Test result.";
        }
        leaf last-test-time {
          type string {
            length "1..24";
          }
          description
            "Last test time.";
        }
        leaf link-status {
          type enumeration {
            enum "down" {
              value 0;
              description
                "The interface is down.";
            }
            enum "up" {
              value 1;
              description
                "The interface is up.";
            }
          }
          description
            "Indicates the interface status.";
        }
        leaf crc-error-packet {
          type boolean;
          description
            "Check whether CRC error packets exist.";
        }
        leaf other-error-packet {
          type boolean;
          description
            "Check whether there are other error packets, excluding CRC.";
        }
      }
      leaf eee {
          ext:dynamic-default;
          type devm:switch-status-type;
          description
            "Enable the Energy Efficient Ethernet (EEE) function on an electrical interface.";
      }
      leaf auto-sleep {
          ext:dynamic-default ;
          type devm:switch-status-type;
          description
            "Auto sleep.";
      }
      leaf speed-downgrade {
          type devm:switch-status-type;
          default "disable";
          description
            "Speed downgrade enable.";
      }
      leaf auto-downgrade {
          type devm:switch-status-type;
          default "disable";
          description
            "Auto downgrade when some lanes of the optical module are faulty.";
      }
      leaf auto-downgrade-filter-time {
        when "../auto-downgrade='enable'";
        type uint32 {
          range "3..120";
        }
        units "s";
        description
          "Filtering time for optical downgrade detection.";
      }
      leaf mdi {
        type port-mdi-type;
        description
          "Media dependent interface.";
      }
      uses bit-error-rate {
        description
          "Bit error rate.";
      }
      container link-flap-statistic-infos {
        config false;
          description
            "List of link flap.";
        leaf link-flap-alarm-state {
          type devm:switch-status-type;
          description
            "Indicates whether to enable the link flapping alarm of a port.";
        }
        leaf period-begin-time {
          type string {
            length "1..128";
          }
          description
            "Period begin time.";
        }
        leaf link-flap-count {
          type uint32 {
            range "0..4294967295";
          }
          description
            "Current link flap count.";
        }
        list link-flap-statistic-info {
            key "begin-time";
            max-elements 10;
            description
              "Statistics of link flapping alarm. The list is used to display the latest link flap of a port.";
            leaf begin-time {
              type string {
                length "1..128";
              }
              description
                "Link flapping begin time.";
            }
            leaf end-time {
              type string {
                length "1..128";
              }
              description
                "Link flapping end time.";
            }
            leaf down-reason {
              type string {
                length "1..64";
              }
              description
                "Indicates the cause of the interface link flapping.";
            }
        }
      }
    }
    container laser {
      ext:operation-exclude create;
      description
        "Configure Laser. Port insertion does not support configuration for some optical modules, such as electrical modules.";
      leaf auto-shut-enable {
        ext:dynamic-default ;
        type enumeration {
          enum "enable" {
            value 1;
            description
              "Laser automatic shutdown enable.";
          }
          enum "disable" {
            value 0;
            description
              "Laser automatic shutdown disable.";
          }
        }
        description
          "Laser auto shutdown.";
      }
      leaf restart-mode {
        ext:dynamic-default ;
        type enumeration {
          enum "auto" {
            value 0;
            description
              "Auto mode.";
          }
          enum "manual" {
            value 1;
            description
              "Manual mode.";
          }
        }
        description
          "Restart mode.";
      }
      leaf open-time {
        ext:dynamic-default ;
        type uint32 {
          range "2..300";
        }
        units "10 ms";
        description
          "Laser open time.";
      }
      leaf close-time {
        ext:dynamic-default ;
        type uint32 {
          range "100..30000";
        }
        units "10 ms";        
        description
          "Laser close time.";
      }
      leaf status {
        type enumeration {
          enum "on" {
            value 0;
            description
              "Laser on.";
          }
          enum "off" {
            value 1;
            description
              "Laser off.";
          }
          enum "offline" {
            value 2;
            description
              "Laser offline.";
          }
        }
        config false;
        description
          "Laser status.";
      }
    }
    container optical-module {
      ext:operation-exclude create;
      description
        "Configure information about optical transceivers.";
      leaf rx-high-power-warn-en {
        ext:dynamic-default ;
        type boolean;
        description
          "Enable/disable receiving optical power high warning.";
      }
      leaf rx-low-power-warn-en {
        ext:dynamic-default ;
        type boolean;
        description
          "Enable/disable receiving optical power low warning.";
      }
      leaf tx-high-power-warn-en {
        ext:dynamic-default ;
        type boolean;
        description
          "Enable/disable transmit optical power high warning.";
      }
      leaf tx-low-power-warn-en {
        ext:dynamic-default ;
        type boolean;
        description
          "Enable/disable transmit optical power low warning.";
      }
      leaf volt-high-warn-en {
        ext:dynamic-default ;
        type boolean;
        description
          "Enable/disable optical module voltage high warning.";
      }
      leaf volt-low-warn-en {
        ext:dynamic-default ;
        type boolean;
        description
          "Enable/disable optical module voltage low warning.";
      }
      leaf wave-modulation-mode {
        ext:dynamic-default ;
        when "../../ethernet/trans-mode='otn-mode'";
        type enumeration {
          enum "dqpsk" {
            value 0;
            description
              "Dqpsk.";
          }
          enum "qpsk" {
            value 1;
            description
              "Qpsk.";
          }
        }
        description
          "Lightwave modulation mode. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf wavelength-channel-number {
        ext:dynamic-default ;
        type tunable-wavelength-type;
        must "not(../tunable-wavelength or ../tunable-frequency)";
        description
          "Tunable optical module wave length. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf tunable-wavelength {
        ext:dynamic-default ;
        type uint32 {
          range "0..4294967294";
        }
        units "10 fm";
        must "not(../wavelength-channel-number or ../tunable-frequency)";
        description
          "Wavelength value of a tunable optical module. Any two of the following cannot be set at the same time: wavelength channel number, wavelength value, and frequency value.";
      }
      leaf tunable-wavelength-unit {
        when "../tunable-wavelength";
        type enumeration {
          enum "10fm" {
            value 0;
            description
              "Set the unit to 10fm.";
          }
          enum "fm" {
            value 1;
            description
              "Set the unit to fm.";
          }
        }
        default "10fm";
        description 
          "Wavelength unit of a tunable optical module.";
      }
      leaf tunable-frequency {
        ext:dynamic-default ;
        type uint32 {
          range "0..4294967294";
        }
        units "10 MHz";
        must "not(../tunable-wavelength or ../wavelength-channel-number)";
        description
          "Frequency value of a tunable optical module. Any two of the following cannot be set at the same time: wavelength channel number, wavelength value, and frequency value.";
      }
      leaf tunable-frequency-unit {
        when "../tunable-frequency";
        type enumeration {
          enum "10mhz" {
            value 0;
            description
              "Set the unit to 10MHz.";
          }
          enum "mhz" {
            value 1;
            description
              "Set the unit to MHz.";
          }
        }
        default "10mhz";
        description 
          "Frequency unit of a tunable optical module.";
      }
      leaf tunable-frequency-spacing {
        when "../tunable-wavelength or ../wavelength-channel-number or ../tunable-frequency";
        type enumeration {
          enum "100ghz" {
            value 5;
            description
              "100GHz.";
          }
          enum "75ghz" {
            value 6;
            description
              "75GHz.";
          }
          enum "50ghz" {
            value 4;
            description
              "50GHz.";
          }
          enum "33ghz" {
            value 7;
            description
              "33GHz.";
          }
          enum "25ghz" {
            value 3;
            description
              "25GHz.";
          }
          enum "12.5ghz" {
            value 2;
            description
              "12.5GHz.";
          }
          enum "6.25ghz" {
            value 1;
            description
              "6.25GHz.";
          }
          enum "3.125ghz" {
            value 0;
            description
              "3.125GHz.";
          }
        }
        description
          "Frequency spacing value of a tunable optical module.";
      }
      leaf signal-dqpsk {
        type uint32 {
          range "1..8";
        }
        description
          "Differential quadrature phase shift keying. Default values are related to hardware types. If the hardware does not support it, returning to the current interface does not support it.";
      }
      leaf signal-dqpsk-tx {
        ext:dynamic-default ;
        when "../wave-modulation-mode!='qpsk'";
        type uint32 {
          range "1..8";
        }
        description
          "Differential quadrature phase shift keying transmit value.";
      }
      leaf signal-dqpsk-rx {
        ext:dynamic-default ;
        when "../wave-modulation-mode!='qpsk'";
        type uint32 {
          range "1..8";
        }
        description
          "Differential quadrature phase shift keying receive value.";
      }
     leaf power-low-protection {
       type devm:switch-status-type;
       default "disable";
       description
         "Configures an interface to the Error-Down state when the optical power is too low.";
      }
      leaf single-fiber {
        type devm:switch-status-type;
        default "disable";
         description
           "The optical modules are connected by only one fiber.";
      }
      leaf single-fiber-rx {
        type devm:switch-status-type;
        default "disable";
         description
           "Connect the RX end of a local optical module to a remote optical module using a single optical fiber.";
      }
      choice gain-power {
        status "deprecated";
        ext:advised-node "/devm:devm/devm:ports/devm:port/pic:optical-module/pic:edfas/pic:edfa/pic:work-mode";
        description
          "Optical module gain or power value. This node is deprecated and '/devm:devm/devm:ports/devm:port/pic:optical-module/pic:edfas/pic:edfa/pic:work-mode' is recommended.";
        case gain {
          description
            "Optical module gain value.";
          leaf agc-value {
            type uint32 {
              range "0..65535";
            }
            units "dB";
            description
              "Optical amplifier module gain value. The configuration range depends on the type of the optical module.";
          }
        }
        case power {
          description
            "Optical module power value.";
          leaf apc-value {
            type uint32 {
              range "0..65535";
            }
            units "dBm";
            description
              "Optical amplifier module power value. The configuration range depends on the type of the optical module.";
          }
        }
      }
      leaf optical-mode {
        ext:dynamic-default ;
        type enumeration {
        enum "hsen" {
            value 2;
            description
              "High sensitivity mode.";
        }
        enum "osnr" {
            value 3;
            description
              "Osnr mode.";
          }
        }
        description
          "Switching the optical module mode.";
      }
      leaf vendor-name {
        type string {
          length "0..63";
        }
        config false;
        description
          "Name of an optical transceiver Verder.";
      }
      leaf vendor-pn {
        type string {
          length "0..20";
        }
        config false;
        description
          "Optical Transceiver Verder PN.";
      }
      leaf app-firmware-version {
